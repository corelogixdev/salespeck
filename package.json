{
  "name": "openmenu",
  "version": "1.0.0",
  "private": "true",
  "main": "main.js",
  "scripts": {
    "start": "nodemon server/app.js",
    "start:electron": "electron .",
    "dev": "nodemon --exec \"electron .\"",
    "build": "electron-builder"
  },
  "build": {
    "appId": "io.openmenu.app",
    "productName": "OpenMenu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "build/**/*",
      "config/**/*",
      "controllers/**/*",
      "middleware/**/*",
      "migrations/**/*",
      "models/**/*",
      "seeders/**/*",
      "server/**/*",
      "utils/**/*",
      "views/**/*",
      "config.js",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitlab.com/atta-devgiant/openmenu-desktop/-/jobs/artifacts/main/raw/dist?job=build"
      }
    ],
    "mac": {
      "target": []
    },
    "linux": {
      "target": []
    }
  },
  "license": "MIT",
  "author": "Atta Rasul",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.5",
    "cross-spawn": "^7.0.3",
    "ejs": "^3.1.10",
    "electron-updater": "^5.3.0",
    "express": "^4.21.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "jquery": "^3.7.1",
    "popper.js": "^1.16.1",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.7",
    "sweetalert2": "^11.14.4",
    "toastr": "^2.1.4",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-reload": "^1.5.0",
    "nodemon": "^3.1.7"
  }
}
