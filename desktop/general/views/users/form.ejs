<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">Create <%= role==='user' ? 'User' : (role==='vendor' ? 'Vendor' : 'Customer') %></h4>
      </div>
      <div class="card-body">
        <div class="tab-content">
          <div class="tab-pane fade show active" id="general-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
            <form id="form">
              <div class="row gy-4 mt-1">
                <% if (data) { %>
                  <input type="hidden" name="id" value="<%= data.id %>">
                <% } %>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="firstName" class="form-label">First Name</label>
                    <div class="form-icon">
                      <input type="text" class="form-control form-control-icon" id="firstName" name="firstname"
                        value="<%= data ? data.firstname : '' %>" placeholder="Enter first name" required>
                      <i class="ri-user-line"></i>
                    </div>
                  </div>
                </div>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="lastName" class="form-label">Last Name</label>
                    <div class="form-icon">
                      <input type="text" class="form-control form-control-icon" id="lastName" name="lastname"
                        value="<%= data ? data.lastname : '' %>" placeholder="Enter last name" required>
                      <i class="ri-user-line"></i>
                    </div>
                  </div>
                </div>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="email" class="form-label">Email</label>
                    <div class="form-icon">
                      <input type="email" class="form-control form-control-icon" id="email" name="email"
                        value="<%= data ? data.email : '' %>" placeholder="Enter email" required>
                      <i class="ri-mail-line"></i>
                    </div>
                  </div>
                </div>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="username" class="form-label">Username</label>
                    <div class="form-icon">
                      <input type="text" class="form-control form-control-icon" id="username" name="username"
                        value="<%= data ? data.username : '' %>" placeholder="Enter username" required>
                      <i class="ri-user-3-line"></i>
                    </div>
                  </div>
                </div>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="phone" class="form-label">Phone</label>
                    <div class="form-icon">
                      <input type="text" class="form-control form-control-icon" id="phone" name="phone"
                        value="<%= data ? data.phone : '' %>" placeholder="Enter phone number" required>
                      <i class="ri-phone-line"></i>
                    </div>
                  </div>
                </div>
                <div class="col-xxl-3 col-md-6">
                  <div>
                    <label for="address" class="form-label">Address</label>
                    <div class="form-icon">
                      <textarea class="form-control form-control-icon" id="address" name="address" rows="1" 
                        placeholder="Enter address" required><%= data ? data.address : '' %></textarea>
                      <i class="ri-map-pin-line"></i>
                    </div>
                  </div>
                </div>
                <% if (role !=='customer' && role !== 'vendor') { %>
                  <div class="col-xxl-3 col-md-6">
                    <div>
                      <label for="password" class="form-label">Password</label>
                      <div class="form-icon position-relative">
                        <input type="password" class="form-control form-control-icon" id="password" name="password" autocomplete="new-password"
                          value="" placeholder="<%= data ? 'Leave blank to keep current' : 'Enter password' %>" <%= data ? '' : 'required' %>>
                        <i class="ri-lock-2-line"></i>
                      </div>
                      <i class="ri-eye-line position-absolute translate-middle-y me-2" 
                          style="cursor: pointer; right: 10px; top: 50px;" 
                          onclick="togglePassword(this)"></i>
                    </div>
                  </div>
                <% } %>
                <% if (role === 'customer' || role === 'vendor') { %>
                  <div class="col-xxl-3 col-md-6">
                    <div>
                      <label for="opening_balance" class="form-label">Opening Balance</label>
                      <div class="form-icon">
                        <input type="number" class="form-control form-control-icon" id="opening_balance" name="opening_balance"
                          value="0" placeholder="Enter opening balance" step="any">
                        <i class="ri-money-dollar-circle-line"></i>
                      </div>
                    </div>
                  </div>
                <% } %>
                <input type="hidden" name="role" value="<%= role %>">
                <div class="col-12">
                  <button type="submit" class="btn btn-primary"><%= data ? 'Update' : 'Create' %></button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('#form').addEventListener('submit', async (event) => {
      event.preventDefault();
      document.querySelectorAll('input').forEach(input => {
        input.style.borderColor = '';
      });
      const phone = document.getElementById('phone').value;
      if (phone.length < 8) {
        document.getElementById('phone').style.borderColor = 'red';
        return;
      }
      const formData = new FormData(event.target);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const response = await fetch('/users/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();
        if (result.success) {
          $.alert({
            title: 'Success!',
            content: result.message,
            boxWidth: '40%',
            theme: 'material',
            useBootstrap: false,
            type: 'green',
            buttons: {
              confirm: {
                text: 'OK',
                btnClass: 'btn-primary',
                action: function () {
                  window.location.reload();
                }
              }
            }
          });
        } else {
          $.alert({
            title: 'Error!',
            content: result.message,
            boxWidth: '30%',
            theme: 'material',
            useBootstrap: false,
            type: 'red',
            buttons: {
              confirm: {
                text: 'OK',
                btnClass: 'btn-primary',
              }
            }
          });
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred while saving the user.');
      }
    });
  });
</script>

<script>
  // Add this to your existing scripts section
  function togglePassword(element) {
    const passwordInput = document.getElementById('password');
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      element.classList.remove('ri-eye-line');
      element.classList.add('ri-eye-off-line');
    } else {
      passwordInput.type = 'password';
      element.classList.remove('ri-eye-off-line');
      element.classList.add('ri-eye-line');
    }
  }
</script>