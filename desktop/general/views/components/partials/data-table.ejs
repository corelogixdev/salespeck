<%
const currentSort = typeof sortBy !== 'undefined' ? sortBy : '';
const currentOrder = typeof sortOrder !== 'undefined' ? sortOrder : 'asc';
function getSortUrl(column) {
  const params = new URLSearchParams(typeof query !== 'undefined' ? query : {});
  if (currentSort === column && currentOrder === 'asc') {
    params.set('sortOrder', 'desc');
  } else {
    params.set('sortOrder', 'asc');
  }
  params.set('sortBy', column);
  params.delete('page'); // Reset to first page when sorting
  return `${baseUrl}?${params.toString()}`;
}
function getSortIcon(column) {
  if (currentSort !== column) return 'ri-arrow-up-down-line';
  return currentOrder === 'asc' ? 'ri-arrow-up-line' : 'ri-arrow-down-line';
}
%>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle mb-0 data-table">
    <thead class="table-header">
      <tr>
        <% columns.forEach(col=> { %>
        <th scope="col" class="<%= col.class || '' %>">
          <% if (col.sortable) { %>
          <a href="<%= getSortUrl(col.key) %>" class="sort-link">
            <%= col.label %>
            <i class="<%= getSortIcon(col.key) %> ms-1"></i>
          </a>
          <% } else { %> <%= col.label %> <% } %>
        </th>
        <% }) %> <% if (typeof actions !== 'undefined' && actions && actions.length > 0) { %>
        <th scope="col" class="text-end">Actions</th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% if (!data || data.length===0) { %>
      <tr>
        <td
          colspan="<%= columns.length + (typeof actions !== 'undefined' && actions && actions.length > 0 ? 1 : 0) %>"
          class="text-center py-5"
        >
          <div class="empty-state-container">
            <div class="empty-state-icon">
              <i class="ri-inbox-archive-line"></i>
            </div>
            <h5 class="mt-3 fw-semibold">No Records Found</h5>
            <p class="text-muted mb-0">It looks like there's nothing to show here yet.</p>
          </div>
        </td>
      </tr>
      <% } else { %> <% data.forEach(row=> { %>
      <tr>
        <% columns.forEach(col=> { %>
        <td class="<%= col.tdClass || '' %>">
          <% if (col.type==='badge' ) { %> <% const value=row[col.key]; const
          badgeClass=col.badgeMap ? col.badgeMap[value] || 'secondary' : (value
          ? 'success' : 'danger' ); const badgeText=col.textMap ?
          col.textMap[value] : (value ? 'Active' : 'Inactive' ); %>
          <span class="badge bg-<%= badgeClass %>"> <%= badgeText %> </span>
          <% } else if (col.render) { %> <%- col.render(row) %> <% } else { %>
          <%= row[col.key] || '-' %> <% } %>
        </td>
        <% }) %> <% if (typeof actions !== 'undefined' && actions && actions.length > 0) { %>
        <td class="text-end">
          <div class="btn-group btn-group-sm action-group" role="group">
            <% actions.forEach(action => { %> <% const rowId = row.id || row[action.idKey || 'id']; %>
              <% if (action.type === 'view') { %>
                <button type="button" class="btn <%= action.class || 'btn-soft-info' %> action-btn" onclick="openViewModal('<%= rowId %>')" title="<%= action.label || 'View' %>">
                  <i class="<%= action.icon || 'ri-eye-line' %>"></i>
                </button>
              <% } else if (action.type === 'edit') { %>
                <button type="button" class="btn <%= action.class || 'btn-soft-warning' %> action-btn" onclick="openEditModal('<%= rowId %>')" title="<%= action.label || 'Edit' %>">
                  <i class="<%= action.icon || 'ri-pencil-fill' %>"></i>
                </button>
              <% } else if (action.type === 'delete') { %>
                <button type="button" class="btn <%= action.class || 'btn-soft-danger' %> action-btn" onclick="deleteRecord('<%= rowId %>')" title="<%= action.label || 'Delete' %>">
                  <i class="<%= action.icon || 'ri-delete-bin-fill' %>"></i>
                </button>
              <% } else { %>
                <button type="button" class="btn <%= action.class %> action-btn" data-action="<%= action.onclick %>" data-row-id="<%= rowId %>" title="<%= action.label %>">
                  <i class="<%= action.icon %>"></i>
                </button>
              <% } %>
            <% }) %>
          </div>
        </td>
        <% } %>
      </tr>
      <% }) %> <% } %>
    </tbody>
  </table>
</div>



<script>
  // Attach click handlers to action buttons
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".action-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const actionName = this.getAttribute("data-action");
        const rowId = this.getAttribute("data-row-id");

        // Call the function if it exists in the global scope
        if (typeof window[actionName] === "function") {
          window[actionName](rowId);
        } else {
          console.error("Function not found:", actionName);
        }
      });
    });
  });
</script>

