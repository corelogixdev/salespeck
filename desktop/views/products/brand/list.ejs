<div class="card">
  <div class="card-header align-items-center d-flex">
    <h4 class="card-title mb-0 flex-grow-1">Brands</h4>
    <div class="d-flex gap-2 align-items-center">
      <button class="btn btn-soft-info btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#brandFilters" aria-expanded="false" aria-controls="brandFilters">
        <i class="ri-filter-3-line align-bottom me-1"></i> Filters
      </button>
      <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
        <i class="ri-refresh-line align-middle"></i> Refresh
      </button>
    </div>
  </div>

  <div class="card-body">
    <div class="collapse mb-3" id="brandFilters">
      <%- include('../../components/partials/filter-section', {
        filters: [
          { name: 'name_like', label: 'Brand Name', type: 'text', placeholder: 'Search by brand name...', icon: 'ri-search-line', colSize: 4 },
          { name: 'status', label: 'Status', type: 'toggle', options: [{ value: '1', label: 'Active' }, { value: '0', label: 'Inactive' }], colSize: 3 }
        ],
        values: query,
        action: '/brands',
        buttonColSize: 2
      }) %>
    </div>

    <%
      const tableColumns = [
        { key: 'name', label: 'Name', sortable: true, render: (row) => `<h6 class="fs-14 mb-0">${row.name}</h6>` },
        { key: 'description', label: 'Description', sortable: false, render: (row) => row.description || '-' },
        { key: 'status', label: 'Status', sortable: true, render: (row) => row.status ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>' },
        {
          key: 'actions',
          label: 'Actions',
          sortable: false,
          class: 'text-end',
          render: (row) => {
            return `<div class="btn-group btn-group-sm action-group" role="group">
              <button type="button" class="btn btn-soft-info action-btn" onclick="openViewModal('${row.id}')" title="View"><i class="ri-eye-line"></i></button>
              <button type="button" class="btn btn-soft-warning action-btn" onclick="openEditModal('${row.id}')" title="Edit"><i class="ri-pencil-fill"></i></button>
              <button type="button" class="btn btn-soft-danger action-btn" onclick="deleteRecord('${row.id}')" title="Delete"><i class="ri-delete-bin-fill"></i></button>
            </div>`;
          }
        }
      ];
    %>

    <%- include('../../components/partials/data-table', {
      columns: tableColumns,
      data: brands,
      sortBy: sortBy,
      sortOrder: sortOrder,
      baseUrl: '/brands',
      query: query
    }) %>

    <%- include('../../components/partials/pagination', {
      pagination: pagination,
      baseUrl: '/brands',
      query: query
    }) %>
  </div>
</div>

<%- include('../../components/partials/floating-action-btn', {
  targetModal: '#addBrandModal',
  icon: 'ri-add-line',
  tooltip: 'New Brand',
  colorClass: 'btn-primary',
  show: true
}) %>

<!-- Add Brand Modal -->
<div class="modal fade" id="addBrandModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-gradient-primary text-white">
        <h5 class="modal-title">Add Brand</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addBrandForm" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="brandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="brandName" name="name" required>
            <div class="invalid-feedback">Please enter brand name.</div>
          </div>
          <div class="mb-3">
            <label for="brandDescription" class="form-label">Description</label>
            <textarea class="form-control" id="brandDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Status <span class="text-danger">*</span></label>
            <div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="status" id="statusActive" value="1" checked>
                <label class="form-check-label" for="statusActive">Active</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="status" id="statusInactive" value="0">
                <label class="form-check-label" for="statusInactive">Inactive</label>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="saveBrand()">Save Brand</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Brand Modal -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-gradient-warning text-white">
        <h5 class="modal-title">Edit Brand</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editBrandForm" class="needs-validation" novalidate>
          <input type="hidden" id="editBrandId" name="id">
          <div class="mb-3">
            <label for="editBrandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="editBrandName" name="name" required>
            <div class="invalid-feedback">Please enter brand name.</div>
          </div>
          <div class="mb-3">
            <label for="editBrandDescription" class="form-label">Description</label>
            <textarea class="form-control" id="editBrandDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Status <span class="text-danger">*</span></label>
            <div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="editStatus" id="editStatusActive" value="1">
                <label class="form-check-label" for="editStatusActive">Active</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="editStatus" id="editStatusInactive" value="0">
                <label class="form-check-label" for="editStatusInactive">Inactive</label>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="updateBrand()">Update Brand</button>
      </div>
    </div>
  </div>
</div>

<%- include('../../components/partials/view-modal', { id: 'viewBrandModal', title: 'Brand Details' }) %>

<script>
  function saveBrand() {
    const form = document.getElementById('addBrandForm');
    if (form.checkValidity()) {
      const data = {
        name: document.getElementById('brandName').value,
        description: document.getElementById('brandDescription').value,
        status: document.querySelector('#addBrandForm input[name="status"]:checked').value
      };

      fetch('/brands/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            toastr.success(data.message || 'Brand created successfully');
            const modal = bootstrap.Modal.getInstance(document.getElementById('addBrandModal'));
            if (modal) modal.hide();
            setTimeout(() => window.location.reload(), 1000);
          } else {
            toastr.error(data.message || 'Error saving brand');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          toastr.error('Failed to save brand');
        });
    } else {
      form.classList.add('was-validated');
    }
  }

  function openEditModal(id) {
    fetch(`/brands/${id}`)
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const brand = data.brand;
          document.getElementById('editBrandId').value = brand.id;
          document.getElementById('editBrandName').value = brand.name;
          document.getElementById('editBrandDescription').value = brand.description || '';

          if (brand.status == 1) {
            document.getElementById('editStatusActive').checked = true;
          } else {
            document.getElementById('editStatusInactive').checked = true;
          }

          const modal = new bootstrap.Modal(document.getElementById('editBrandModal'));
          modal.show();
        }
      })
      .catch(error => console.error('Error:', error));
  }

  function updateBrand() {
    const form = document.getElementById('editBrandForm');
    if (form.checkValidity()) {
      const data = {
        id: document.getElementById('editBrandId').value,
        name: document.getElementById('editBrandName').value,
        description: document.getElementById('editBrandDescription').value,
        status: document.querySelector('#editBrandForm input[name="editStatus"]:checked').value
      };

      fetch('/brands/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            toastr.success(data.message || 'Brand updated successfully');
            const modal = bootstrap.Modal.getInstance(document.getElementById('editBrandModal'));
            if (modal) modal.hide();
            setTimeout(() => window.location.reload(), 1000);
          } else {
            toastr.error(data.message || 'Error updating brand');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          toastr.error('Failed to update brand');
        });
    } else {
      form.classList.add('was-validated');
    }
  }

  function openViewModal(id) {
    fetch(`/brands/${id}`)
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const brand = data.brand;
          renderViewModal('viewBrandModal', [
            { label: 'Brand Name', value: brand.name },
            { label: 'Description', value: brand.description || '-' },
            { label: 'Status', value: brand.status ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>' },
            { label: 'Created At', value: brand.createdAt ? new Date(brand.createdAt).toLocaleString() : '-' },
            { label: 'Updated At', value: brand.updatedAt ? new Date(brand.updatedAt).toLocaleString() : '-' }
          ]);
          const modal = new bootstrap.Modal(document.getElementById('viewBrandModal'));
          modal.show();
        }
      })
      .catch(error => console.error('Error:', error));
  }

  function deleteRecord(id) {
    $.confirm({
      title: 'Delete Brand',
      content: 'Are you sure you want to delete this brand?',
      type: 'red',
      typeAnimated: true,
      buttons: {
        delete: {
          text: 'Delete',
          btnClass: 'btn-danger',
          action: function() {
            fetch('/brands/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: id })
            })
              .then(response => response.json())
              .then(data => {
                if (data.success) {
                  toastr.success(data.message || 'Brand deleted successfully');
                  setTimeout(() => window.location.reload(), 1000);
                } else {
                  toastr.error(data.message || 'Error deleting brand');
                }
              })
              .catch(error => {
                console.error('Error:', error);
                toastr.error('Failed to delete brand');
              });
          }
        },
        cancel: {
          text: 'Cancel',
          btnClass: 'btn-secondary'
        }
      }
    });
  }
</script>
