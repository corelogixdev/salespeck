<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Update Product Quantity</h4>
            </div>
            <div class="card-body">
                <form id="quantityForm" method="POST" action="/products/quantity/save">
                    <input type="hidden" name="id" value="<%= product.id %>">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input type="text" name="name" class="form-control" value="<%= product.name %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Current Quantity</label>
                            <input type="number" name="currentQuantity" class="form-control"
                                value="<%= product.quantity %>">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Quantity to
                                <% if (type==="decrease" ) { %>
                                    Decrease
                                    <% } else { %>
                                        Increase
                                        <% } %>*
                            </label>
                            <input type="number" name="quantity" class="form-control"
                                min="<%= -1 * product.quantity %>">
                        </div>
                        <div class="col-md-6" id="expirydate">
                            <label class="form-label">Expiry Date</label>
                            <input type="date" name="expirydate" class="form-control"
                                min="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="col-md-12 mt-3">
                            <label class="form-label">Note *</label>
                            <textarea name="note" class="form-control" required rows="3"
                                placeholder="Enter a note for this quantity change"></textarea>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('quantityForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        let type = '<%= type %>';
        let quantityElement = document.querySelector('input[name="quantity"]');
        let quantity = parseInt(quantityElement.value);
        if (type === 'decrease' && quantity > 0) {
            quantityElement.value = quantity * -1;
        } else if (type === 'increase' && quantity < 0) {
            quantityElement.value = quantity * -1;
        }
        try {
            const response = await fetch(this.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(Object.fromEntries(new FormData(this))),
            });
            const result = await response.json();
            if (result.success) {
                $.alert({
                    title: 'Success!',
                    content: result.message,
                    boxWidth: '30%',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'green',
                    buttons: {
                        confirm: {
                            text: 'OK',
                            btnClass: 'btn-primary',
                            action: function () {
                                window.location.reload();
                            }
                        }
                    }
                });
            } else {
                $.alert({
                    title: 'Error!',
                    content: result.message,
                    boxWidth: '30%',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'red',
                });
            }
        } catch (error) {
            $.alert({
                title: 'Error!',
                content: 'An error occurred while saving',
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'red',
            });
        }
    });
</script>