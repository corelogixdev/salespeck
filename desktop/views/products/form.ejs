<div class="page_header d-flex justify-content-between align-items-center mb-3">
  <h3>
    <%= title %>
  </h3>
</div>
<div class="card">
  <div class="card-body">
    <form id="form">
      <% if (product) { %>
        <input type="hidden" name="id" value="<%= product.id %>">
        <% } %>
          <div class="row gy-2">
            <div class="col-lg-6">
              <div class="form-group">
                <label for="name" class="form-label">Name:</label>
                <input type="text" class="form-control" id="name" name="name" value="<%= product ? product.name : '' %>"
                  required>
              </div>
            </div>

            <div class="col-lg-6">
              <div class="form-group">
                <label for="barcode" class="form-label">Barcode:</label>
                <div class="barcode-input-group">
                  <input type="text" class="form-control" id="barcode" name="barcode"
                    value="<%= product ? product.barcode : '' %>" placeholder="Scan or enter barcode">
                  <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="barcode-mode" id="barcode-manual" autocomplete="off">
                    <label class="btn btn-outline-secondary" for="barcode-manual">Manual</label>
                    <input type="radio" class="btn-check" name="barcode-mode" id="barcode-scanner" autocomplete="off"
                      checked>
                    <label class="btn btn-outline-primary" for="barcode-scanner">Barcode</label>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="taxid" class="form-label">Tax Type:</label>
                <select class="form-control" id="taxid" name="taxid" class="text-uppercase">
                  <option value="">Select Tax Type</option>
                  <% taxes.forEach(tax=> { %>
                    <option value="<%= tax.id %>" <%=product?.taxid==tax.id ? 'selected' : '' %>><%=
                        tax.name.toUpperCase() %> (<%= tax.percentage %>%)</option>
                    <% }); %>
                </select>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="category" class="form-label">Category:</label>
                <select class="form-select" id="category" name="category">
                  <option value="">Select Category</option>
                  <% categories.forEach(category=> { %>
                    <option value="<%= category.id %>" <%=product?.category==category.id ? 'selected' : '' %>>
                      <%= category.name %>
                    </option>
                    <% }); %>
                </select>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="brand" class="form-label">Brand:</label>
                <select class="form-select" id="brand" name="brand">
                  <option value="">Select Brand</option>
                  <% brands.forEach(brand=> { %>
                    <option value="<%= brand.id %>" <%=product?.brand==brand.id ? 'selected' : '' %>>
                      <%= brand.name %>
                    </option>
                    <% }); %>
                </select>
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="carrycost" class="form-label">Carry Cost:</label>
                <input type="number" step="0.01" class="form-control" id="carrycost" name="carrycost"
                  value="<%= product ? product.carrycost : '' %>">
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="discount" class="form-label">Discount:</label>
                <input type="number" step="0.01" class="form-control" id="discount" name="discount"
                  value="<%= product ? product.discount : '' %>">
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="purchaseprice" class="form-label">Purchase Price:</label>
                <input type="number" step="0.01" class="form-control" id="purchaseprice" name="purchaseprice"
                  value="<%= product ? product.purchaseprice : '' %>">
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="quantity" class="form-label">Quantity:</label>
                <input type="number" step="0.01" class="form-control" id="quantity" name="quantity"
                  value="<%= product ? product.quantity : '' %>">
              </div>
            </div>
            <div class="col-lg-6">
              <div class="form-group">
                <label for="saleprice" class="form-label">Sale Price:</label>
                <input type="number" step="0.01" class="form-control" id="saleprice" name="saleprice"
                  value="<%= product ? product.saleprice : '' %>">
              </div>
            </div>
            <div class="col-lg-6 mt-5">
              <div class="d-flex gap-4 align-items-center">
                <div class="form-group mb-0">
                  <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="saleactive" name="saleactive" <%=(!product ||
                      product.saleactive) ? 'checked' : '' %>>
                    <label class="form-check-label" for="saleactive">Sale Active</label>
                  </div>
                </div>
                <div class="form-group mb-0">
                  <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" id="purchaseactive" name="purchaseactive"
                      <%=(!product || product.purchaseactive) ? 'checked' : '' %>>
                    <label class="form-check-label" for="purchaseactive">Purchase Active</label>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-3">
            <%= product ? 'Update' : 'Create' %>
          </button>
    </form>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Barcode mode toggle functionality
    const barcodeInput = document.getElementById('barcode');
    const manualMode = document.getElementById('barcode-manual');
    const barcodeMode = document.getElementById('barcode-scanner');

    function updateBarcodePlaceholder() {
      if (manualMode.checked) {
        barcodeInput.placeholder = 'Enter barcode manually';
      } else {
        barcodeInput.placeholder = 'Scan or enter barcode';
      }
    }

    manualMode.addEventListener('change', updateBarcodePlaceholder);
    barcodeMode.addEventListener('change', updateBarcodePlaceholder);

    // Prevent window from losing focus during barcode scanning
    // This prevents the application from minimizing when barcode scanner input is processed
    let isBarcodeInputFocused = false;

    barcodeInput.addEventListener('focus', () => {
      isBarcodeInputFocused = true;
      if (window.electron && barcodeMode.checked) {
        window.electron.send('lock-window-focus');
      }
    });

    barcodeInput.addEventListener('input', () => {
      if (window.electron && barcodeMode.checked) {
        window.electron.send('lock-window-focus');
      }
    });

    barcodeInput.addEventListener('blur', () => {
      setTimeout(() => {
        if (document.activeElement !== barcodeInput) {
          isBarcodeInputFocused = false;
          if (window.electron) {
            window.electron.send('unlock-window-focus');
          }
        }
      }, 500);
    });

    // Prevent window blur when search input is focused
    window.addEventListener('blur', (event) => {
      if (isBarcodeInputFocused && barcodeMode.checked) {
        event.preventDefault();
        event.stopPropagation();

        // Immediately refocus the window and input
        requestAnimationFrame(() => {
          window.focus();
          barcodeInput.focus();
        });
      }
    }, true);

    // Handle keydown to prevent minimize shortcuts
    barcodeInput.addEventListener('keydown', (event) => {
      const isEnterKey = event.key === 'Enter' || event.keyCode === 13;
      const isCtrlM = event.ctrlKey && (event.key === 'm' || event.key === 'M');

      if (isCtrlM) {
        event.preventDefault();
        event.stopPropagation();
        barcodeInput.focus();
        return;
      }

      if (isEnterKey && barcodeMode.checked) {
        // Prevent form submission on barcode scan if in barcode mode
        // Most scanners send Enter after the barcode
        event.preventDefault();
        event.stopPropagation();
        barcodeInput.focus();
        return;
      }
    });

    document.querySelector('form').addEventListener('submit', async (event) => {
      event.preventDefault();
      document.querySelectorAll('input').forEach(input => {
        input.style.borderColor = '';
      });
      const name = document.getElementById('name').value;
      if (name.length < 2) {
        document.getElementById('name').style.borderColor = 'red';
        return;
      }
      const formData = new FormData(event.target);
      const data = Object.fromEntries(formData.entries());
      try {
        const response = await fetch('/products/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (result.success) {
          $.alert({
            title: 'Success!',
            content: result.message,
            type: 'green',
            theme: 'modern',
            buttons: {
              ok: function () {
                window.location.reload();
              },
            },
          });
        } else {
          $.alert({
            title: 'Error!',
            content: result.message,
            type: 'red',
            theme: 'modern',
          });
        }
      } catch (error) {
        $.alert({
          title: 'Error!',
          content: 'An error occurred while saving the product.',
          type: 'red',
          theme: 'modern',
        });
      }
    });
  });
</script>