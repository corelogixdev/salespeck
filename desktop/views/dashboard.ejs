<!-- Low Stock Products Table -->
<div class="row">
  <% if ((!dashboardConfig.low_stock_alert || dashboardConfig.low_stock_alert !=='hidden' )) { %>
    <div class="col-lg-12">
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="bx bx-error-circle text-warning"></i> Low Stock Alert
          </h5>
        </div>
        <div class="card-body">
          <% if (dashboardConfig.low_stock_alert==='partial' && lowStockProducts && lowStockProducts.length> 0) { %>
            <!-- Show generic alert or limited info -->
            <div class="text-center text-muted py-3">
              <i class="bx bx-error-circle fs-1 text-warning"></i>
              <p class="mb-0">There are <%= lowStockProducts.length %> items with low stock.</p>
            </div>
            <% } else if (lowStockProducts && lowStockProducts.length> 0) { %>
              <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Product Name</th>
                      <th class="text-center">Current Stock</th>
                      <th class="text-end">Sale Price</th>
                      <th class="text-center">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% lowStockProducts.forEach(product=> { %>
                      <tr>
                        <td><a href="/product/<%= product.id %>" class="text-decoration-none">
                            <%= product.name %>
                          </a></td>
                        <td class="text-center">
                          <span class="badge <%= product.quantity <= 5 ? 'bg-danger' : 'bg-warning' %>">
                            <%= product.quantity %>
                          </span>
                        </td>
                        <td class="text-end">Rs. <%= product.saleprice.toFixed(2) %>
                        </td>
                        <td class="text-center">
                          <% if (product.quantity <=5) { %>
                            <span class="badge bg-danger">Critical</span>
                            <% } else { %>
                              <span class="badge bg-warning">Low</span>
                              <% } %>
                        </td>
                      </tr>
                      <% }); %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
                <div class="text-center text-muted py-3">
                  <i class="bx bx-check-circle fs-1 text-success"></i>
                  <p class="mb-0">All products are well stocked!</p>
                </div>
                <% } %>
        </div>
      </div>
    </div>
    <% } %>
</div>

<!-- Hidden data containers -->
<div id="products-data" data-products='<%- JSON.stringify(topFiveSoldProductsWithSoldQuantity).replace(/' /g, "&#39;" )
  %>' style="display: none;"></div>
<div id="sales-data" data-sales='<%- JSON.stringify(salesCountByDay).replace(/' /g, "&#39;" ) %>' style="display: none;"></div>
<div id="hourly-sales-data" data-hourly='<%- JSON.stringify(hourlySales).replace(/' /g, "&#39;" ) %>' style="display: none;"></div>
<div id="category-sales-data" data-category='<%- JSON.stringify(categorySales).replace(/' /g, "&#39;" ) %>' style="display: none;"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Parse data from data attributes
    const productsData = document.getElementById('products-data');
    const salesData = document.getElementById('sales-data');

    let topProducts = JSON.parse(productsData.getAttribute('data-products'));
    let salesByDay = JSON.parse(salesData.getAttribute('data-sales'));

    // Prepare top products chart data
    let topProducts_labels = [];
    let topProducts_data = [];
    topProducts.forEach((product, index) => {
      if (index < 5) {
        topProducts_labels.push(product?.product_name || 'N/A');
        topProducts_data.push(parseInt(product?.total_quantity) || 0);
      }
    });

    // Prepare sales trend chart data (last 30 days)
    let salesTrend_dates = [];
    let salesTrend_totals = [];
    let salesTrend_revenues = [];
    salesByDay.forEach(sale => {
      // Format date as MM-DD
      const date = new Date(sale.date);
      const formattedDate = (date.getMonth() + 1).toString().padStart(2, '0') + '-' +
        date.getDate().toString().padStart(2, '0');
      
      salesTrend_dates.push(formattedDate);
      salesTrend_totals.push(parseInt(sale.total) || 0);
      salesTrend_revenues.push(parseFloat(sale.revenue) || 0);
    });

    // Top Products Chart (Doughnut Chart)
    const ctxTop = document.getElementById('topProductsChart').getContext('2d');
    
    // Custom plugin to draw text in the middle of a doughnut chart
    const centerTextPlugin = {
      id: 'centerText',
      afterDraw: (chart) => {
        if (chart.config.type !== 'doughnut') return;
        const { ctx, canvas } = chart;
        ctx.save();
        const x = chart.getDatasetMeta(0).data[0]?.x;
        const y = chart.getDatasetMeta(0).data[0]?.y;
        if (!x || !y) return;

        const total = chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
        
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        // Draw "Total" label
        ctx.font = '12px Inter, sans-serif';
        ctx.fillStyle = '#999';
        ctx.fillText('Total Sold', x, y - 10);
        
        // Draw the number
        ctx.font = 'bold 24px Inter, sans-serif';
        ctx.fillStyle = '#333';
        ctx.fillText(total, x, y + 15);
        ctx.restore();
      }
    };

    new Chart(ctxTop, {
      type: 'doughnut',
      plugins: [centerTextPlugin],
      data: {
        labels: topProducts_labels.length > 0 ? topProducts_labels : ['No Data'],
        datasets: [{
          data: topProducts_data.length > 0 ? topProducts_data : [0],
          backgroundColor: ['#405189', '#0ab39c', '#f7b84b', '#f06548', '#299cdb'],
          hoverOffset: 12,
          borderRadius: 8,
          spacing: 4,
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '82%',
        plugins: {
          title: {
            display: true,
            text: 'Top 5 Products (Last 30 Days)',
            font: { size: 14, weight: '600' },
            padding: { bottom: 20 }
          },
          legend: { 
            position: 'bottom',
            labels: {
              usePointStyle: true,
              padding: 20,
              font: { size: 11 }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0,0,0,0.8)',
            padding: 12,
            cornerRadius: 8
          }
        }
      }
    });

    // Sales Trend Chart (Combined Bar and Line Chart)
    const ctxTrend = document.getElementById('salesTrendChart').getContext('2d');
    new Chart(ctxTrend, {
      type: 'bar',
      data: {
        labels: salesTrend_dates,
        datasets: [
          {
            label: 'Orders',
            data: salesTrend_totals,
            backgroundColor: '#A9B5E1',
            borderRadius: 4,
            yAxisID: 'y'
          },
          {
            label: 'Revenue (Rs.)',
            data: salesTrend_revenues,
            type: 'line',
            borderColor: '#4CAF50',
            backgroundColor: 'rgba(76, 175, 80, 0.2)',
            fill: true,
            tension: 0.4,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: {
            display: true,
            text: 'Sales Trend (Last 30 Days)',
            font: { size: 14, weight: '600' }
          },
          legend: { position: 'top' }
        },
        scales: {
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            title: { display: true, text: 'Orders' },
            beginAtZero: true,
            ticks: { stepSize: 1 }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            title: { display: true, text: 'Revenue (Rs.)' },
            beginAtZero: true,
            grid: { drawOnChartArea: false }
          }
        }
      }
    });

    // Hourly Sales Chart
    const hourlyData = JSON.parse(document.getElementById('hourly-sales-data').getAttribute('data-hourly'));
    const hourlyLabels = Array.from({length: 24}, (_, i) => i.toString().padStart(2, '0') + ':00');
    const hourlyValues = new Array(24).fill(0);
    
    hourlyData.forEach(item => {
        const h = parseInt(item.hour);
        if (h >= 0 && h < 24) hourlyValues[h] = parseFloat(item.revenue);
    });

    const ctxHourly = document.getElementById('hourlySalesChart').getContext('2d');
    new Chart(ctxHourly, {
      type: 'bar',
      data: {
        labels: hourlyLabels,
        datasets: [{
          label: 'Revenue',
          data: hourlyValues,
          backgroundColor: '#667eea',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: {
            display: true,
            text: 'Today\'s Hourly Performance',
            font: { size: 14 }
          },
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });

    // Category Sales Chart
    const categoryData = JSON.parse(document.getElementById('category-sales-data').getAttribute('data-category'));
    const categoryLabels = categoryData.map(item => item.category || 'Uncategorized');
    const categoryValues = categoryData.map(item => parseFloat(item.total_revenue));

    const ctxCategory = document.getElementById('categorySalesChart').getContext('2d');
    new Chart(ctxCategory, {
      type: 'doughnut',
      data: {
        labels: categoryLabels.length > 0 ? categoryLabels : ['No Data'],
        datasets: [{
          data: categoryValues.length > 0 ? categoryValues : [0],
          backgroundColor: ['#405189', '#0ab39c', '#f7b84b', '#f06548', '#299cdb'],
          borderRadius: 6,
          spacing: 3,
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '75%',
        plugins: {
          title: {
            display: true,
            text: 'Revenue by Category',
            font: { size: 14, weight: '600' }
          },
          legend: { 
            position: 'bottom',
            labels: {
              usePointStyle: true,
              padding: 15
            }
          }
        }
      }
    });
  });
</script>