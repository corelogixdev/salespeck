<% const filterValues = values || {}; %>

<div class="filter-section">
    <form id="filterForm" method="GET" action="<%= action %>" class="row g-3">
        <% filters.forEach(filter => {
            const value = filterValues[filter.name] || '';
            if (filter.type === 'hidden') { %>
                <input type="hidden" id="<%= filter.name %>" name="<%= filter.name %>" value="<%= value %>">
            <% } else { %>
                <div class="col-lg-<%= filter.colSize || 3 %>">
                    <% if (filter.type === 'text') { %>
                        <div class="search-box">
                            <label for="<%= filter.name %>" class="form-label">
                                <%= filter.label %>
                            </label>
                            <input type="text" class="form-control" id="<%= filter.name %>" name="<%= filter.name %>"
                                placeholder="<%= filter.placeholder || filter.label %>" value="<%= value %>">
                            <i class="<%= filter.icon || 'ri-search-line' %> search-icon"></i>
                        </div>
                    <% } else if (filter.type === 'select') { %>
                        <div class="form-group">
                            <label for="<%= filter.name %>" class="form-label">
                                <%= filter.label %>
                            </label>
                            <select class="form-select" id="<%= filter.name %>" name="<%= filter.name %>">
                                <option value="">All</option>
                                <% (filter.options || []).forEach(opt => { %>
                                    <option value="<%= opt.value %>" <%= value == opt.value ? 'selected' : '' %>>
                                        <%= opt.label %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    <% } else if (filter.type === 'toggle') { %>
                        <div class="form-group">
                            <label class="form-label"><%= filter.label %></label>
                            <div class="btn-group filter-toggle-group w-100" role="group" data-input="<%= filter.name %>">
                                <button type="button" class="btn btn-sm <%= !value ? 'btn-primary active' : 'btn-light' %>" data-value="">
                                    All
                                </button>
                                <% (filter.options || []).forEach(opt => { %>
                                    <button type="button" class="btn btn-sm <%= value == opt.value ? 'btn-primary active' : 'btn-light' %>" data-value="<%= opt.value %>">
                                        <%= opt.label %>
                                    </button>
                                <% }) %>
                            </div>
                            <input type="hidden" id="<%= filter.name %>" name="<%= filter.name %>" value="<%= value %>">
                        </div>
                    <% } else if (filter.type === 'date') { %>
                        <div class="form-group">
                            <label for="<%= filter.name %>" class="form-label">
                                <%= filter.label %>
                            </label>
                            <input type="date" class="form-control" id="<%= filter.name %>"
                                name="<%= filter.name %>" value="<%= value %>">
                        </div>
                    <% } else if (filter.type === 'number') { %>
                        <div class="form-group">
                            <label for="<%= filter.name %>" class="form-label">
                                <%= filter.label %>
                            </label>
                            <input type="number" class="form-control" id="<%= filter.name %>"
                                name="<%= filter.name %>"
                                placeholder="<%= filter.placeholder || filter.label %>" value="<%= value %>"
                                <%= filter.min !== undefined ? `min="${filter.min}"` : '' %>
                                <%= filter.max !== undefined ? `max="${filter.max}"` : '' %>>
                        </div>
                    <% } else if (filter.type === 'range') { %>
                        <div class="form-group">
                            <label class="form-label"><%= filter.label %></label>
                            <div class="input-group range-input-group">
                                <input type="number" class="form-control" id="<%= filter.names[0] %>"
                                    name="<%= filter.names[0] %>"
                                    placeholder="<%= filter.placeholders ? filter.placeholders[0] : 'Min' %>"
                                    value="<%= filterValues[filter.names[0]] || '' %>">
                                <span class="input-group-text">â€“</span>
                                <input type="number" class="form-control" id="<%= filter.names[1] %>"
                                    name="<%= filter.names[1] %>"
                                    placeholder="<%= filter.placeholders ? filter.placeholders[1] : 'Max' %>"
                                    value="<%= filterValues[filter.names[1]] || '' %>">
                            </div>
                        </div>
                    <% } else if (filter.type === 'daterange') { %>
                        <div class="search-box">
                            <label for="<%= filter.name %>" class="form-label">
                                <%= filter.label %>
                            </label>
                            <input type="text" class="form-control flatpickr-range" data-provider="flatpickr" data-range="true" data-date-format="Y-m-d"
                                id="<%= filter.name %>" name="<%= filter.name %>"
                                placeholder="<%= filter.placeholder || filter.label %>" value="<%= value %>">
                            <i class="<%= filter.icon || 'ri-calendar-2-line' %> search-icon"></i>
                        </div>
                    <% } %>
                </div>
            <% }
        }) %>

        <!-- Action Buttons -->
        <div class="col-lg-<%= typeof buttonColSize !== 'undefined' ? buttonColSize : (filters.length > 3 ? 12 : 3) %> d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="ri-search-line me-1"></i> Search
            </button>
            <% const hasActiveFilters = Object.keys(filterValues).some(key =>
                filterValues[key] && key !== 'page' && key !== 'pageSize'
            );
            if (hasActiveFilters) { %>
                <a href="<%= action %>" class="btn btn-danger">
                    <i class="ri-close-line me-1"></i> Clear
                </a>
            <% } %>
        </div>
    </form>
</div>



<script>
    (function() {
        if (window.filterToggleInitialized) return;
        window.filterToggleInitialized = true;
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.filter-toggle-group .btn');
            if (!btn) return;
            const group = btn.closest('.filter-toggle-group');
            if (!group) return;
            const inputId = group.getAttribute('data-input');
            const input = document.getElementById(inputId);
            if (!input) return;

            group.querySelectorAll('.btn').forEach(function(b) {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-light');
            });
            btn.classList.remove('btn-light');
            btn.classList.add('btn-primary', 'active');
            input.value = btn.getAttribute('data-value');
        });
    })();
</script>

