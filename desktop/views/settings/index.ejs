<div class="card">
    <div class="card-body">
        <h5 class="card-title">Settings</h5>
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link <%= (typeof currenttab !== 'undefined' && currenttab === 'env') || (typeof currenttab === 'undefined') ? 'active' : '' %>"
                    id="env-tab" data-bs-toggle="tab" data-bs-target="#env" type="button"
                    role="tab" aria-controls="env"
                    aria-selected="<%= (typeof currenttab !== 'undefined' && currenttab === 'env') || (typeof currenttab === 'undefined') ? 'true' : 'false' %>">
                    Environment Settings (.settings)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link <%= (typeof currenttab !== 'undefined' && currenttab === 'db') ? 'active' : '' %>"
                    id="db-tab" data-bs-toggle="tab" data-bs-target="#db" type="button"
                    role="tab" aria-controls="db"
                    aria-selected="<%= (typeof currenttab !== 'undefined' && currenttab === 'db') ? 'true' : 'false' %>">
                    Application Settings (Database)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link <%= (typeof currenttab !== 'undefined' && currenttab === 'dashboard') ? 'active' : '' %>"
                    id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard" type="button"
                    role="tab" aria-controls="dashboard"
                    aria-selected="<%= (typeof currenttab !== 'undefined' && currenttab === 'dashboard') ? 'true' : 'false' %>">
                    Dashboard Customization
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link <%= (typeof currenttab !== 'undefined' && currenttab === 'license') ? 'active' : '' %>"
                    id="license-tab" data-bs-toggle="tab" data-bs-target="#license" type="button"
                    role="tab" aria-controls="license"
                    aria-selected="<%= (typeof currenttab !== 'undefined' && currenttab === 'license') ? 'true' : 'false' %>">
                    License
                </button>
            </li>
        </ul>

        <div class="tab-content" id="myTabContent">
            <!-- Environment Settings Tab (.settings file) -->
            <div class="tab-pane fade <%= (typeof currenttab !== 'undefined' && currenttab === 'env') || (typeof currenttab === 'undefined') ? 'show active' : '' %>"
                id="env" role="tabpanel" aria-labelledby="env-tab">
                <form action="/settings/save?type=env" method="POST" class="p-2 card mt-3">
                    <div class="row">
                        <% 
                        // Loop through variables from envSettings (which comes from DEFAULT_SETTINGS)
                        // installEnv.js is the single source of truth - only show variables defined there
                        Object.keys(envSettings).forEach(key => { 
                            if (key === 'printer') {
                                // Handle printer settings separately
                                return;
                            }
                            
                            // Get label from translations if available, otherwise use key name
                            const label = translations[key] || key.charAt(0).toUpperCase() + key.slice(1).replace(/_/g, ' ');
                            const value = envSettings[key];
                            const fieldType = typeof value;
                        %>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label class="form-label" for="<%= key %>">
                                        <%= label %>:
                                        <% if (typeof envOnlyVars !== 'undefined' && envOnlyVars[key]) { %>
                                            <span class="badge bg-info ms-2" title="This value comes from .env file and is read-only">From .env</span>
                                        <% } %>
                                    </label>
                                    <% 
                                    const isReadOnly = (typeof envOnlyVars !== 'undefined' && envOnlyVars[key]) || key === 'install_date';
                                    %>
                                    <% if (key === 'env') { %>
                                        <select class="form-control" id="<%= key %>" name="<%= key %>" <%= isReadOnly ? 'disabled' : '' %>>
                                            <option value="development" <%= value === 'development' ? 'selected' : '' %>>Development</option>
                                            <option value="production" <%= value === 'production' ? 'selected' : '' %>>Production</option>
                                        </select>
                                    <% } else if (key === 'logging') { %>
                                        <input type="checkbox" class="form-check-input" id="<%= key %>" name="<%= key %>" <%= value ? 'checked' : '' %> <%= isReadOnly ? 'disabled' : '' %>>
                                    <% } else if (fieldType === 'number' || key === 'CI_PROJECT_ID' || key === 'port') { %>
                                        <input type="number" class="form-control" id="<%= key %>" name="<%= key %>" value="<%= value %>" <%= isReadOnly ? 'readonly' : '' %>>
                                    <% } else { %>
                                        <input type="text" class="form-control" id="<%= key %>" name="<%= key %>" value="<%= value || '' %>" <%= isReadOnly ? 'readonly' : '' %>>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <% if (translations.printer) { %>
                        <hr class="my-4">
                        <h6 class="mb-3">Printer Settings</h6>
                        <div class="row">
                            <% Object.keys(translations.printer).forEach(key => { %>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label class="form-label" for="printer-<%= key %>">
                                            <%= translations.printer[key] %>:
                                        </label>
                                        <% if (key === 'silentPrinting') { %>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="printer-<%= key %>" name="printer[<%= key %>]" value="true" <%= envSettings.printer[key] === true || envSettings.printer[key] === 'true' ? 'checked' : '' %>>
                                                <label class="form-check-label" for="printer-<%= key %>">
                                                    Enable Silent Printing
                                                </label>
                                            </div>
                                        <% } else if (key === 'numberOfPrints') { %>
                                            <input type="number" class="form-control" id="printer-<%= key %>" name="printer[<%= key %>]" value="<%= envSettings.printer[key] || 1 %>" min="1" max="10">
                                        <% } else if (key === 'width' || key === 'height' || key === 'fontSize') { %>
                                            <input type="number" class="form-control" id="printer-<%= key %>" name="printer[<%= key %>]" value="<%= envSettings.printer[key] %>">
                                        <% } else { %>
                                            <input type="text" class="form-control" id="printer-<%= key %>" name="printer[<%= key %>]" value="<%= envSettings.printer[key] || '' %>">
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary mt-3">Save Environment Settings</button>
                    </div>
                </form>
            </div>

            <!-- Database Settings Tab -->
            <div class="tab-pane fade <%= (typeof currenttab !== 'undefined' && currenttab === 'db') ? 'show active' : '' %>"
                id="db" role="tabpanel" aria-labelledby="db-tab">
                <% if (Object.keys(dbSettings).length === 0) { %>
                    <div class="alert alert-info mt-3">
                        No database settings found.
                    </div>
                <% } else { %>
                    <% Object.keys(dbSettings).forEach((setting, index) => { %>
                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="mb-0"><%= setting.charAt(0).toUpperCase() + setting.slice(1) %></h6>
                            </div>
                            <div class="card-body">
                                <form action="/settings/save?type=db&name=<%= setting %>" method="POST">
                                    <div class="row">
                                        <% Object.keys(dbSettings[setting]).forEach(key => { %>
                                            <div class="col-lg-6">
                                                <div class="form-group">
                                                    <label class="form-label" for="<%= setting %>-<%= key %>">
                                                        <%= key.charAt(0).toUpperCase() + key.slice(1) %>:
                                                    </label>
                                                    <% if (typeof dbSettings[setting][key] === 'boolean') { %>
                                                        <input type="checkbox" class="form-check-input" id="<%= setting %>-<%= key %>" name="<%= key %>" <%= dbSettings[setting][key] ? 'checked' : '' %>>
                                                    <% } else { %>
                                                        <input type="text" class="form-control" id="<%= setting %>-<%= key %>" name="<%= key %>" value="<%= dbSettings[setting][key] %>">
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary mt-3">Save <%= setting.charAt(0).toUpperCase() + setting.slice(1) %></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
            <!-- Dashboard Customization Tab -->
            <div class="tab-pane fade <%= (typeof currenttab !== 'undefined' && currenttab === 'dashboard') ? 'show active' : '' %>"
                id="dashboard" role="tabpanel" aria-labelledby="dashboard-tab">
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">Customize Dashboard Visibility</h6>
                    </div>
                    <div class="card-body">
                        <form action="/settings/save?type=dashboard" method="POST">
                            <div class="row">
                                <% 
                                const dashboardItems = [
                                    { key: 'todays_sales', label: "Today's Sales Card" },
                                    { key: 'todays_customers', label: "Today's Customers Card" },
                                    { key: 'last_30_days_sales', label: "Last 30 Days Sales Card" },
                                    { key: 'weekly_summary', label: "Weekly Summary Table" },
                                    { key: 'monthly_summary', label: "Monthly Summary Table" },
                                    { key: 'sales_trend_chart', label: "Sales Trend Chart" },
                                    { key: 'top_products_chart', label: "Top Products Chart" },
                                    { key: 'low_stock_alert', label: "Low Stock Alert" }
                                ];
                                %>
                                <% dashboardItems.forEach(item => { %>
                                    <div class="col-lg-6 mb-3">
                                        <div class="form-group border p-3 rounded">
                                            <h6 class="mb-2"><%= item.label %></h6>
                                            <div class="d-flex gap-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="<%= item.key %>" id="<%= item.key %>_visible" value="visible" 
                                                        <%= (!dashboardConfig[item.key] || dashboardConfig[item.key] === 'visible') ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="<%= item.key %>_visible">
                                                        Visible
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="<%= item.key %>" id="<%= item.key %>_partial" value="partial"
                                                        <%= (dashboardConfig[item.key] === 'partial') ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="<%= item.key %>_partial">
                                                        Partial (Hide Figures)
                                                    </label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="<%= item.key %>" id="<%= item.key %>_hidden" value="hidden"
                                                        <%= (dashboardConfig[item.key] === 'hidden') ? 'checked' : '' %>>
                                                    <label class="form-check-label" for="<%= item.key %>_hidden">
                                                        Hidden
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary mt-3">Save Dashboard Preferences</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade <%= (typeof currenttab !== 'undefined' && currenttab === 'license') ? 'show active' : '' %>"
                id="license" role="tabpanel" aria-labelledby="license-tab">
                <div class="p-3 card mt-3">
                    <% const ls = typeof licenseStatus !== 'undefined' && licenseStatus ? licenseStatus : null; %>
                    <% if (!ls) { %>
                        <p class="text-muted mb-0">License status unavailable.</p>
                    <% } else { %>
                        <div class="alert alert-<%= ls.state === 'valid' ? 'success' : (ls.state === 'grace' ? 'warning' : 'danger') %> mb-3">
                            <strong class="text-uppercase"><%= ls.state %></strong>
                            <div class="mt-1"><%= ls.message %></div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="text-muted text-uppercase fs-11">Client</div>
                                <div class="fw-semibold"><%= ls.clientName || '—' %></div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted text-uppercase fs-11">Plan</div>
                                <div class="fw-semibold text-capitalize"><%= ls.plan || '—' %></div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted text-uppercase fs-11">Expires</div>
                                <div class="fw-semibold"><%= ls.expiresAt ? ls.expiresAt.slice(0, 10) : '—' %></div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted text-uppercase fs-11">Staff seats</div>
                                <div class="fw-semibold"><%= ls.seatsUsed || 0 %> / <%= ls.seatsMax || 0 %></div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted text-uppercase fs-11">Days remaining</div>
                                <div class="fw-semibold"><%= typeof ls.daysRemaining === 'number' ? ls.daysRemaining : '—' %></div>
                            </div>
                        </div>
                        <a href="/license/activate" class="btn btn-soft-primary btn-sm">
                            <i class="ri-key-2-line align-bottom me-1"></i> Activate / renew license
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
