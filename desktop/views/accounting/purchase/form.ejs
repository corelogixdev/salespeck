<!-- Tab Bar -->
<div class="tab-bar-container">
    <div class="tab-bar-content">
        <ul class="nav nav-tabs nav-tabs-custom mb-0 border-0" id="purchase-tabs" role="tablist">
            <!-- Tabs will be dynamically added here -->
        </ul>
        <button class="btn btn-primary new-purchase-btn" id="new-purchase-tab-btn" title="New Purchase">
            <i class="ri-add-line"></i>
        </button>
    </div>
</div>

<!-- Tab Content Container -->
<div id="purchase-tab-content-container" style="height: 85vh; margin-top: -7px;">
    <!-- Tab content will be dynamically added here -->
</div>



<script>
    // Tab Management System for Purchases
    let purchaseTabs = [];
    let currentTabId = null;
    let tabCounter = 0;
    let allProducts = [];

    // Initialize first tab on page load
    document.addEventListener('DOMContentLoaded', () => {
        createNewTab();

        // New Purchase button handler
        document.getElementById('new-purchase-tab-btn').addEventListener('click', () => {
            createNewTab();
        });

        // Initialize clock updates
        updateAllClocks();
        setInterval(updateAllClocks, 1000);
    });

    // Update all visible clocks
    function updateAllClocks() {
        const now = new Date();
        const timeString = now.toLocaleTimeString('en-US', { hour12: false });
        const dateString = now.toLocaleDateString('en-US', {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        });

        document.querySelectorAll('.digital-clock').forEach(clock => {
            const timeEl = clock.querySelector('.clock-time');
            const dateEl = clock.querySelector('.clock-date');
            if (timeEl) timeEl.textContent = timeString;
            if (dateEl) dateEl.textContent = dateString;
        });
    }

    function createNewTab() {
        tabCounter++;
        const tabId = `purchase-tab-${tabCounter}`;
        const tabData = {
            id: tabId,
            vendor: null,
            products: [],
            discountpercentage: 0,
            totalPayment: 0,
            ledger: false,
            previousEntry: null,
            selectedProduct: null
        };

        purchaseTabs.push(tabData);

        // Create tab button
        const tabButton = document.createElement('li');
        tabButton.className = 'nav-item';
        tabButton.innerHTML = `
            <a class="nav-link" id="${tabId}-btn" data-bs-toggle="tab" href="#${tabId}" role="tab" aria-selected="false">
                Purchase ${tabCounter}
                <button class="tab-close-btn" onclick="closeTab('${tabId}', event)">&times;</button>
            </a>
        `;
        document.getElementById('purchase-tabs').appendChild(tabButton);

        // Create tab content panel
        const tabContent = document.createElement('div');
        tabContent.className = 'tab-content-panel';
        tabContent.id = tabId;
        tabContent.innerHTML = getTabContentHTML(tabId);
        document.getElementById('purchase-tab-content-container').appendChild(tabContent);

        // Fetch next invoice number
        fetch('/accounting/purchase/next-invoice-num')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const display = document.getElementById(`invoice-num-display-${tabId}`);
                    if (display) display.innerText = data.nextNum;
                    tabData.invoicenum = data.nextNum;
                }
            });

        // Fetch expense accounts
        fetch('/accounting/purchase/expense-accounts')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const select = document.getElementById(`purchase-account-${tabId}`);
                    if (select) {
                        select.innerHTML = data.accounts.map(acc => `<option value="${acc.id}">${acc.code} - ${acc.name}</option>`).join('');
                        const defaultAcc = localStorage.getItem('default_purchase_account');
                        if(defaultAcc) select.value = defaultAcc;
                    }
                }
            });

        // Switch to new tab
        switchToTab(tabId);

        // Initialize Select2 for vendor dropdown in this tab
        setTimeout(() => {
            $(`#vendor-${tabId}`).select2({
                theme: 'bootstrap-5',
                dropdownParent: $(`#vendor-${tabId}`).parent(),
                ajax: {
                    url: '/accounting/purchase/search-vendors',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { search: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(vendor => ({
                                id: vendor.id,
                                text: `${vendor.firstname} ${vendor.lastname} (${vendor.phone || 'No phone'})`
                            }))
                        };
                    },
                    cache: true
                },
                minimumInputLength: 1,
                placeholder: 'Search vendor...',
                dropdownCssClass: 'select2-dropdown-custom',
            });

            // Store vendor selection
            $(`#vendor-${tabId}`).on('select2:select', function (e) {
                const tab = purchaseTabs.find(t => t.id === tabId);
                const vendorId = e.params.data.id;
                if (tab) tab.vendor = vendorId;

                // Fetch and show balance
                const balanceDisplay = document.getElementById(`vendor-balance-info-${tabId}`);
                if (balanceDisplay) {
                    balanceDisplay.innerHTML = '<i class="ri-loader-4-line rotate"></i> Loading...';
                    balanceDisplay.classList.remove('d-none');
                    
                    fetch(`/users/${vendorId}/balance`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                const balance = data.balance;
                                // For vendors, negative is credit (we owe them), positive is debit (they owe us - unlikely but possible)
                                const balanceClass = balance < 0 ? 'text-danger' : (balance > 0 ? 'text-success' : 'text-muted');
                                balanceDisplay.innerHTML = `Current Balance: <span class="${balanceClass} fw-bold">Rs.${Math.abs(balance).toFixed(2)} ${balance < 0 ? '(Payable)' : (balance > 0 ? '(Receivable)' : '')}</span>`;
                            }
                        })
                        .catch(err => {
                            balanceDisplay.innerHTML = '<span class="text-danger">Failed to load balance</span>';
                        });
                }
            });
        }, 100);
    }

    function getTabContentHTML(tabId) {
        return `
            <div class="row g-2 mt-0" style="height: 100%;">
                <!-- Left Column: Product Search (25%) -->
                <div class="col-lg-3">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column" style="height: 100%;">
                            <div class="mb-3 p-3 bg-light rounded border-primary border" style="border-width: 2px !important;">
                                <label class="form-label text-primary text-uppercase fw-bold mb-1" style="font-size: 13px;">Invoice Number</label>
                                <div class="h3 mb-0 text-dark fw-bold" id="invoice-num-display-${tabId}">Loading...</div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="purchase-account-${tabId}" class="form-label text-muted text-uppercase fw-semibold mb-0" style="font-size: 11px;">COGS Account (Manufacturing)</label>
                                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fs-11" onclick="setDefaultAccount('purchase_account', 'purchase-account-${tabId}')" title="Set selected account as default"><i class="ri-pushpin-line"></i> Set Default</button>
                                </div>
                                <select id="purchase-account-${tabId}" class="form-select form-select-sm border-primary">
                                    <option value="">Loading accounts...</option>
                                </select>
                            </div>

                            <div id="search-product-purchase-page-search-section-${tabId}" style="position: relative;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label for="product-search-${tabId}" class="form-label text-muted text-uppercase fw-semibold mb-0">Search Product</label>
                                    <div class="btn-group btn-group-sm search-mode-toggle-compact" role="group">
                                        <input type="radio" class="btn-check" name="search-mode-${tabId}" id="search-manual-${tabId}" autocomplete="off" checked>
                                        <label class="btn btn-outline-secondary" for="search-manual-${tabId}">Manual</label>
                                        
                                        <input type="radio" class="btn-check" name="search-mode-${tabId}" id="search-barcode-${tabId}" autocomplete="off">
                                        <label class="btn btn-outline-primary" for="search-barcode-${tabId}">Barcode</label>
                                    </div>
                                </div>
                                <input type="text" class="form-control mb-2" id="product-search-${tabId}" placeholder="Enter product name or barcode">
                                <div class="d-flex justify-content-between align-items-center mb-3 mt-1">
                                    <a href="/products" class="btn btn-soft-primary btn-sm px-2 py-0 fs-11 rounded-pill">
                                        <i class="ri-add-line align-bottom"></i> New Product
                                    </a>
                                </div>
                                <div id="search-results-${tabId}" class="shadow-lg rounded p-3 d-none" style="position: absolute; width: 100%; z-index: 9999;"></div>
                            </div>
                            
                            <!-- Spacer to push clock to bottom -->
                            <div class="flex-grow-1"></div>
                            
                            <!-- Digital Clock -->
                            <div class="digital-clock-container">
                                <div class="digital-clock" id="digital-clock-${tabId}">
                                    <span class="clock-time">00:00:00</span>
                                    <span class="clock-date">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Middle Column: Selected Products (50%) -->
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header align-items-center d-flex">
                            <h4 class="card-title mb-0 flex-grow-1">Selected Products</h4>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="height: calc(67vh);">
                                <table class="table table-striped table-nowrap align-middle mb-0">
                                    <thead class="table-light" style="position: sticky; top: 0;">
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Name</th>
                                            <th scope="col">Qty</th>
                                            <th scope="col">Price</th>
                                            <th scope="col">Total</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="selected-products-${tabId}"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Billing Information (25%) -->
                <div class="col-lg-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="mb-4 total-bill-section">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label text-muted text-uppercase fw-semibold mb-0">Total Bill</label>
                                    <h2 id="total-bill-amount-${tabId}" class="mb-0 glowing-bill">Rs.0.00</h2>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="transaction-date-${tabId}" class="form-label text-uppercase fw-bold text-primary" style="font-size: 11px;">Transaction Date & Time</label>
                                <input type="datetime-local" id="transaction-date-${tabId}" class="form-control form-control-sm border-primary" 
                                    value="${new Date(new Date().getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16)}">
                            </div>

                             <div class="mb-3">
                                <label for="vendor-${tabId}" class="form-label text-muted text-uppercase fw-semibold">Vendor</label>
                                <select id="vendor-${tabId}" class="form-select select2" data-placeholder="Select Vendor">
                                    <option value="">Select Vendor</option>
                                </select>
                                <div id="vendor-balance-info-${tabId}" class="mt-2 fs-12 d-none p-2 bg-light rounded border border-dashed"></div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label for="discountpercentage-${tabId}" class="form-label text-muted text-uppercase fw-semibold mb-0">Discount %</label>
                                    <input type="number" class="form-control form-control-sm inline-input" id="discountpercentage-${tabId}" value="0" style="width: 100px;">
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="total-payment-${tabId}" class="form-label text-muted text-uppercase fw-semibold mb-0">Payment</label>
                                    <input type="number" class="form-control form-control-sm inline-input" id="total-payment-${tabId}" style="width: 120px;">
                                </div>
                                <div class="form-check mt-2 ms-2">
                                    <input type="checkbox" class="form-check-input" id="ledger-${tabId}">
                                    <label class="form-check-label text-muted" for="ledger-${tabId}">Ledger Posting</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label text-muted text-uppercase fw-semibold mb-0">Change</label>
                                    <h4 id="change-${tabId}" class="mb-0 text-success">Rs.0.00</h4>
                                </div>
                            </div>

                            <!-- Complete Purchase Button -->
                            <button class="btn btn-primary w-100 mt-3" onclick="completePurchase('${tabId}')" style="padding: 0.75rem;">
                                <i class="ri-check-double-line me-2"></i>Complete Purchase
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    function switchToTab(tabId) {
        // Hide all tab panels
        document.querySelectorAll('.tab-content-panel').forEach(panel => {
            panel.classList.remove('active');
        });

        // Show selected tab panel
        const tabPanel = document.getElementById(tabId);
        if (tabPanel) {
            tabPanel.classList.add('active');
        }

        // Update nav tabs
        document.querySelectorAll('#purchase-tabs .nav-link').forEach(link => {
            link.classList.remove('active');
        });
        const tabBtn = document.getElementById(`${tabId}-btn`);
        if (tabBtn) {
            tabBtn.classList.add('active');
        }

        currentTabId = tabId;
        initializeTabEventListeners(tabId);
    }

    function closeTab(tabId, event) {
        event.stopPropagation();

        if (purchaseTabs.length <= 1) {
            toastr.warning('At least one purchase tab must remain open');
            return;
        }

        // Remove tab from array
        purchaseTabs = purchaseTabs.filter(t => t.id !== tabId);

        // Remove tab button
        const tabBtn = document.getElementById(`${tabId}-btn`).closest('li');
        if (tabBtn) tabBtn.remove();

        // Remove tab content
        const tabPanel = document.getElementById(tabId);
        if (tabPanel) tabPanel.remove();

        // Switch to first remaining tab
        if (purchaseTabs.length > 0) {
            switchToTab(purchaseTabs[0].id);
        }
    }

    function initializeTabEventListeners(tabId) {
        const productSearch = document.getElementById(`product-search-${tabId}`);
        const searchBarcode = document.getElementById(`search-barcode-${tabId}`);
        const totalPayment = document.getElementById(`total-payment-${tabId}`);
        const discountpercentage = document.getElementById(`discountpercentage-${tabId}`);
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);

        if (!productSearch || productSearch.dataset.listenersAttached) return;
        productSearch.dataset.listenersAttached = 'true';

        // Update placeholder based on radio button selection
        const searchManual = document.getElementById(`search-manual-${tabId}`);
        function updatePlaceholder() {
            if (searchBarcode.checked) {
                productSearch.placeholder = 'Scan or enter product barcode';
            } else {
                productSearch.placeholder = 'Enter product name';
            }
        }
        updatePlaceholder();
        searchBarcode.addEventListener('change', updatePlaceholder);
        searchManual.addEventListener('change', updatePlaceholder);

        // Product search handlers
        productSearch.addEventListener('keydown', async (event) => {
            const searchResults = document.getElementById(`search-results-${tabId}`);
            const tab = purchaseTabs.find(t => t.id === tabId);

            const isEnterKey = event.key === 'Enter' || event.keyCode === 13;
            const isCtrlM = event.ctrlKey && (event.key === 'm' || event.key === 'M');

            if (isCtrlM) {
                event.preventDefault();
                event.stopPropagation();
                if (searchBarcode.checked) {
                    const barcode = productSearch.value.trim();
                    productSearch.value = '';
                    if (barcode) {
                        await searchProductByBarcode(barcode, tabId);
                    }
                    productSearch.focus();
                }
                return;
            }

            // Handle arrow key navigation for manual mode
            if (!searchBarcode.checked && !searchResults.classList.contains('d-none')) {
                const items = searchResults.querySelectorAll('.search-result-product');
                if (items.length > 0) {
                    let currentIndex = -1;
                    items.forEach((item, index) => {
                        if (item.classList.contains('selected')) {
                            currentIndex = index;
                        }
                    });

                    if (event.key === 'ArrowDown') {
                        event.preventDefault();
                        items.forEach(item => item.classList.remove('selected'));
                        const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
                        items[nextIndex].classList.add('selected');
                        items[nextIndex].scrollIntoView({ block: 'nearest' });
                        const productId = items[nextIndex].id.split('-')[1];
                        tab.selectedProduct = productId;
                        return;
                    }

                    if (event.key === 'ArrowUp') {
                        event.preventDefault();
                        items.forEach(item => item.classList.remove('selected'));
                        const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
                        items[prevIndex].classList.add('selected');
                        items[prevIndex].scrollIntoView({ block: 'nearest' });
                        const productId = items[prevIndex].id.split('-')[1];
                        tab.selectedProduct = productId;
                        return;
                    }
                }
            }

            if (isEnterKey) {
                event.preventDefault();
                event.stopPropagation();

                if (searchBarcode.checked) {
                    const barcode = productSearch.value.trim();
                    productSearch.value = '';

                    if (barcode) {
                        await searchProductByBarcode(barcode, tabId);
                    }
                    productSearch.focus();
                    return;
                } else {
                    // Manual mode - add selected product from dropdown
                    const selectedItem = searchResults.querySelector('.search-result-product.selected');
                    if (selectedItem) {
                        const productId = selectedItem.id.split('-')[1];
                        const product = filteredProds.find(p => p.id == productId);
                        if (product) {
                            selectThisProduct(product, tabId, productSearch, searchResults, tab);
                        }
                    } else if (tab.previousEntry) {
                        addProduct(tab.previousEntry, tabId);
                        productSearch.value = '';
                        setTimeout(() => productSearch.focus(), 100);
                    }

                    tab.selectedProduct = null;
                }
            }
        });

        productSearch.addEventListener('input', async () => {
            if (searchBarcode.checked) return;
            const query = productSearch.value;
            
            // Fetch products (all if query is empty)
            const products = await getProducts(query.length > 0 ? { name: query } : {});
            
            if (products.length === 0) {
                document.getElementById(`search-results-${tabId}`).classList.add('d-none');
                return;
            }
            setAllProducts(products);
            const searchResults = document.getElementById(`search-results-${tabId}`);
            searchResults.classList.remove('d-none');
            searchResults.innerHTML = '';

            const tab = purchaseTabs.find(t => t.id === tabId);
            let filteredProds = products.filter(product => product.name.toLowerCase().includes(query.toLowerCase()));

            filteredProds.forEach((product, index) => {
                const productElement = document.createElement('div');
                productElement.classList.add('search-result-product', 'p-2', 'd-flex', 'justify-content-between', 'align-items-center');

                // Auto-select first item
                if (index === 0) {
                    productElement.classList.add('selected');
                    tab.selectedProduct = product.id;
                }

                productElement.id = `product-${product.id}-${tabId}`;
                productElement.style.cursor = 'pointer';
                productElement.innerHTML = `
                    <div>
                        <div class="product-name-cell" title="${product.name}">${product.name}</div>
                        <small class="d-block text-muted">Stock: ${product.quantity}</small>
                    </div>
                    <span>Rs. ${parseFloat(product.purchaseprice || product.saleprice || 0).toFixed(2)}</span>
                `;
                productElement.addEventListener('mouseenter', () => {
                    searchResults.querySelectorAll('.search-result-product').forEach(el => el.classList.remove('selected'));
                    productElement.classList.add('selected');
                    tab.selectedProduct = product.id;
                });

                productElement.addEventListener('mousedown', (e) => {
                    e.preventDefault(); // Prevent focus loss from input
                    selectThisProduct(product, tabId, productSearch, searchResults, tab);
                });
                
                searchResults.appendChild(productElement);
            });
        });

        function selectThisProduct(product, tabId, productSearch, searchResults, tab) {
            productSearch.value = '';
            searchResults.classList.add('d-none');
            tab.selectedProduct = null;
            addProduct(product, tabId);
        }

        // Show all products on focus in Manual mode
        productSearch.addEventListener('focus', async () => {
            if (!searchBarcode.checked && productSearch.value.length === 0) {
                productSearch.dispatchEvent(new Event('input'));
            }
        });

        // Payment input handler
        totalPayment.addEventListener('input', () => {
            UpdateChangePrice(tabId);
        });

        // Discount percentage handler
        discountpercentage.addEventListener('input', () => {
            updateTotalBill(tabId);
        });



        // Click outside to close search results
        document.addEventListener('click', (event) => {
            if (!event.target.closest(`#search-product-purchase-page-search-section-${tabId}`)) {
                document.getElementById(`search-results-${tabId}`).classList.add('d-none');
            }
        });
    }

    // Tab button click handlers
    document.addEventListener('click', (event) => {
        if (event.target.closest('.nav-link') && event.target.closest('.nav-link').id) {
            const tabBtn = event.target.closest('.nav-link');
            const tabId = tabBtn.id.replace('-btn', '');
            if (purchaseTabs.find(t => t.id === tabId)) {
                switchToTab(tabId);
            }
        }
    });

    // Product management functions
    function removeProduct(productId, tabId) {
        const row = document.getElementById(`product-row-${productId}-${tabId}`);
        if (row) {
            row.remove();
            updateTotalBill(tabId);
            updateSerialNumbers(tabId);
        }
    }

    function addProduct(product, tabId) {
        const tab = purchaseTabs.find(t => t.id === tabId);
        if (!tab) return;

        tab.previousEntry = product;
        
        // Use purchase price if available, otherwise use sale price
        let productPrice = product.purchaseprice || product.saleprice || 0;
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);

        const existingRow = document.getElementById(`product-row-${product.id}-${tabId}`);
        if (existingRow) {
            const quantityInput = existingRow.querySelector('.product-quantity input');
            if (quantityInput) {
                quantityInput.value = parseInt(quantityInput.value) + 1;
                manualQuantityUpdate(quantityInput, product.id, tabId);
                setTimeout(() => {
                    quantityInput.focus();
                    quantityInput.select();
                }, 50);
            }
            return;
        }

        let newQuantity = 1;
        const currentIndex = selectedProductsTable.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');
        row.id = `product-row-${product.id}-${tabId}`;
        row.innerHTML = `
            <td class="product-serial">${currentIndex}</td>
            <td class="product-name">
                <div class="product-name-cell" title="${product.name}">
                    ${product.name}
                    <small class="d-block text-muted">Stock: ${product.quantity}</small>
                </div>
            </td>
            <td class="product-quantity">
                <div class="d-flex align-items-center justify-content-center gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary p-0" style="width: 20px; height: 20px; line-height: 1;" onclick="changeQuantityInline('${product.id}', '${tabId}', -1)">-</button>
                    <input type="number" class="form-control form-control-sm text-center px-1 editable-input" value="${newQuantity}" style="width: 60px; height: 24px; font-size: 12px;" 
                        oninput="manualQuantityUpdate(this, '${product.id}', '${tabId}')"
                        onkeydown="quantityKeyHandler(event, this, '${product.id}', '${tabId}')"
                        onfocus="this.select()">
                    <button type="button" class="btn btn-sm btn-outline-secondary p-0" style="width: 20px; height: 20px; line-height: 1;" onclick="changeQuantityInline('${product.id}', '${tabId}', 1)">+</button>
                </div>
            </td>
            <td class="product-price">
                <input type="number" class="form-control form-control-sm text-center px-1 editable-input" value="${productPrice}" style="width: 80px; height: 24px; font-size: 12px;" 
                    oninput="manualPriceUpdate(this, '${product.id}', '${tabId}')"
                    onfocus="this.select()">
            </td>
            <td class="product-total">${newQuantity * productPrice}</td>
            <td class="product-action">
                <button class="btn btn-danger btn-sm" onclick="removeProduct('${product.id}', '${tabId}')">
                    <i class="bx bx-trash"></i>
                </button>
            </td>
        `;
        selectedProductsTable.appendChild(row);
        updateTotalBill(tabId);
        
        // Focus the new quantity input
        setTimeout(() => {
            const qInput = row.querySelector('.product-quantity input');
            if (qInput) {
                qInput.focus();
                qInput.select();
            }
        }, 50);
    }

    function updateTotalBill(tabId) {
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        if (!selectedProductsTable) return;

        let total = 0;
        let rows = selectedProductsTable.querySelectorAll('tr');
        let discountpercentage = parseFloat(document.getElementById(`discountpercentage-${tabId}`).value || 0);
        rows.forEach(row => {
            const price = parseFloat(row.querySelector('.product-total').textContent);
            total += price;
        });
        total = total - (total * discountpercentage / 100);
        const totalBillAmount = document.getElementById(`total-bill-amount-${tabId}`);
        if (totalBillAmount) {
            totalBillAmount.textContent = `Rs. ${parseFloat(total).toFixed(2)}`;
        }
        UpdateChangePrice(tabId);
    }

    function updateSerialNumbers(tabId) {
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        if (!selectedProductsTable) return;
        const rows = selectedProductsTable.querySelectorAll('tr');
        rows.forEach((row, index) => {
            row.querySelector('.product-serial').textContent = index + 1;
        });
    }

    function UpdateChangePrice(tabId) {
        const totalBillAmount = document.getElementById(`total-bill-amount-${tabId}`);
        const totalPayment = document.getElementById(`total-payment-${tabId}`);
        const changeEl = document.getElementById(`change-${tabId}`);
        if (!totalBillAmount || !totalPayment || !changeEl) return;

        const totalBill = parseFloat(totalBillAmount.textContent.split(' ')[1]);
        const totalPrice = parseFloat(totalPayment.value) || 0;
        const change = totalPrice - totalBill;
        if (change < 0 || isNaN(change)) {
            changeEl.textContent = 'Rs. 0.00';
            return;
        }
        changeEl.textContent = `Rs. ${change.toFixed(2)}`;
    }

    function UpdateProductQuantity(event, input, quantityElement, price, totalElement, tabId) {
        if (event.key === 'Enter') {
            return applyQuantityUpdate(input, quantityElement, price, totalElement, tabId);
        }
    }

    function applyQuantityUpdate(input, quantityElement, price, totalElement, tabId) {
        const row = input.closest('tr');
        const productId = row.id.replace(`product-row-`, '').replace(`-${tabId}`, '');
        const product = allProducts.find(p => p.id == productId);
        const newQuantity = parseInt(input.value) || 0;

        if (newQuantity <= 0) {
            input.style.borderBottomColor = 'red';
            toastr.warning('Quantity should be greater than 0');
            return false;
        }

        input.value = newQuantity;
        totalElement.textContent = Math.round(newQuantity * price);
        updateTotalBill(tabId);
        return true;
    }

    function changeQuantityInline(productId, tabId, delta) {
        const row = document.getElementById(`product-row-${productId}-${tabId}`);
        if (!row) return;
        const input = row.querySelector('.product-quantity input');
        let val = parseInt(input.value) || 0;
        val += delta;
        if (val < 1) val = 1;
        input.value = val;
        manualQuantityUpdate(input, productId, tabId);
    }

    function manualPriceUpdate(input, productId, tabId) {
        const row = document.getElementById(`product-row-${productId}-${tabId}`);
        if (!row) return;
        const totalElement = row.querySelector('.product-total');
        const quantityInput = row.querySelector('.product-quantity input');
        const price = parseFloat(input.value) || 0;
        const quantity = parseInt(quantityInput.value) || 0;
        
        totalElement.textContent = Math.round(quantity * price);
        updateTotalBill(tabId);
    }

    function manualQuantityUpdate(input, productId, tabId) {
        const row = document.getElementById(`product-row-${productId}-${tabId}`);
        if (!row) return;
        const totalElement = row.querySelector('.product-total');
        const priceInput = row.querySelector('.product-price .editable-input');
        const quantity = parseInt(input.value) || 0;
        const price = parseFloat(priceInput.value) || 0;
        
        totalElement.textContent = Math.round(quantity * price);
        updateTotalBill(tabId);
    }

    function quantityKeyHandler(event, input, productId, tabId) {
        if (event.key === 'ArrowUp') {
            event.preventDefault();
            changeQuantityInline(productId, tabId, 1);
        } else if (event.key === 'ArrowDown') {
            event.preventDefault();
            changeQuantityInline(productId, tabId, -1);
        } else if (event.key === 'Enter') {
            event.preventDefault();
            // Just stay in the input or move to next if needed, 
            // but don't jump back to search automatically on every Enter
            input.blur(); 
        }
    }



    async function getProducts(body) {
        const response = await fetch('/accounting/purchase/productsget', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const products = await response.json();
        setAllProducts(products);
        return products;
    }

    async function searchProductByBarcode(barcode, tabId) {
        const tab = purchaseTabs.find(t => t.id === tabId);
        const productSearchInput = document.getElementById(`product-search-${tabId}`);

        if (window.electron) {
            window.electron.send('lock-window-focus');
        }

        if (!barcode) {
            return tab.previousEntry ? addProduct(tab.previousEntry, tabId) : null;
        }

        try {
            const products = await getProducts({ barcode });
            if (products.length > 0) {
                addProduct(products[0], tabId);
            } else {
                toastr.warning('No product found for barcode: ' + barcode);
            }
        } catch (error) {
            toastr.error('Error searching product');
            console.error('Barcode search error:', error);
        }

        productSearchInput.focus();
    }

    function setAllProducts(product) {
        if (Array.isArray(product)) {
            product.forEach(p => {
                if (!allProducts.find(ap => ap.id === p.id) && p.quantity > 0) {
                    allProducts.push(p);
                }
            });
        } else {
            if (!allProducts.find(p => p.id === product.id) && product.quantity > 0) {
                allProducts.push(product);
            }
        }
    }

    function postSaveInput(input) {
        input.style.borderBottom = '1px solid transparent';
        input.setAttribute('readonly', 'readonly');
        input.style.pointerEvents = 'none';
        input.onblur = null;
        input.onkeyup = null;
    }

    function createEditableInput(onSave, value, target, inputtype, onUpdate = null) {
        const input = target.querySelector('.editable-input') || document.createElement('input');
        let prevInputType = input.getAttribute('type');
        if (prevInputType !== inputtype) {
            input.setAttribute('type', inputtype);
        }
        input.classList.add('editable-input');
        input.style.borderBottom = '1px solid #000';
        input.style.pointerEvents = 'all';
        input.removeAttribute('readonly');
        
        input.onkeydown = (event) => {
            if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
                event.preventDefault();
                let val = parseInt(input.value) || 0;
                if (event.key === 'ArrowUp') val++;
                else if (event.key === 'ArrowDown' && val > 1) val--;
                input.value = val;
                if (onUpdate) onUpdate(input);
            } else if (event.key === 'Enter') {
                event.preventDefault();
                let success = onSave(event, input);
                if (success !== false) {
                    postSaveInput(input);
                }
            }
        };

        input.onkeyup = null;
        input.onblur = () => {
            let success = onSave({ key: 'Enter' }, input);
            if (success !== false) {
                postSaveInput(input);
            }
        };
        setTimeout(() => {
            input.focus();
            input.select();
        }, 50);
    }

    function completePurchase(tabId) {
        const tab = purchaseTabs.find(t => t.id === tabId);
        if (!tab) return;

        const vendor = document.getElementById(`vendor-${tabId}`).value || null;
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        const discountpercentage = parseFloat(document.getElementById(`discountpercentage-${tabId}`).value);
        const ledger = document.getElementById(`ledger-${tabId}`).checked;
        const transactionDate = document.getElementById(`transaction-date-${tabId}`).value;
        const totalPaymentVal = parseFloat(document.getElementById(`total-payment-${tabId}`).value) || 0;
        const purchaseAccountId = document.getElementById(`purchase-account-${tabId}`).value;

        const products = [];
        selectedProductsTable.querySelectorAll('tr').forEach(row => {
            const productId = row.id.split('-')[2];
            const qInput = row.querySelector('.product-quantity .editable-input');
            const pInput = row.querySelector('.product-price .editable-input');
            const quantity = parseInt(qInput.value) || 0;
            const price = parseFloat(pInput.value) || 0;
            products.push({ productId, quantity, price });
        });

        if (products.length === 0) {
            toastr.warning('Please select products');
            return;
        }

        const priceWithoutDiscount = products.reduce((acc, product) => acc + (product.quantity * product.price), 0);
        const totalPrice = priceWithoutDiscount;

        if (discountpercentage < 0 || discountpercentage > 100) {
            toastr.warning('Please enter valid discount percentage');
            return;
        }

        const priceWithDiscount = priceWithoutDiscount - (priceWithoutDiscount * discountpercentage / 100);
        if (totalPaymentVal < priceWithDiscount && !ledger) {
            toastr.warning('Please check the ledger option or pay the full amount');
            return;
        }
        
        // Show confirmation modal
        $.confirm({
            title: '<i class="ri-information-line me-2 text-primary"></i>Confirm Transaction Accounts',
            theme: 'material',
            closeIcon: true,
            boxWidth: '400px',
            useBootstrap: false,
            content: `
                <div class="p-2">
                    <p class="text-muted mb-3" style="font-size: 13px;">Please verify the accounts for this transaction before proceeding.</p>
                    
                    <div class="mb-3">
                        <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 11px;">COGS Account (Manufacturing)</label>
                        <select id="modal-purchase-account" class="form-select form-select-sm border-primary">
                            ${document.getElementById(`purchase-account-${tabId}`).innerHTML}
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-uppercase fw-bold text-muted" style="font-size: 11px;">Vendor / Party</label>
                        <select id="modal-vendor" class="form-select form-select-sm border-primary">
                            ${document.getElementById(`vendor-${tabId}`).innerHTML}
                        </select>
                    </div>
                </div>
            `,
            onContentReady: function () {
                // Set initial values from the main form
                const modalAcc = this.$content.find('#modal-purchase-account');
                const modalVen = this.$content.find('#modal-vendor');
                
                modalAcc.val(purchaseAccountId);
                modalVen.val(vendor);
                
                // If vendor was empty, it might need to stay empty unless user chooses one
            },
            buttons: {
                confirm: {
                    text: 'Finish Purchase',
                    btnClass: 'btn-primary',
                    action: function () {
                        const finalPurchaseAccountId = this.$content.find('#modal-purchase-account').val();
                        const finalVendor = this.$content.find('#modal-vendor').val();

                        if (totalPaymentVal < priceWithDiscount && !finalVendor) {
                            toastr.warning('Please select a vendor for ledger posting');
                            return false;
                        }

                        fetch('/accounting/purchase/save', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                vendor: finalVendor, 
                                discountpercentage, 
                                totalPrice, 
                                ledger, 
                                products, 
                                totalPayment: totalPaymentVal, 
                                transactionDate, 
                                purchaseAccountId: finalPurchaseAccountId 
                            }),
                        }).then(async response => {
                            let data = await response.json();
                            if (response.ok) {
                                $.alert({
                                    title: 'Success!',
                                    content: data.message,
                                    theme: 'material',
                                    useBootstrap: false,
                                    boxWidth: '30%',
                                    type: 'green',
                                    buttons: {
                                        confirm: {
                                            text: 'Ok',
                                            btnClass: 'btn-success',
                                            action: function () {
                                                window.location.href = '/accounting/purchase/view/' + data.purchaseId;
                                            }
                                        }
                                    }
                                });
                            } else {
                                $.alert({
                                    title: 'Error!',
                                    content: data.message,
                                    theme: 'material',
                                    useBootstrap: false,
                                    boxWidth: '30%',
                                    type: 'red',
                                    buttons: {
                                        confirm: {
                                            text: 'Ok',
                                            btnClass: 'btn-danger',
                                        }
                                    }
                                });
                            }
                        });
                    }
                },
                cancel: {
                    text: 'Back',
                    btnClass: 'btn-light'
                }
            }
        });
    }

    // Make functions globally accessible
    window.removeProduct = removeProduct;
    window.completePurchase = completePurchase;
    window.closeTab = closeTab;
    window.createNewTab = createNewTab;
</script>
