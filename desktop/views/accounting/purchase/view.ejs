<!doctype html>
<html data-layout="horizontal" data-topbar="light" data-sidebar="light" data-sidebar-size="sm-hover"
    data-sidebar-image="none" data-preloader="disable">

<head>
    <meta charset="utf-8" />
    <title>StitchCore</title>
    <link rel="icon" href="/assets/img/icon.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/assets/css/vendor/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/vendor/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/vendor/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/toastr.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/jquery-confirm.min.css" rel="stylesheet" type="text/css" />
    <script src="/assets/js/vendor/jquery.min.js"></script>
    <script src="/assets/js/jquery-confirm.min.js"></script>
    <script src="/assets/js/vendor/select2.min.js"></script>
    <script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
    <link href="/assets/css/pos-theme.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/pos-pages.css" rel="stylesheet" type="text/css" />
    <style>
        @media print {
            .no-print { display: none !important; }
        }
    </style>
</head>

<body>

    <div class="row mx-auto cstm-row mt-3 px-4">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0">Invoice Details</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/accounting/purchase">Purchase</a></li>
                        <li class="breadcrumb-item active">Invoice Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="row px-4 pb-4">
        <div class="col-lg-12">
            <div class="card" id="demo">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card-header border-bottom-dashed px-4">
                            <img src="/assets/img/icon.png" class="card-logo mx-auto mb-3 d-block" alt="logo" height="50">
                            <div class="d-flex justify-content-between">
                                <div class="flex-grow-1">
                                    <div class="mt-1">
                                        <h6 class="text-uppercase fw-bold">Company Details</h6>
                                        <p class="mb-1">
                                            <%= companySettings.name %>
                                        </p>
                                        <p class="mb-0">
                                            <%= companySettings.address %>
                                        </p>
                                        <p class="mb-0">Contact: <%= companySettings.phone %>
                                        </p>
                                    </div>
                                </div>
                                <% if(purchase.Vendor) { %>
                                    <div class="flex-shrink-0">
                                        <h6 class="text-uppercase fw-bold mt-1">Vendor Details</h6>
                                        <p class="mb-2">
                                            <%= purchase.Vendor.firstname %>
                                                <%= purchase.Vendor.lastname %>
                                        </p>
                                        <p class="mb-1">
                                            <%= purchase.Vendor.address %>
                                        </p>
                                        <p class="mb-1">Phone: <%= purchase.Vendor.phone %>
                                        </p>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

                        <div class="card-body pt-4 pb-0 px-4">
                            <div class="row g-3">
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase fw-bold">
                                        Invoice No
                                    </p>
                                    <h5 class="fs-14 mb-0">
                                        <%= purchase.invoicenum %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase fw-bold">
                                        Date
                                    </p>
                                    <h5 class="fs-14 mb-0 format-date">
                                        <%= purchase.createdAt %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase fw-bold">
                                        Total Amount
                                    </p>
                                    <h5 class="fs-14 mb-0">
                                        Rs.<%= purchase.totalAmount %>
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <div class="card-body py-4 px-3 fs-6">
                            <div class="table-responsive">
                                <table class="table table-borderless text-center table-nowrap align-middle mb-0">
                                    <thead>
                                        <tr class="table-active">
                                            <th scope="col" style="width: 50px;">#</th>
                                            <th scope="col">Product</th>
                                            <th scope="col">Rate</th>
                                            <th scope="col">Qty</th>
                                            <th scope="col" class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% purchase.PurchasedItems.forEach((product, index)=> { %>
                                            <tr>
                                                <th scope="row">
                                                    <%= index + 1 %>
                                                </th>
                                                <td class="text-center"
                                                    style="max-width: 8mm; overflow-wrap: break-word; white-space: unset;">
                                                    <span class="fw-medium">
                                                        <%= product.Product.name %>
                                                    </span>
                                                </td>
                                                <td class="code">
                                                    <span>
                                                        Rs.<%= product.price %>
                                                    </span>
                                                </td>
                                                <td class="code">
                                                    <%= product.quantity %>
                                                </td>
                                                <td class="text-end code">Rs.<%= (product.quantity * product.price
                                                        || 0).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="border-top border-top-dashed mt-2 fs-7">
                                <table class="table table-borderless table-nowrap align-middle mb-0 ms-auto footer-table" style="width: auto; min-width: 280px;">
                                    <tbody>
                                        <tr>
                                            <td class="p-1 text-end">Sub Total</td>
                                            <td class="text-end code p-1">Rs.<%= purchase.totalAmount %></td>
                                        </tr>
                                        <% if(parseFloat(purchase.balance)) { %>
                                            <tr>
                                                <td class="fw-bold p-1 text-end">Paid</td>
                                                <td class="text-end code p-1">Rs.<%= parseFloat(purchase.totalPayment || 0).toFixed(2) %></td>
                                            </tr>
                                        <% } %>
                                        <tr class="border-top border-top-dashed fs-15">
                                            <th scope="row" class="p-1 text-end">Total</th>
                                            <th class="text-end code p-1">Rs.<%= purchase.totalAmount %></th>
                                        </tr>
                                        <% if(parseFloat(purchase.balance)) { %>
                                            <tr>
                                                <th class="p-1 text-end">Balance</th>
                                                <th class="text-end code p-1">Rs.<%= purchase.balance %></th>
                                            </tr>
                                        <% } %>
                                        <% if (typeof vendorBalance !== 'undefined' && vendorBalance !== null) { %>
                                            <tr id="print-balance-row" class="d-none border-top border-top-dashed">
                                                <th class="p-1 text-end">Current Balance</th>
                                                <th class="text-end code p-1">Rs.<%= vendorBalance.toLocaleString(undefined, { minimumFractionDigits: 2 }) %></th>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                                <p class="text-end border-top pt-2">
                                    <small class="text-muted">
                                        Powered by <strong>Corelogix</strong>
                                    </small>
                                </p>

                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 no-print">
                                <div>
                                    <% if (typeof vendorBalance !== 'undefined' && vendorBalance !== null) { %>
                                    <div class="form-check form-switch form-switch-success form-switch-md">
                                        <input class="form-check-input" type="checkbox" role="switch" id="showBalanceToggle">
                                        <label class="form-check-label fs-13" for="showBalanceToggle">Show Current Balance on Print</label>
                                    </div>
                                    <% } %>
                                </div>
                                <div class="d-flex gap-2">
                                    <button onclick="window.history.back()" class="btn btn-light">Back</button>
                                    <button onclick="window.print()" class="btn btn-success">
                                        <i class="ri-printer-line align-bottom me-1"></i> Print
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
<script src="/assets/js/vendor/moment.min.js"></script>
<script>
    $(document).ready(function () {
        setTimeout(() => {
            $('.format-date').each(function () {
                var date = $(this).text().trim();
                $(this).text(moment(new Date(date)).format('MMMM Do YYYY'));
            });
        });

        $('#showBalanceToggle').on('change', function() {
            if ($(this).is(':checked')) {
                $('#print-balance-row').removeClass('d-none');
            } else {
                $('#print-balance-row').addClass('d-none');
            }
        });
    });
</script>

</html>