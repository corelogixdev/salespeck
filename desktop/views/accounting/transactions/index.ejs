<%- contentFor('body') %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0"><%= title %></h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/accounting/coa">Accounting</a></li>
                    <li class="breadcrumb-item active"><%= title %></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Journal Entries</h5>
                <a href="/accounting/transactions/form" class="btn btn-primary btn-sm">
                    <i class="ri-add-line align-bottom me-1"></i> New Entry
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Source</th>
                                <th>Description / Reference</th>
                                <th>Ledger Lines (Account | Debit | Credit)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (journals && journals.length > 0) { %>
                                <% journals.forEach(function(journal) { %>
                                    <tr>
                                        <td><%= new Date(journal.date).toLocaleDateString() %></td>
                                        <td><span class="badge bg-primary-subtle text-primary text-uppercase"><%= journal.source %></span></td>
                                        <td>
                                            <strong><%= journal.description || 'No Description' %></strong>
                                            <% if (journal.reference) { %><br><small class="text-muted">Ref: <%= journal.reference %></small><% } %>
                                        </td>
                                        <td>
                                            <table class="table table-sm table-borderless mb-0">
                                                <% journal.ledger_entries.forEach(function(entry) { %>
                                                <tr>
                                                    <td style="width: 50%"><%= entry.account?.name || 'Unknown Account' %></td>
                                                    <td style="width: 25%" class="text-end text-success"><%= parseFloat(entry.debit) > 0 ? parseFloat(entry.debit).toLocaleString(undefined, {minimumFractionDigits: 2}) : '' %></td>
                                                    <td style="width: 25%" class="text-end text-danger"><%= parseFloat(entry.credit) > 0 ? parseFloat(entry.credit).toLocaleString(undefined, {minimumFractionDigits: 2}) : '' %></td>
                                                </tr>
                                                <% }); %>
                                            </table>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center">No transactions recorded.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
