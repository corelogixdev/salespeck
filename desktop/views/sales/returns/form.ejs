<%- contentFor('body') %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0"><%= title %></h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/sales">Sales</a></li>
                    <li class="breadcrumb-item active">Returns</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Return against original invoice</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="saleSearch">Find sale</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="ri-search-line"></i></span>
                        <input type="text" class="form-control" id="saleSearch" placeholder="Invoice number, customer name, or sale ID..." autocomplete="off">
                        <button type="button" class="btn btn-soft-primary" id="saleSearchBtn">Search</button>
                    </div>
                    <div class="form-text">Search by SAL-/SRV- invoice, customer, or ID.</div>
                </div>

                <div id="lookupResults" class="list-group mb-3 d-none"></div>

                <div id="salePanel" class="d-none">
                    <div class="border rounded p-3 mb-3" style="border-color: var(--pos-border) !important; background: var(--pos-bg-surface);">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <div>
                                <div class="text-muted text-uppercase fs-11 mb-1">Original invoice</div>
                                <div class="fw-semibold fs-15" id="saleInvoice">—</div>
                            </div>
                            <div>
                                <div class="text-muted text-uppercase fs-11 mb-1">Customer</div>
                                <div class="fw-semibold" id="saleCustomer">—</div>
                            </div>
                            <div>
                                <div class="text-muted text-uppercase fs-11 mb-1">Discount</div>
                                <div class="fw-semibold" id="saleDiscount">0%</div>
                            </div>
                            <div>
                                <div class="text-muted text-uppercase fs-11 mb-1">Date</div>
                                <div class="fw-semibold" id="saleDate">—</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-nowrap align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-center">Sold</th>
                                    <th class="text-center">Returned</th>
                                    <th class="text-center" style="min-width: 140px;">Return qty</th>
                                    <th class="text-end">Line total</th>
                                </tr>
                            </thead>
                            <tbody id="returnLinesBody">
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label d-block">Refund mode</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="refundMode" id="refundCash" value="cash" checked>
                                <label class="form-check-label" for="refundCash">Cash refund</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="refundMode" id="refundCredit" value="credit">
                                <label class="form-check-label" for="refundCredit">Customer credit</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="returnNote">Note (optional)</label>
                            <input type="text" class="form-control" id="returnNote" maxlength="255" placeholder="Reason or remark">
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3">
                        <div>
                            <span class="text-muted">Return total</span>
                            <div class="fs-4 fw-bold" id="returnTotal">Rs. 0.00</div>
                            <div class="form-text mb-0" id="ledgerHint"></div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-light" id="clearSaleBtn">Clear</button>
                            <button type="button" class="btn btn-primary" id="saveReturnBtn">
                                <i class="ri-save-line align-bottom me-1"></i> Save return
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const initialSaleId = <%- JSON.stringify(saleId || "") %>;
    let currentSale = null;

    const $search = document.getElementById('saleSearch');
    const $results = document.getElementById('lookupResults');
    const $panel = document.getElementById('salePanel');
    const $tbody = document.getElementById('returnLinesBody');
    const $total = document.getElementById('returnTotal');
    const $ledgerHint = document.getElementById('ledgerHint');

    function formatMoney(n) {
        return 'Rs. ' + (Number(n) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function customerLabel(sale) {
        if (!sale.Customer) return 'Walk-in';
        const name = ((sale.Customer.firstname || '') + ' ' + (sale.Customer.lastname || '')).trim();
        return name || sale.Customer.phone || 'Customer';
    }

    function calcTotals() {
        if (!currentSale) {
            $total.textContent = formatMoney(0);
            return 0;
        }
        let gross = 0;
        $tbody.querySelectorAll('tr[data-line-id]').forEach((row) => {
            const qty = Number(row.querySelector('.return-qty')?.value || 0);
            const price = Number(row.dataset.price || 0);
            const lineEl = row.querySelector('.line-total');
            const line = qty * price;
            if (lineEl) lineEl.textContent = formatMoney(line);
            gross += line;
        });
        const discount = parseFloat(currentSale.discountpercentage) || 0;
        const net = gross - (gross * discount / 100);
        $total.textContent = formatMoney(net);
        return net;
    }

    function renderLines(sale) {
        $tbody.innerHTML = '';
        (sale.lines || []).forEach((line) => {
            const name = line.Product?.name || 'Unknown';
            const max = Number(line.returnableQty || 0);
            const disabled = max <= 0;
            const tr = document.createElement('tr');
            tr.dataset.lineId = line.id;
            tr.dataset.price = String(line.price || 0);
            tr.innerHTML = `
                <td>
                    <div class="fw-medium">${escapeHtml(name)}</div>
                    ${line.isService ? '<span class="badge bg-secondary-subtle text-secondary">Service</span>' : ''}
                    ${disabled ? '<span class="badge bg-warning-subtle text-warning ms-1">Fully returned</span>' : ''}
                </td>
                <td class="text-end">${formatMoney(line.price)}</td>
                <td class="text-center">${line.quantity}</td>
                <td class="text-center">${line.alreadyReturned || 0}</td>
                <td class="text-center">
                    <div class="input-group input-group-sm justify-content-center" style="max-width: 130px; margin: 0 auto;">
                        <button type="button" class="btn btn-soft-secondary qty-dec" ${disabled ? 'disabled' : ''}>-</button>
                        <input type="number" class="form-control text-center return-qty" min="0" max="${max}" value="0" ${disabled ? 'disabled' : ''}>
                        <button type="button" class="btn btn-soft-secondary qty-inc" ${disabled ? 'disabled' : ''}>+</button>
                    </div>
                    <div class="fs-11 text-muted mt-1">Max ${max}</div>
                </td>
                <td class="text-end line-total">${formatMoney(0)}</td>
            `;
            $tbody.appendChild(tr);
        });

        $tbody.querySelectorAll('.qty-inc').forEach((btn) => {
            btn.addEventListener('click', () => {
                const input = btn.closest('tr').querySelector('.return-qty');
                const max = Number(input.max || 0);
                input.value = Math.min(max, Number(input.value || 0) + 1);
                calcTotals();
            });
        });
        $tbody.querySelectorAll('.qty-dec').forEach((btn) => {
            btn.addEventListener('click', () => {
                const input = btn.closest('tr').querySelector('.return-qty');
                input.value = Math.max(0, Number(input.value || 0) - 1);
                calcTotals();
            });
        });
        $tbody.querySelectorAll('.return-qty').forEach((input) => {
            input.addEventListener('change', () => {
                const max = Number(input.max || 0);
                let v = Number(input.value || 0);
                if (!Number.isFinite(v) || v < 0) v = 0;
                if (v > max) v = max;
                input.value = v;
                calcTotals();
            });
        });
        calcTotals();
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function showSale(sale) {
        currentSale = sale;
        $results.classList.add('d-none');
        $results.innerHTML = '';
        $panel.classList.remove('d-none');
        document.getElementById('saleInvoice').textContent = sale.invoicenum || sale.id;
        document.getElementById('saleCustomer').textContent = customerLabel(sale);
        document.getElementById('saleDiscount').textContent = (parseFloat(sale.discountpercentage) || 0) + '%';
        document.getElementById('saleDate').textContent = sale.createdAt
            ? new Date(sale.createdAt).toLocaleString()
            : '—';
        $ledgerHint.textContent = sale.hasLedger
            ? 'Original sale has ledger entries — return will post reversing journals.'
            : 'No ledger on original sale — stock will still restore for products.';
        renderLines(sale);
    }

    function clearSale() {
        currentSale = null;
        $panel.classList.add('d-none');
        $tbody.innerHTML = '';
        $total.textContent = formatMoney(0);
        $search.value = '';
        $results.classList.add('d-none');
        $results.innerHTML = '';
    }

    async function lookup() {
        const q = $search.value.trim();
        if (!q) return;
        $results.classList.remove('d-none');
        $results.innerHTML = '<div class="list-group-item text-muted">Searching…</div>';
        try {
            const res = await fetch('/sales/returns/lookup?q=' + encodeURIComponent(q));
            const data = await res.json();
            if (!data.success) throw new Error(data.message || 'Lookup failed');
            if (!data.sales.length) {
                $results.innerHTML = '<div class="list-group-item text-muted">No matching sales</div>';
                return;
            }
            $results.innerHTML = data.sales.map((s) => `
                <button type="button" class="list-group-item list-group-item-action" data-sale-id="${escapeHtml(s.id)}">
                    <div class="d-flex justify-content-between">
                        <strong>${escapeHtml(s.invoicenum || s.id)}</strong>
                        <span>${formatMoney(s.totalprice)}</span>
                    </div>
                    <div class="fs-12 text-muted">${escapeHtml(s.customerName)} · ${s.createdAt ? new Date(s.createdAt).toLocaleDateString() : ''}</div>
                </button>
            `).join('');
            $results.querySelectorAll('[data-sale-id]').forEach((btn) => {
                btn.addEventListener('click', () => loadSale(btn.getAttribute('data-sale-id')));
            });
        } catch (err) {
            $results.innerHTML = `<div class="list-group-item text-danger">${escapeHtml(err.message)}</div>`;
        }
    }

    async function loadSale(id) {
        try {
            const res = await fetch('/sales/returns/sale/' + encodeURIComponent(id));
            const data = await res.json();
            if (!data.success || !data.sale) throw new Error(data.message || 'Sale not found');
            showSale(data.sale);
        } catch (err) {
            if (typeof toastr !== 'undefined') toastr.error(err.message);
            else alert(err.message);
        }
    }

    async function saveReturn() {
        if (!currentSale) return;
        const items = [];
        $tbody.querySelectorAll('tr[data-line-id]').forEach((row) => {
            const qty = Number(row.querySelector('.return-qty')?.value || 0);
            if (qty > 0) {
                items.push({ soldproduct: row.dataset.lineId, quantity: qty });
            }
        });
        if (!items.length) {
            if (typeof toastr !== 'undefined') toastr.warning('Select at least one return quantity');
            else alert('Select at least one return quantity');
            return;
        }
        const refundMode = document.querySelector('input[name="refundMode"]:checked')?.value || 'cash';
        const note = document.getElementById('returnNote').value.trim();
        const btn = document.getElementById('saveReturnBtn');
        btn.disabled = true;
        try {
            const res = await fetch('/sales/returns/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    saleId: currentSale.id,
                    items,
                    refundMode,
                    note,
                    ledger: !!currentSale.hasLedger
                })
            });
            const data = await res.json();
            if (data.status !== 'success') throw new Error(data.message || 'Save failed');
            if (typeof toastr !== 'undefined') toastr.success(data.message || 'Return saved');
            window.location.href = '/sales/returns/' + data.returnId;
        } catch (err) {
            if (typeof toastr !== 'undefined') toastr.error(err.message);
            else alert(err.message);
            btn.disabled = false;
        }
    }

    document.getElementById('saleSearchBtn').addEventListener('click', lookup);
    $search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            lookup();
        }
    });
    document.getElementById('clearSaleBtn').addEventListener('click', clearSale);
    document.getElementById('saveReturnBtn').addEventListener('click', saveReturn);

    if (initialSaleId) {
        loadSale(initialSaleId);
    }
})();
</script>
