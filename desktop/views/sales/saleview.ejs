<!doctype html>
<html data-layout="horizontal" data-topbar="light" data-sidebar="light" data-sidebar-size="sm-hover"
    data-sidebar-image="none" data-preloader="disable">

<head>
    <meta charset="utf-8" />
    <title>OpenMenu</title>
    <link rel="icon" href="/assets/img/icon.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/assets/css/vendor/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/vendor/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/vendor/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/toastr.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/jquery-confirm.min.css" rel="stylesheet" type="text/css" />
    <script src="/assets/js/vendor/jquery.min.js"></script>
    <script src="/assets/js/jquery-confirm.min.js"></script>
    <script src="/assets/js/vendor/select2.min.js"></script>
    <script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
    <link rel="stylesheet" href="/assets//css/select2.min.css">
</head>

<body>

    <div class="row mx-auto cstm-row mt-3" style="width: 500px;">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0">Invoice Details</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/sales">Sales</a></li>
                        <li class="breadcrumb-item active">Invoice Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mx-auto cstm-row" style="width: 500px;">
        <div class="col-lg-12">
            <div class="card" id="demo">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card-header border-bottom-dashed px-4">
                            <!-- Logo - Centered -->
                            <div class="text-center mb-3">
                                <img src="/assets/img/icon.png" class="card-logo" alt="logo" height="50">
                            </div>

                            <!-- Company Details - Centered -->
                            <div class="text-center mb-3">
                                <h6 class="text-uppercase fw-semibold">Company Details</h6>
                                <p class="mb-1">
                                    <%= companySettings.name %>
                                </p>
                                <p class="mb-0">
                                    <%= companySettings.address %>
                                </p>
                                <p class="mb-0">Contact: <%= companySettings.phone %>
                                </p>
                            </div>

                            <!-- Customer Details - Right aligned if exists -->
                            <% if(sale.Customer) { %>
                                <div class="text-end">
                                    <h6 class="text-uppercase fw-semibold mt-1">Customer Details</h6>
                                    <p class="mb-2">
                                        <%= sale.Customer.firstname %>
                                            <%= sale.Customer.lastname %>
                                    </p>
                                    <p class="mb-1">
                                        <%= sale.Customer.address %>
                                    </p>
                                    <p class="mb-1">Phone: <%= sale.Customer.phone %>
                                    </p>
                                </div>
                                <% } %>
                        </div>

                        <div class="card-body pt-4 pb-0 px-4">
                            <div class="row g-3">
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Invoice No
                                    </p>
                                    <h5 class="fs-14 mb-0">
                                        <%= sale.invoicenum %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Date
                                    </p>
                                    <h5 class="fs-14 mb-0 format-date-only">
                                        <%= sale.createdAt %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Time
                                    </p>
                                    <h5 class="fs-14 mb-0 format-time-only">
                                        <%= sale.createdAt %>
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <div class="card-body py-4 px-3 fs-6">
                            <div class="table-responsive overflow-hidden">
                                <table class="table table-borderless text-center table-nowrap align-middle mb-0">
                                    <thead>
                                        <tr class="table-active">
                                            <th scope="col" style="width: 50px;">#</th>
                                            <th scope="col">Product</th>
                                            <th scope="col">Rate</th>
                                            <th scope="col">Qty</th>
                                            <th scope="col" class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% sale.SoldPoducts.forEach((product, index)=> { %>
                                            <tr>
                                                <th scope="row">
                                                    <%= index + 1 %>
                                                </th>
                                                <td class="text-center">
                                                    <span class="fw-medium">
                                                        <%= product.Product.name %>
                                                    </span>
                                                </td>
                                                <td class="code">
                                                    <%= formatNumber(product.price) %>
                                                </td>
                                                <td class="code">
                                                    <%= product.quantity %>
                                                </td>
                                                <td class="text-end code">
                                                    <%= (product.quantity * product.price).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="border-top border-top-dashed mt-2 fs-7">
                                <table
                                    class="table table-borderless table-nowrap align-middle mb-0 ms-auto footer-table">
                                    <tbody>
                                        <tr>
                                            <td class="p-1">Sub Total</td>
                                            <td class="text-end code p-1">Rs.<%= formatNumber(sale.totalprice) %>
                                            </td>
                                        </tr>
                                        <% if(sale.discountpercentage) { %>
                                            <tr>
                                                <td class="p-1">Discount (<%= sale.discountpercentage %>%)</td>
                                                <td class="text-end code p-1"> Rs. -<%= (sale.totalprice *
                                                        sale.discountpercentage / 100).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% if(parseFloat(sale.balance)) { %>
                                                    <tr>
                                                        <td class="fw-bold p-1">Paid</td>
                                                        <td class="text-end code p-1">Rs.<%=
                                                                parseFloat(sale.totalpayment).toFixed(2) %>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                                        <tr class="border-top border-top-dashed fs-15">
                                                            <th scope="row" class="p-1"
                                                                style="border: 2px solid black;">Total</th>
                                                            <th class="text-end code p-1"
                                                                style="border: 2px solid black;">Rs.<%= (sale.totalprice
                                                                    - (sale.totalprice * sale.discountpercentage /
                                                                    100)).toFixed(2) %>
                                                            </th>
                                                        </tr>
                                                        <% if(parseFloat(sale.balance)) { %>
                                                            <tr>
                                                                <th class="p-1">
                                                                    <%= parseFloat(sale.balance) < 0 ? 'Balance'
                                                                        : 'Change' %>
                                                                </th>
                                                                <th class="text-end code p-1">Rs.<%=
                                                                        Math.abs(sale.balance).toFixed(2) %>
                                                                </th>
                                                            </tr>
                                                            <% } %>
                                    </tbody>
                                </table>
                                <p class="text-center border-top pt-2">
                                    Powered by <strong>Corelogix</strong> | 03024759550
                                </p>

                            </div>

                            <div class="hstack gap-2 justify-content-end d-print-none mt-4">
                                <button onclick="printReceipt()" class="btn btn-success">
                                    <i class="ri-printer-line align-bottom me-1"></i> Print
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        @media print {
            @page {
                margin: 5mm !important;
            }

            body {
                visibility: hidden;
                margin: 0 !important;
                padding: 0 !important;
            }

            #demo,
            #demo * {
                visibility: visible;
                font-family: Arial, Helvetica, sans-serif !important;
                color: black !important;
            }

            #demo {
                width: 100%;
                max-width: 100%;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
            }

            .card {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
            }

            .card-header,
            .card-body {
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .d-print-none {
                display: none !important;
            }

            .cstm-row {
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            /* Container adjustments */
            .row,
            .col-12,
            .col-lg-12 {
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            /* Table adjustments */
            .table-responsive {
                overflow: visible !important;
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .table:not(.footer-table) {
                font-size: 8pt !important;
                width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
                table-layout: fixed !important;
                border-collapse: collapse !important;
            }

            .table:not(.footer-table) th,
            .table:not(.footer-table) td {
                padding: 1pt 1pt !important;
                white-space: normal !important;
                word-break: break-word;
                font-size: 7pt !important;
                border: 1pt solid #000 !important;
            }

            /* Table header with thicker border */
            .table:not(.footer-table) thead tr {
                border-bottom: 1.5pt solid #000 !important;
            }

            .table:not(.footer-table) th:first-child {
                width: 8% !important;
            }

            .table:not(.footer-table) th:nth-child(2) {
                width: 35% !important;
            }

            .table:not(.footer-table) th:nth-child(3) {
                width: 18% !important;
            }

            .table:not(.footer-table) th:nth-child(4) {
                width: 12% !important;
            }

            .table:not(.footer-table) th:last-child {
                width: 27% !important;
                text-align: right !important;
                padding-right: 2pt !important;
            }

            /* Footer table specific styles */
            .footer-table {
                width: auto !important;
                min-width: 45% !important;
                max-width: 65% !important;
                margin-left: auto !important;
                margin-right: 0 !important;
                font-size: 7pt !important;
                table-layout: auto !important;
            }

            .footer-table td,
            .footer-table th {
                white-space: nowrap !important;
                padding: 1pt 2pt !important;
            }

            .footer-table td:first-child,
            .footer-table th:first-child {
                text-align: left !important;
                padding-right: 8pt !important;
            }

            .footer-table td:last-child,
            .footer-table th:last-child {
                text-align: right !important;
                padding-left: 3pt !important;
            }

            /* Font size adjustments */
            .fs-14,
            .fs-7,
            .fs-6,
            .fs-15 {
                font-size: 8pt !important;
            }

            p,
            .mb-0,
            .mb-1,
            .mb-2 {
                font-size: 8pt;
                margin-bottom: 1pt !important;
            }

            h4 {
                font-size: 10pt;
                margin: 2pt 0 !important;
            }

            h5,
            h6 {
                font-size: 9pt;
                margin: 1pt 0 !important;
            }

            /* Image sizing and centering */
            .card-logo {
                height: 30pt !important;
                margin-bottom: 2pt !important;
                display: block !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }

            /* Aggressively remove all borders for print */
            .border-top,
            .border-bottom-dashed,
            .border-top-dashed,
            .footer-table,
            .footer-table td,
            .footer-table th,
            .footer-table tr,
            .border-bottom,
            .border-start,
            .border-end {
                border: none !important;
                border-top: none !important;
                border-bottom: none !important;
            }

            /* Force borders on Total row */
            .footer-table th[style*="border"] {
                border: 2px solid black !important;
            }
        }

        .code {
            /* font-family: monospace !important; */
            color: black !important;
        }
    </style>
</body>
<script src="/assets/js/vendor/moment.min.js"></script>
<script>
    // Printer configuration from settings
    const printerConfig = <%- JSON.stringify(typeof printerConfig !== 'undefined' ? printerConfig : { silentPrinting: false, numberOfPrints: 1 }) %>;
    
    function printReceipt() {
        const numberOfPrints = parseInt(printerConfig.numberOfPrints || 1);
        const silentPrinting = printerConfig.silentPrinting === true || printerConfig.silentPrinting === 'true';
        
        // Function to trigger print
        function doPrint() {
            if (silentPrinting) {
                // Silent printing - use iframe to avoid print dialog
                const iframe = document.createElement('iframe');
                iframe.style.position = 'fixed';
                iframe.style.right = '0';
                iframe.style.bottom = '0';
                iframe.style.width = '0';
                iframe.style.height = '0';
                iframe.style.border = '0';
                
                document.body.appendChild(iframe);
                
                const printContent = document.getElementById('demo').innerHTML;
                const printWindow = iframe.contentWindow;
                
                printWindow.document.open();
                // Get all styles from the current document
                let styles = '';
                Array.from(document.querySelectorAll('style')).forEach(styleEl => {
                    styles += styleEl.innerHTML + '\n';
                });
                
                printWindow.document.write(`
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <title>Print Receipt</title>
                        <style>
                            ${styles}
                        </style>
                    </head>
                    <body>
                        ${printContent}
                    </body>
                    </html>
                `);
                printWindow.document.close();
                
                // Wait for content to load, then print
                printWindow.onload = function() {
                    setTimeout(() => {
                        printWindow.focus();
                        printWindow.print();
                        
                        // Remove iframe after printing
                        setTimeout(() => {
                            if (document.body.contains(iframe)) {
                                document.body.removeChild(iframe);
                            }
                        }, 1000);
                    }, 100);
                };
                
                // Fallback if onload doesn't fire
                setTimeout(() => {
                    if (iframe.parentNode) {
                        printWindow.focus();
                        printWindow.print();
                        setTimeout(() => {
                            if (document.body.contains(iframe)) {
                                document.body.removeChild(iframe);
                            }
                        }, 1000);
                    }
                }, 500);
            } else {
                // Normal printing with dialog
                window.print();
            }
        }
        
        // Print multiple times if needed
        if (numberOfPrints > 1) {
            let printCount = 0;
            const printInterval = setInterval(() => {
                doPrint();
                printCount++;
                if (printCount >= numberOfPrints) {
                    clearInterval(printInterval);
                }
            }, silentPrinting ? 1500 : 500); // Longer delay for silent printing
        } else {
            doPrint();
        }
    }
    
    $(document).ready(function () {
        setTimeout(() => {
            // Format date only
            $('.format-date-only').each(function () {
                var date = $(this).text().trim();
                $(this).text(moment(new Date(date)).format('DD-M-YYYY'));
            });

            // Format time only
            $('.format-time-only').each(function () {
                var date = $(this).text().trim();
                $(this).text(moment(new Date(date)).format('HH:mm'));
            });
        });
    });
</script>

</html>