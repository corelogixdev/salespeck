<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Inventory Report</title>
  <style>
    @page { size: A4 landscape; margin: 15mm; }
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 20px;
      color: #1f2937;
      font-size: 12px;
      line-height: 1.5;
    }
    .report-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 3px solid #667eea;
      padding-bottom: 15px;
      margin-bottom: 20px;
    }
    .report-header .brand h1 {
      margin: 0 0 5px;
      font-size: 22px;
      color: #4b5563;
    }
    .report-header .brand p {
      margin: 0;
      color: #6b7280;
      font-size: 11px;
    }
    .report-header .meta {
      text-align: right;
    }
    .report-header .meta .doc-title {
      font-size: 18px;
      font-weight: 700;
      color: #667eea;
      margin-bottom: 4px;
    }
    .report-header .meta .doc-date {
      color: #6b7280;
      font-size: 11px;
    }
    .filters {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px 15px;
      margin-bottom: 20px;
    }
    .filters strong {
      color: #475569;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
    .filters .filter-items {
      margin-top: 8px;
      display: flex;
      gap: 30px;
    }
    .filters .filter-item {
      font-size: 11px;
      color: #334155;
    }
    .summary {
      display: flex;
      gap: 15px;
      margin-bottom: 20px;
    }
    .summary .card {
      flex: 1;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px;
      text-align: center;
    }
    .summary .card .label {
      font-size: 10px;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin-bottom: 4px;
    }
    .summary .card .value {
      font-size: 16px;
      font-weight: 700;
      color: #1e293b;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    th, td {
      border: 1px solid #e2e8f0;
      padding: 8px 10px;
      text-align: left;
    }
    th {
      background: #f1f5f9;
      font-weight: 600;
      color: #475569;
      font-size: 11px;
      text-transform: uppercase;
    }
    tr:nth-child(even) { background: #f8fafc; }
    .text-end { text-align: right; }
    .low-stock { background: #fef3c7 !important; }
    tfoot td {
      background: #f1f5f9;
      font-weight: 700;
      color: #334155;
    }
    .footer-note {
      margin-top: 25px;
      padding-top: 10px;
      border-top: 1px solid #e2e8f0;
      font-size: 10px;
      color: #94a3b8;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>
  <div class="report-header">
    <div class="brand">
      <h1>Corelogix</h1>
      <p>StitchCore Business Reports</p>
    </div>
    <div class="meta">
      <div class="doc-title">Inventory Report</div>
      <div class="doc-date">Generated: <%= moment(reportData.generatedAt).format('YYYY-MM-DD HH:mm:ss') %></div>
    </div>
  </div>

  <div class="filters">
    <strong>Applied Filters</strong>
    <div class="filter-items">
      <div class="filter-item"><span>Category:</span> <%= reportData.filters.category || 'All' %></div>
      <div class="filter-item"><span>Brand:</span> <%= reportData.filters.brand || 'All' %></div>
      <div class="filter-item"><span>Low Stock Only:</span> <%= reportData.filters.lowStock === 'true' ? 'Yes' : 'No' %></div>
    </div>
  </div>

  <div class="summary">
    <div class="card">
      <div class="label">Total Products</div>
      <div class="value"><%= reportData.totals.totalProducts %></div>
    </div>
    <div class="card">
      <div class="label">Total Stock Value</div>
      <div class="value"><%= parseFloat(reportData.totals.totalValue || 0).toFixed(2) %></div>
    </div>
    <div class="card">
      <div class="label">Low Stock Items</div>
      <div class="value"><%= reportData.totals.lowStockItems %></div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Product Name</th>
        <th>Barcode</th>
        <th>Category</th>
        <th>Brand</th>
        <th class="text-end">Quantity</th>
        <th class="text-end">Purchase Price</th>
        <th class="text-end">Sale Price</th>
        <th class="text-end">Stock Value</th>
      </tr>
    </thead>
    <tbody>
      <% reportData.products.forEach(product => { %>
        <tr class="<%= parseFloat(product.quantity || 0) <= 10 ? 'low-stock' : '' %>">
          <td><%= product.name || 'N/A' %></td>
          <td><%= product.barcode || 'N/A' %></td>
          <td><%= product.Category ? product.Category.name : 'N/A' %></td>
          <td><%= product.Brand ? product.Brand.name : 'N/A' %></td>
          <td class="text-end"><%= parseFloat(product.quantity || 0).toFixed(2) %></td>
          <td class="text-end"><%= parseFloat(product.purchaseprice || 0).toFixed(2) %></td>
          <td class="text-end"><%= parseFloat(product.saleprice || 0).toFixed(2) %></td>
          <td class="text-end"><%= (parseFloat(product.quantity || 0) * parseFloat(product.purchaseprice || 0)).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="7">TOTAL VALUE</td>
        <td class="text-end"><%= parseFloat(reportData.totals.totalValue || 0).toFixed(2) %></td>
      </tr>
    </tfoot>
  </table>

  <div class="footer-note">
    <span>This is a computer generated report.</span>
    <span>Page 1 of 1</span>
  </div>
</body>
</html>
