<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header">
        <h4 class="card-title mb-0">Reports</h4>
      </div>
      <div class="card-body">
        <div class="row">
          <!-- Sales Report Card -->
          <div class="col-xl-3 col-md-6">
            <div class="card card-animate border border-primary">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-shrink-0 me-3">
                    <div class="avatar-sm">
                      <div class="avatar-title bg-primary-subtle text-primary rounded fs-18">
                        <i class="ri-shopping-cart-line"></i>
                      </div>
                    </div>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Sales Report</h6>
                    <p class="text-muted mb-0">View sales transactions</p>
                  </div>
                </div>
                <div class="mt-3">
                  <a href="/reports/sales" class="btn btn-primary btn-sm w-100">
                    <i class="ri-file-list-3-line me-1"></i> View Report
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Purchases Report Card -->
          <div class="col-xl-3 col-md-6">
            <div class="card card-animate border border-info">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-shrink-0 me-3">
                    <div class="avatar-sm">
                      <div class="avatar-title bg-info-subtle text-info rounded fs-18">
                        <i class="ri-shopping-bag-line"></i>
                      </div>
                    </div>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Purchases Report</h6>
                    <p class="text-muted mb-0">View purchase transactions</p>
                  </div>
                </div>
                <div class="mt-3">
                  <a href="/reports/purchases" class="btn btn-info btn-sm w-100">
                    <i class="ri-file-list-3-line me-1"></i> View Report
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Inventory Report Card -->
          <div class="col-xl-3 col-md-6">
            <div class="card card-animate border border-success">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-shrink-0 me-3">
                    <div class="avatar-sm">
                      <div class="avatar-title bg-success-subtle text-success rounded fs-18">
                        <i class="ri-stack-line"></i>
                      </div>
                    </div>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Inventory Report</h6>
                    <p class="text-muted mb-0">View product inventory</p>
                  </div>
                </div>
                <div class="mt-3">
                  <a href="/reports/inventory" class="btn btn-success btn-sm w-100">
                    <i class="ri-file-list-3-line me-1"></i> View Report
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Customer Report Card -->
          <div class="col-xl-3 col-md-6">
            <div class="card card-animate border border-warning">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-shrink-0 me-3">
                    <div class="avatar-sm">
                      <div class="avatar-title bg-warning-subtle text-warning rounded fs-18">
                        <i class="ri-user-line"></i>
                      </div>
                    </div>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="mb-1">Customer Report</h6>
                    <p class="text-muted mb-0">View customer analytics</p>
                  </div>
                </div>
                <div class="mt-3">
                  <a href="/reports/customers" class="btn btn-warning btn-sm w-100">
                    <i class="ri-file-list-3-line me-1"></i> View Report
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
