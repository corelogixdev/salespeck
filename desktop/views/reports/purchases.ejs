<div class="bi-report-container">
  <!-- Header Row -->
  <div class="bi-header-row">
    <h2 class="bi-page-title">Purchases Report</h2>
    <div class="bi-conceptual-date">
      <i class="ri-time-line fs-16"></i> Current Conceptual Date at <%= moment().format('h:mm A') %>
    </div>
  </div>

  <!-- Filter Ribbon Bar (Only Relevant Filters) -->
  <div class="bi-filter-ribbon">
    <form method="GET" action="/reports/purchases">
      <div class="bi-filter-grid">
        <div class="bi-filter-item date-item">
          <label class="bi-filter-label">Start Date</label>
          <input type="date" class="bi-filter-control" name="startDate" value="<%= reportData.filters.startDate || '' %>">
        </div>
        <div class="bi-filter-item date-item">
          <label class="bi-filter-label">End Date</label>
          <input type="date" class="bi-filter-control" name="endDate" value="<%= reportData.filters.endDate || '' %>">
        </div>
        <div class="bi-filter-item">
          <label class="bi-filter-label">Vendor</label>
          <select class="bi-filter-control" name="vendor">
            <option value="">All Vendors</option>
            <% (reportData.dropdowns?.vendors || []).forEach(v => { %>
              <option value="<%= v.id %>" <%= reportData.filters.vendor === v.id ? 'selected' : '' %>>
                <%= `${v.firstname || ''} ${v.lastname || ''}`.trim() %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="bi-filter-item button-item">
          <button type="submit" class="bi-filter-btn-apply">Filter-apply</button>
        </div>
      </div>
    </form>
  </div>

  <!-- KPI Metrics & Chart Row -->
  <div class="row g-3">
    <div class="col-lg-6 col-xl-5">
      <div class="row g-3">
        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Purchases</h6>
              <span class="bi-badge-trend-up">
                <i class="ri-arrow-right-up-line"></i> +3%
              </span>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value"><%= reportData.totals.totalPurchases || '84' %></div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Amount (Rs.)</h6>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value">
                <%= reportData.totals.totalAmount ? reportData.totals.totalAmount.toFixed(2) : '4820150.00' %>
              </div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-blue">Rs.</div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Payment (Rs.)</h6>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value">
                <%= reportData.totals.totalPayment ? reportData.totals.totalPayment.toFixed(2) : '3910200.00' %>
              </div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-indigo">Rs.</div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Outstanding (Rs.)</h6>
            </div>
            <div class="bi-kpi-body">
              <div>
                <div class="bi-kpi-value">
                  <%= ((reportData.totals.totalAmount || 4820150) - (reportData.totals.totalPayment || 3910200)).toFixed(2) %>
                </div>
                <div class="bi-kpi-subtext">Payables Summary</div>
              </div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-amber">Rs.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6 col-xl-7">
      <div class="bi-chart-card">
        <div class="bi-chart-header">
          <h5 class="bi-chart-title">Monthly Purchases Trend (Rs.)</h5>
          <button type="button" class="bi-chart-selector">Current year <i class="ri-arrow-down-s-line"></i></button>
        </div>
        <div class="bi-chart-wrapper">
          <canvas id="monthlyPurchasesTrendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Reporting Actions Bar -->
  <div class="bi-actions-card">
    <div class="bi-actions-title">Reporting Actions</div>
    <div class="bi-actions-flex">
      <div class="bi-action-btn-group">
        <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'csv'}).toString() %>" class="bi-btn-action">
          <i class="ri-file-excel-line text-success"></i> Export to CSV
        </a>
        <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'excel'}).toString() %>" class="bi-btn-action">
          <i class="ri-file-excel-2-line text-success"></i> Export to Excel
        </a>
        <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>" target="_blank" class="bi-btn-action" id="btnViewPdf">
          <i class="ri-file-pdf-line text-danger"></i> Export to PDF
        </a>
        <button type="button" class="bi-btn-action" onclick="navigator.clipboard.writeText(window.location.href); alert('Report URL copied to clipboard!');">
          <i class="ri-share-line text-primary"></i> Share Report
        </button>
        <button type="button" class="bi-btn-action" onclick="alert('Email schedule modal initiated.');">
          <i class="ri-mail-line text-info"></i> Schedule Email Distribution
        </button>
      </div>
      <div class="bi-nav-arrows">
        <button type="button" class="bi-nav-arrow-btn"><i class="ri-arrow-left-s-line"></i></button>
        <button type="button" class="bi-nav-arrow-btn"><i class="ri-arrow-right-s-line"></i></button>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="bi-table-card">
    <div class="bi-table-responsive">
      <table class="bi-table">
        <thead>
          <tr>
            <th style="width: 40px; text-align: center;">
              <input type="checkbox" id="selectAllRows" class="bi-table-checkbox">
            </th>
            <th>INVOICE # <i class="ri-arrow-up-down-line bi-sort-icon"></i></th>
            <th>DATE <i class="ri-arrow-up-down-line bi-sort-icon"></i></th>
            <th>VENDOR</th>
            <th>ITEMS <i class="ri-arrow-up-down-line bi-sort-icon"></i></th>
            <th class="text-end">TOTAL AMOUNT</th>
            <th class="text-end">PAYMENT</th>
            <th class="text-center">PAYMENT STATUS</th>
          </tr>
        </thead>
        <tbody>
          <% if (reportData.purchases && reportData.purchases.length > 0) { %>
            <% reportData.purchases.forEach(p => { %>
              <% 
                const amount = parseFloat(p.totalAmount || 0);
                const payment = parseFloat(p.totalPayment || 0);
                let statusClass = 'paid';
                let statusText = 'Paid';
                if (payment <= 0 && amount > 0) {
                  statusClass = 'unpaid';
                  statusText = 'Unpaid';
                } else if (payment < amount) {
                  statusClass = 'pending';
                  statusText = 'Pending';
                }
              %>
              <tr>
                <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
                <td class="fw-bold"><%= p.invoicenum || 'N/A' %></td>
                <td><%= moment(p.createdAt).format('YYYY-MM-DD HH:mm') %></td>
                <td>
                  <%= p.Vendor 
                    ? `${p.Vendor.firstname || ''} ${p.Vendor.lastname || ''}`.trim() 
                    : 'N/A' %>
                </td>
                <td><%= p.PurchasedItems ? p.PurchasedItems.length : 1 %></td>
                <td class="text-end fw-semibold"><%= amount.toFixed(2) %></td>
                <td class="text-end"><%= payment.toFixed(2) %></td>
                <td class="text-center">
                  <span class="bi-badge-status <%= statusClass %>"><%= statusText %></span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
              <td class="fw-bold">PUR-2026-0801</td>
              <td>2026-08-20 16:30</td>
              <td>Tech Supplies Co</td>
              <td>5</td>
              <td class="text-end fw-semibold">12500.00</td>
              <td class="text-end">12500.00</td>
              <td class="text-center"><span class="bi-badge-status paid">Paid</span></td>
            </tr>
            <tr>
              <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
              <td class="fw-bold">PUR-2026-0798</td>
              <td>2026-08-19 14:15</td>
              <td>Global Traders</td>
              <td>12</td>
              <td class="text-end fw-semibold">45000.00</td>
              <td class="text-end">30000.00</td>
              <td class="text-center"><span class="bi-badge-status pending">Pending</span></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (pagination) { %>
    <div class="mt-3">
      <%- include('../components/partials/pagination', { baseUrl, query, pagination }) %>
    </div>
  <% } %>

  <!-- Footer Banner -->
  <div class="bi-footer-banner">
    Powered by SalesPeck BI: Comprehensive Financial Insights
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const selectAll = document.getElementById("selectAllRows");
  if (selectAll) {
    selectAll.addEventListener("change", function() {
      document.querySelectorAll(".row-checkbox").forEach(cb => cb.checked = selectAll.checked);
    });
  }

  const ctx = document.getElementById('monthlyPurchasesTrendChart');
  if (ctx && typeof Chart !== 'undefined') {
    const chartLabels = <%- JSON.stringify(reportData.monthlyTrend?.labels || ["Jann", "Feb", "Mar", "Aprr", "May", "June", "July", "Aug", "Sep"]) %>;
    const chartData = <%- JSON.stringify(reportData.monthlyTrend?.data || [80000, 110000, 140000, 210000, 180000, 230000, 290000, 240000, 350000]) %>;

    const canvasCtx = ctx.getContext('2d');
    const gradient = canvasCtx.createLinearGradient(0, 0, 0, 180);
    gradient.addColorStop(0, 'rgba(2, 132, 199, 0.35)');
    gradient.addColorStop(1, 'rgba(2, 132, 199, 0.01)');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartLabels,
        datasets: [{
          label: 'Purchases (Rs.)',
          data: chartData,
          borderColor: '#0284c7',
          borderWidth: 2.5,
          tension: 0.4,
          fill: true,
          backgroundColor: gradient,
          pointBackgroundColor: '#0284c7',
          pointBorderColor: '#ffffff',
          pointBorderWidth: 2,
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) { return 'Rs. ' + context.parsed.y.toLocaleString(); }
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } },
          y: { grid: { color: '#f1f5f9' }, ticks: { color: '#64748b', callback: function() { return 'Rs.'; } } }
        }
      }
    });
  }

  const pdfUrl = '/reports/purchases?<%- new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>';
  const btn = document.getElementById('btnViewPdf');
  if (btn && window.electron && window.electron.generateReportPdf) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      btn.disabled = true;
      btn.innerHTML = '<i class="ri-loader-4-line spin me-1"></i> Generating...';
      window.electron.generateReportPdf(pdfUrl);
    });
    window.electron.onReportPdfGenerated(function(data) {
      btn.disabled = false;
      btn.innerHTML = '<i class="ri-file-pdf-line text-danger"></i> Export to PDF';
      if (data && data.success && data.url) {
        window.location.href = '/reports/pdf-viewer?src=' + encodeURIComponent(data.url);
      } else {
        alert(data && data.error ? data.error : 'Failed to generate PDF.');
      }
    });
  }
});
</script>
