<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">Purchases Report</h4>
        <div class="d-flex gap-2">
          <button id="btnViewPdf" class="btn btn-soft-info btn-sm" <%= reportData.generated ? '' : 'disabled' %>>
            <i class="ri-file-pdf-line"></i> View PDF
          </button>
        </div>
      </div>
      <div class="card-body">
        <!-- Filters -->
        <form method="GET" action="/reports/purchases" class="row g-3 mb-4">
          <input type="hidden" name="generate" value="1">
          <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" name="startDate" value="<%= reportData.filters.startDate || '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" name="endDate" value="<%= reportData.filters.endDate || '' %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">Vendor</label>
            <input type="text" class="form-control" name="vendor" value="<%= reportData.filters.vendor || '' %>" placeholder="Vendor ID">
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              <i class="ri-bar-chart-line me-1"></i> Generate Report
            </button>
          </div>
        </form>

        <% if (reportData.generated) { %>
          <!-- Summary Cards -->
          <div class="row mb-4">
            <div class="col-md-4">
              <div class="card border border-primary">
                <div class="card-body">
                  <h6 class="text-muted mb-2">Total Purchases</h6>
                  <h4 class="mb-0"><%= reportData.totals.totalPurchases %></h4>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border border-success">
                <div class="card-body">
                  <h6 class="text-muted mb-2">Total Amount</h6>
                  <h4 class="mb-0"><%= formatNumber(reportData.totals.totalAmount) %></h4>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border border-info">
                <div class="card-body">
                  <h6 class="text-muted mb-2">Total Payment</h6>
                  <h4 class="mb-0"><%= formatNumber(reportData.totals.totalPayment) %></h4>
                </div>
              </div>
            </div>
          </div>

          <!-- Export Buttons -->
          <div class="d-flex gap-2 mb-3">
            <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'csv'}).toString() %>" class="btn btn-success btn-sm">
              <i class="ri-file-excel-line me-1"></i> Export CSV
            </a>
            <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'excel'}).toString() %>" class="btn btn-success btn-sm">
              <i class="ri-file-excel-2-line me-1"></i> Export Excel
            </a>
            <a href="/reports/purchases?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>" target="_blank" class="btn btn-danger btn-sm">
              <i class="ri-file-pdf-line me-1"></i> Export PDF
            </a>
          </div>

          <!-- Report Table -->
          <div class="table-responsive">
            <table class="table table-bordered table-striped">
              <thead>
                <tr>
                  <th>Invoice #</th>
                  <th>Date</th>
                  <th>Vendor</th>
                  <th>Items</th>
                  <th class="text-end">Total Amount</th>
                  <th class="text-end">Payment</th>
                </tr>
              </thead>
              <tbody>
                <% reportData.purchases.forEach(purchase => { %>
                  <tr>
                    <td><%= purchase.invoicenum || 'N/A' %></td>
                    <td><%= moment(purchase.createdAt).format('YYYY-MM-DD HH:mm') %></td>
                    <td>
                      <%= purchase.Vendor 
                        ? `${purchase.Vendor.firstname || ''} ${purchase.Vendor.lastname || ''}`.trim() 
                        : 'N/A' %>
                    </td>
                    <td><%= purchase.PurchasedItems ? purchase.PurchasedItems.length : 0 %></td>
                    <td class="text-end"><%= formatNumber(purchase.totalAmount) %></td>
                    <td class="text-end"><%= formatNumber(purchase.totalPayment) %></td>
                  </tr>
                <% }) %>
                <% if (reportData.purchases.length === 0) { %>
                  <tr>
                    <td colspan="6" class="text-center">No purchases found</td>
                  </tr>
                <% } %>
              </tbody>
              <tfoot>
                <tr class="fw-bold">
                  <td colspan="4">TOTAL</td>
                  <td class="text-end"><%= formatNumber(reportData.totals.totalAmount) %></td>
                  <td class="text-end"><%= formatNumber(reportData.totals.totalPayment) %></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <%- include('../components/partials/pagination', { baseUrl, query, pagination }) %>

          <div class="text-muted mt-3">
            <small>Report generated on: <%= moment(reportData.generatedAt).format('YYYY-MM-DD HH:mm:ss') %></small>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="ri-file-list-3-line fs-1 text-muted mb-3 d-block"></i>
            <h5 class="text-muted">Configure filters and click Generate Report to view data</h5>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% if (reportData.generated) { %>
<script>
  (function() {
    const pdfUrl = '/reports/purchases?<%- new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>';
    const btn = document.getElementById('btnViewPdf');
    if (btn && window.electron && window.electron.generateReportPdf) {
      btn.addEventListener('click', function() {
        btn.disabled = true;
        btn.innerHTML = '<i class="ri-loader-4-line spin me-1"></i> Generating...';
        window.electron.generateReportPdf(pdfUrl);
      });
      window.electron.onReportPdfGenerated(function(data) {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-file-pdf-line"></i> View PDF';
        if (data && data.success && data.url) {
          window.location.href = '/reports/pdf-viewer?src=' + encodeURIComponent(data.url);
        } else {
          alert(data && data.error ? data.error : 'Failed to generate PDF.');
        }
      });
    }
  })();
</script>
<% } %>
