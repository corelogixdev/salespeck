<div class="bi-report-container">
  <!-- Header Row -->
  <div class="bi-header-row">
    <h2 class="bi-page-title">Customer Report</h2>
    <div class="bi-conceptual-date">
      <i class="ri-time-line fs-16"></i> Current Conceptual Date at <%= moment().format('h:mm A') %>
    </div>
  </div>

  <!-- Filter Ribbon Bar (Only Relevant Filters) -->
  <div class="bi-filter-ribbon">
    <form method="GET" action="/reports/customers">
      <div class="bi-filter-grid">
        <div class="bi-filter-item date-item">
          <label class="bi-filter-label">Start Date</label>
          <input type="date" class="bi-filter-control" name="startDate" value="<%= reportData.filters.startDate || '' %>">
        </div>
        <div class="bi-filter-item date-item">
          <label class="bi-filter-label">End Date</label>
          <input type="date" class="bi-filter-control" name="endDate" value="<%= reportData.filters.endDate || '' %>">
        </div>
        <div class="bi-filter-item button-item">
          <button type="submit" class="bi-filter-btn-apply">Filter-apply</button>
        </div>
      </div>
    </form>
  </div>

  <!-- KPI Metrics & Chart Row -->
  <div class="row g-3">
    <div class="col-lg-6 col-xl-5">
      <div class="row g-3">
        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Customers</h6>
              <span class="bi-badge-trend-up">
                <i class="ri-arrow-right-up-line"></i> +12%
              </span>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value"><%= reportData.totals.totalCustomers || '156' %></div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Sales Count</h6>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value"><%= reportData.totals.totalSales || '412' %></div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-indigo"><i class="ri-shopping-cart-line"></i></div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Total Revenue (Rs.)</h6>
            </div>
            <div class="bi-kpi-body">
              <div class="bi-kpi-value">
                <%= reportData.totals.totalRevenue ? reportData.totals.totalRevenue.toFixed(2) : '8520400.00' %>
              </div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-blue">Rs.</div>
            </div>
          </div>
        </div>

        <div class="col-6">
          <div class="bi-kpi-card">
            <div class="bi-kpi-header">
              <h6 class="bi-kpi-title">Avg Spend (Rs.)</h6>
            </div>
            <div class="bi-kpi-body">
              <div>
                <div class="bi-kpi-value">
                  <%= ((reportData.totals.totalRevenue || 8520400) / Math.max(1, reportData.totals.totalCustomers || 156)).toFixed(2) %>
                </div>
                <div class="bi-kpi-subtext">Per Customer</div>
              </div>
              <div class="bi-kpi-icon-circle bi-kpi-icon-amber">Rs.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6 col-xl-7">
      <div class="bi-chart-card">
        <div class="bi-chart-header">
          <h5 class="bi-chart-title">Customer Acquisition & Revenue Trend</h5>
          <button type="button" class="bi-chart-selector">Current year <i class="ri-arrow-down-s-line"></i></button>
        </div>
        <div class="bi-chart-wrapper">
          <canvas id="customerTrendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Reporting Actions Bar -->
  <div class="bi-actions-card">
    <div class="bi-actions-title">Reporting Actions</div>
    <div class="bi-actions-flex">
      <div class="bi-action-btn-group">
        <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'csv'}).toString() %>" class="bi-btn-action">
          <i class="ri-file-excel-line text-success"></i> Export to CSV
        </a>
        <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'excel'}).toString() %>" class="bi-btn-action">
          <i class="ri-file-excel-2-line text-success"></i> Export to Excel
        </a>
        <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>" target="_blank" class="bi-btn-action" id="btnViewPdf">
          <i class="ri-file-pdf-line text-danger"></i> Export to PDF
        </a>
        <button type="button" class="bi-btn-action" onclick="navigator.clipboard.writeText(window.location.href); alert('Report URL copied to clipboard!');">
          <i class="ri-share-line text-primary"></i> Share Report
        </button>
        <button type="button" class="bi-btn-action" onclick="alert('Email schedule modal initiated.');">
          <i class="ri-mail-line text-info"></i> Schedule Email Distribution
        </button>
      </div>
      <div class="bi-nav-arrows">
        <button type="button" class="bi-nav-arrow-btn"><i class="ri-arrow-left-s-line"></i></button>
        <button type="button" class="bi-nav-arrow-btn"><i class="ri-arrow-right-s-line"></i></button>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="bi-table-card">
    <div class="bi-table-responsive">
      <table class="bi-table">
        <thead>
          <tr>
            <th style="width: 40px; text-align: center;">
              <input type="checkbox" id="selectAllRows" class="bi-table-checkbox">
            </th>
            <th>CUSTOMER NAME <i class="ri-arrow-up-down-line bi-sort-icon"></i></th>
            <th>PHONE</th>
            <th>EMAIL</th>
            <th class="text-end">TOTAL PURCHASES <i class="ri-arrow-up-down-line bi-sort-icon"></i></th>
            <th class="text-end">TOTAL SPENT</th>
            <th>LAST PURCHASE</th>
            <th class="text-center">STATUS</th>
          </tr>
        </thead>
        <tbody>
          <% if (reportData.customers && reportData.customers.length > 0) { %>
            <% reportData.customers.forEach(c => { %>
              <% 
                const name = `${c.firstname || ''} ${c.lastname || ''}`.trim() || 'N/A';
                const spent = parseFloat(c.totalSpent || 0);
                const isVip = spent > 100000;
              %>
              <tr>
                <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
                <td class="fw-bold"><%= name %></td>
                <td><%= c.phone || 'N/A' %></td>
                <td><%= c.email || 'N/A' %></td>
                <td class="text-end fw-semibold"><%= c.totalPurchases || 0 %></td>
                <td class="text-end fw-semibold"><%= spent.toFixed(2) %></td>
                <td>
                  <%= c.lastPurchaseDate 
                    ? moment(c.lastPurchaseDate).format('YYYY-MM-DD') 
                    : 'Never' %>
                </td>
                <td class="text-center">
                  <span class="bi-badge-status <%= isVip ? 'paid' : 'pending' %>">
                    <%= isVip ? 'VIP Customer' : 'Active' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
              <td class="fw-bold">Sarah Khan</td>
              <td>+92 300 1234567</td>
              <td>sarah.khan@example.com</td>
              <td class="text-end fw-semibold">18</td>
              <td class="text-end fw-semibold">7524543.00</td>
              <td>2026-08-20</td>
              <td class="text-center"><span class="bi-badge-status paid">VIP Customer</span></td>
            </tr>
            <tr>
              <td style="text-align: center;"><input type="checkbox" class="bi-table-checkbox row-checkbox"></td>
              <td class="fw-bold">Bilal Hassan</td>
              <td>+92 321 9876543</td>
              <td>bilal.hassan@example.com</td>
              <td class="text-end fw-semibold">6</td>
              <td class="text-end fw-semibold">45000.00</td>
              <td>2026-08-20</td>
              <td class="text-center"><span class="bi-badge-status pending">Active</span></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (pagination) { %>
    <div class="mt-3">
      <%- include('../components/partials/pagination', { baseUrl, query, pagination }) %>
    </div>
  <% } %>

  <!-- Footer Banner -->
  <div class="bi-footer-banner">
    Powered by SalesPeck BI: Comprehensive Financial Insights
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const selectAll = document.getElementById("selectAllRows");
  if (selectAll) {
    selectAll.addEventListener("change", function() {
      document.querySelectorAll(".row-checkbox").forEach(cb => cb.checked = selectAll.checked);
    });
  }

  const ctx = document.getElementById('customerTrendChart');
  if (ctx && typeof Chart !== 'undefined') {
    const chartLabels = ["Jann", "Feb", "Mar", "Aprr", "May", "June", "July", "Aug", "Sep"];
    const chartData = [20, 35, 45, 60, 75, 95, 120, 140, 156];

    const canvasCtx = ctx.getContext('2d');
    const gradient = canvasCtx.createLinearGradient(0, 0, 0, 180);
    gradient.addColorStop(0, 'rgba(67, 56, 202, 0.35)');
    gradient.addColorStop(1, 'rgba(67, 56, 202, 0.01)');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartLabels,
        datasets: [{
          label: 'Total Customers',
          data: chartData,
          borderColor: '#4338ca',
          borderWidth: 2.5,
          tension: 0.4,
          fill: true,
          backgroundColor: gradient,
          pointBackgroundColor: '#4338ca',
          pointBorderColor: '#ffffff',
          pointBorderWidth: 2,
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } },
          y: { grid: { color: '#f1f5f9' }, ticks: { color: '#64748b' } }
        }
      }
    });
  }

  const pdfUrl = '/reports/customers?<%- new URLSearchParams({...reportData.filters, generate: '1', format: 'pdf'}).toString() %>';
  const btn = document.getElementById('btnViewPdf');
  if (btn && window.electron && window.electron.generateReportPdf) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      btn.disabled = true;
      btn.innerHTML = '<i class="ri-loader-4-line spin me-1"></i> Generating...';
      window.electron.generateReportPdf(pdfUrl);
    });
    window.electron.onReportPdfGenerated(function(data) {
      btn.disabled = false;
      btn.innerHTML = '<i class="ri-file-pdf-line text-danger"></i> Export to PDF';
      if (data && data.success && data.url) {
        window.location.href = '/reports/pdf-viewer?src=' + encodeURIComponent(data.url);
      } else {
        alert(data && data.error ? data.error : 'Failed to generate PDF.');
      }
    });
  }
});
</script>
