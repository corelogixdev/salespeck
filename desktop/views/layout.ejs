            <script src="/assets/libs/chartjs/chart.umd.min.js"></script>
            <script>
                $(document).ready(function () {
                    setTimeout(() => {
                        $('.format-date').each(function () {
                            var date = $(this).text();
                            $(this).text(moment(date).format('DD MMM YYYY'));
                        });
                    });

                    // Handle "New Sale" link - create tab if already on sales form page
                    const newSaleLink = document.getElementById('new-sale-menu-link');
                    if (newSaleLink) {
                        newSaleLink.addEventListener('click', function (e) {
                            // Check if we're already on the sales form page
                            if (window.location.pathname === '/sales/form') {
                                e.preventDefault();
                                // Trigger new tab creation if the function exists
                                if (typeof createNewTab === 'function') {
                                    createNewTab();
                                } else {
                                    // If tabs aren't initialized yet, wait a bit
                                    setTimeout(() => {
                                        const newTabBtn = document.getElementById('new-sale-tab-btn');
                                        if (newTabBtn) {
                                            newTabBtn.click();
                                        }
                                    }, 100);
                                }
                            }
                            // Otherwise, let the default navigation happen
                        });
                    }
                });
            </script>
            <!-- Profile Modal -->
            <div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content profile-modal-content">
                        <div class="profile-modal-header">
                            <div class="profile-header-content">
                                <h4 class="modal-title mb-1">My Profile</h4>
                                <p class="mb-0 opacity-75">Manage your personal information and security</p>
                            </div>
                            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                                data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="profile-modal-body p-0">
                            <div class="profile-image-wrapper p-4 bg-light-subtle text-center border-bottom">
                                <div class="profile-image-container mb-0 mx-auto">
                                    <div class="initials-avatar"></div>
                                    <label for="profile-image-upload" class="profile-upload-btn">
                                        <i class="ri-camera-fill"></i>
                                    </label>
                                    <input type="file" id="profile-image-upload" accept="image/*"
                                        style="display: none;">
                                </div>
                            </div>

                            <div class="p-3">
                                <ul class="nav nav-tabs nav-tabs-custom nav-justified mb-3" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" data-bs-toggle="tab" href="#personalInfo" role="tab">
                                            <i class="ri-user-line me-1 align-middle"></i> Personal Info
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" data-bs-toggle="tab" href="#security" role="tab">
                                            <i class="ri-lock-2-line me-1 align-middle"></i> Security
                                        </a>
                                    </li>
                                </ul>

                                <div class="tab-content text-muted">
                                    <div class="tab-pane active" id="personalInfo" role="tabpanel">
                                        <form id="profile-form">
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">First Name</label>
                                                        <input type="text"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-firstname" name="firstname" required>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">Last Name</label>
                                                        <input type="text"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-lastname" name="lastname" required>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">Username</label>
                                                        <input type="text"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-username" disabled>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">Email</label>
                                                        <input type="email"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-email" name="email">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">Phone</label>
                                                        <input type="tel"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-phone" name="phone">
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group">
                                                        <label class="profile-form-label small">Address</label>
                                                        <input type="text"
                                                            class="form-control profile-input form-control-sm"
                                                            id="profile-address" name="address">
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="text-end mt-3">
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    <i class="ri-save-line align-middle me-1"></i> Save Changes
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="tab-pane" id="security" role="tabpanel">
                                        <form id="password-form">
                                            <div class="row g-2">
                                                <div class="col-12">
                                                    <div class="profile-form-group position-relative">
                                                        <label class="profile-form-label small">Current Password</label>
                                                        <input type="password"
                                                            class="form-control profile-input form-control-sm"
                                                            id="current-password" required>
                                                        <button type="button"
                                                            class="password-toggle-btn top-50 translate-middle-y">
                                                            <i class="ri-eye-off-line"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group position-relative">
                                                        <label class="profile-form-label small">New Password</label>
                                                        <input type="password"
                                                            class="form-control profile-input form-control-sm"
                                                            id="new-password" required minlength="6">
                                                        <button type="button"
                                                            class="password-toggle-btn top-50 translate-middle-y">
                                                            <i class="ri-eye-off-line"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="profile-form-group position-relative">
                                                        <label class="profile-form-label small">Confirm</label>
                                                        <input type="password"
                                                            class="form-control profile-input form-control-sm"
                                                            id="confirm-password" required minlength="6">
                                                        <button type="button"
                                                            class="password-toggle-btn top-50 translate-middle-y">
                                                            <i class="ri-eye-off-line"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-end mt-3">
                                                <button type="submit" class="btn btn-warning btn-sm">
                                                    <i class="ri-lock-password-line align-middle me-1"></i> Update
                                                    Password
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="/assets/js/profile-modal.js"></script>

                <% if (typeof user !=='undefined' && user) { %>
                    <script>
                        // Maximize window after login
                        document.addEventListener('DOMContentLoaded', function () {
                            if (window.electron) {
                                window.electron.send('maximize-window');
                            }
                        });
                    </script>
                    <% } %>
    <script src="/assets/js/scanner-helper.js"></script>
</body>

</html>
