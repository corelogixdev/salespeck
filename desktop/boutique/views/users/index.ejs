<div class="modal fade" id="managePartyTypesModal" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light border-bottom py-2">
                <h5 class="modal-title" id="managePartyTypesModalTitle">Manage Types</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addPartyTypeForm" class="d-flex mb-3">
                    <input type="text" class="form-control form-control-sm me-2" id="newPartyTypeName" placeholder="New Type Name" required>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="ri-add-line"></i></button>
                </form>
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-nowrap align-middle">
                        <tbody id="partyTypesList">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPartyRole = '';
    
    function loadPartyTypes(role, selectedId = null, targetSelectId = null) {
        if (role !== 'vendor' && role !== 'customer') return;
        
        fetch(`/partytypes?type=${role}`)
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    const options = '<option value="">Select Type...</option>' + 
                        res.data.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
                    
                    if (targetSelectId) {
                        const select = document.getElementById(targetSelectId);
                        if (select) {
                            select.innerHTML = options;
                            if (selectedId) select.value = selectedId;
                        }
                    } else {
                        const addSelect = document.getElementById('addPartyType');
                        const editSelect = document.getElementById('editPartyType');
                        if (addSelect) {
                            const prevVal = addSelect.value;
                            addSelect.innerHTML = options;
                            if (prevVal) addSelect.value = prevVal;
                        }
                        if (editSelect) {
                            const prevVal = editSelect.value;
                            editSelect.innerHTML = options;
                            if (prevVal) editSelect.value = prevVal;
                        }
                    }
                    
                    // Populate modal list if open
                    const listEl = document.getElementById('partyTypesList');
                    if (listEl && currentPartyRole === role) {
                        listEl.innerHTML = res.data.map(t => `
                            <tr>
                                <td>
                                    <input type="text" class="form-control form-control-sm border-0 bg-light" id="pt_name_${t.id}" value="${t.name}">
                                </td>
                                <td class="text-end" style="width: 80px;">
                                    <button class="btn btn-sm btn-link text-primary p-0 me-2" onclick="updatePartyType('${t.id}')"><i class="ri-save-line fs-16"></i></button>
                                    <button class="btn btn-sm btn-link text-danger p-0" onclick="deletePartyType('${t.id}')"><i class="ri-delete-bin-line fs-16"></i></button>
                                </td>
                            </tr>
                        `).join('');
                    }
                }
            });
    }

    function managePartyTypes(role) {
        currentPartyRole = role;
        document.getElementById('managePartyTypesModalTitle').innerText = role === 'vendor' ? 'Manage Vendor Types' : 'Manage Client Types';
        loadPartyTypes(role);
        new bootstrap.Modal(document.getElementById('managePartyTypesModal')).show();
    }

    document.getElementById('addPartyTypeForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        const name = document.getElementById('newPartyTypeName').value;
        if (!name) return;
        
        fetch('/partytypes/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, type: currentPartyRole })
        }).then(r => r.json()).then(res => {
            if (res.success) {
                document.getElementById('newPartyTypeName').value = '';
                loadPartyTypes(currentPartyRole);
            } else {
                toastr.error(res.message);
            }
        });
    });

    function updatePartyType(id) {
        const name = document.getElementById(`pt_name_${id}`).value;
        fetch('/partytypes/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, name, type: currentPartyRole })
        }).then(r => r.json()).then(res => {
            if (res.success) {
                toastr.success('Updated successfully');
                loadPartyTypes(currentPartyRole);
            } else {
                toastr.error(res.message);
            }
        });
    }

    function deletePartyType(id) {
        if (!confirm('Are you sure?')) return;
        fetch(`/partytypes/${id}/delete`, { method: 'POST' })
            .then(r => r.json()).then(res => {
                if (res.success) {
                    loadPartyTypes(currentPartyRole);
                } else {
                    toastr.error(res.message);
                }
            });
    }
    
    // Initial load
    document.addEventListener('DOMContentLoaded', () => {
        loadPartyTypes('<%= role %>');
    });
</script><!-- Iframe Modal for Document Viewing -->
