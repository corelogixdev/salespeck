<!-- View Modal -->
<%- include('../components/partials/view-modal', {
    id: 'viewUserModal',
    title: (role==='user' ? 'User' : (role==='vendor' ? 'Vendor' : 'Customer')) + ' Details',
    size: 'modal-xl'
}) %>



<script>
    function balanceOB(input, rowType, fieldType, prefix = '') {
        const form = input.closest('form');
        const val = parseFloat(input.value) || 0;
        
        // Disable other field in same row
        const otherFieldInRow = fieldType === 'debit' ? 'credit' : 'debit';
        form.querySelector(`[name="ob_${rowType}_${otherFieldInRow}"]`).value = val > 0 ? 0 : form.querySelector(`[name="ob_${rowType}_${otherFieldInRow}"]`).value;

        // Balance logic
        const otherRowType = rowType === 'primary' ? 'contra' : 'primary';
        const otherRowField = fieldType === 'debit' ? 'credit' : 'debit';
        const sameFieldInOtherRow = fieldType;

        if (val > 0) {
            // If I debit primary, I should credit contra
            form.querySelector(`[name="ob_${otherRowType}_${otherRowField}"]`).value = val;
            form.querySelector(`[name="ob_${otherRowType}_${sameFieldInOtherRow}"]`).value = 0;
        }

        // Check balance badge
        const pDebit = parseFloat(form.querySelector('[name="ob_primary_debit"]').value) || 0;
        const pCredit = parseFloat(form.querySelector('[name="ob_primary_credit"]').value) || 0;
        const cDebit = parseFloat(form.querySelector('[name="ob_contra_debit"]').value) || 0;
        const cCredit = parseFloat(form.querySelector('[name="ob_contra_credit"]').value) || 0;
        
        const totalDebit = pDebit + cDebit;
        const totalCredit = pCredit + cCredit;
        
        const badge = prefix === 'edit' ? document.getElementById('editObBalanceBadge') : document.getElementById('obBalanceBadge');
        if (totalDebit === totalCredit && totalDebit > 0) {
            badge.innerText = 'Balanced';
            badge.className = 'badge bg-soft-success text-success fs-10';
        } else if (totalDebit !== totalCredit) {
            badge.innerText = 'Imbalanced';
            badge.className = 'badge bg-soft-danger text-danger fs-10';
        } else {
            badge.innerText = 'No Entry';
            badge.className = 'badge bg-soft-secondary text-muted fs-10';
        }
    }

    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('ri-eye-line');
            icon.classList.add('ri-eye-off-line');
        } else {
            input.type = 'password';
            icon.classList.remove('ri-eye-off-line');
            icon.classList.add('ri-eye-line');
        }
    }

    async function openViewModal(id) {
        try {
            const userResponse = await fetch('/users/' + id);
            const userResult = await userResponse.json();
            if (!userResult.success) return toastr.error('Failed to load details');
            
            const u = userResult.user;
            const role = '<%= role %>';
            const fields = [
                { label: 'First Name', value: u.firstname, icon: 'ri-user-line' },
                { label: 'Last Name', value: u.lastname || '-', icon: 'ri-user-line' },
                { label: 'Email', value: u.email || '-', icon: 'ri-mail-line' },
                { label: 'Phone', value: u.phone || '-', icon: 'ri-phone-line' },
                { label: 'Address', value: u.address || '-', icon: 'ri-map-pin-line' }
            ];

            // Build Profile Header
            const initials = (u.firstname.charAt(0) + (u.lastname ? u.lastname.charAt(0) : '')).toUpperCase();
            let headerHtml = `
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0">
                        <div class="avatar-md">
                            <span class="avatar-title bg-soft-primary text-primary rounded-circle fs-20 fw-bold" style="width: 48px; height: 48px;">
                                ${initials}
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-4">
                        <div class="d-flex align-items-center mb-3">
                            <h4 class="mb-0 fw-bold text-dark">${u.firstname} ${u.lastname || ''}</h4>
                            <span class="badge bg-soft-info text-info ms-3 fs-10 text-uppercase ls-1">${role}</span>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <i class="ri-phone-line text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold fs-9 d-block ls-1">Phone</small>
                                        <h6 class="mb-0 fs-12 fw-semibold">${u.phone || '-'}</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <i class="ri-mail-line text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold fs-9 d-block ls-1">Email</small>
                                        <h6 class="mb-0 fs-12 fw-semibold text-truncate" style="max-width: 150px;">${u.email || '-'}</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <i class="ri-map-pin-line text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold fs-9 d-block ls-1">Address</small>
                                        <h6 class="mb-0 fs-12 fw-semibold text-truncate" style="max-width: 200px;">${u.address || 'No address'}</h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    ${role !== 'user' ? `
                    <div class="flex-shrink-0 text-end p-2 px-3 bg-white rounded border border-dashed ms-4" style="min-width: 140px;">
                        <small class="text-muted text-uppercase fw-bold fs-9 d-block mb-0">Current Balance</small>
                        <h4 class="mb-0 fw-bold ${u.balance >= 0 ? 'text-success' : 'text-danger'}">
                            ${Math.abs(u.balance || 0).toLocaleString(undefined, { minimumFractionDigits: 2 })}
                            <small class="fs-11 fw-normal text-muted">${u.balance >= 0 ? 'Dr' : 'Cr'}</small>
                        </h4>
                    </div>
                    ` : ''}
                </div>
            `;
            
            if (role === 'user') {
                fields.push({ label: 'Username', value: u.username || '-', icon: 'ri-user-settings-line' });
                fields.push({ label: 'Role', value: u.role || '-', icon: 'ri-shield-user-line' });
                renderViewModal('viewUserModal', fields, null, headerHtml);
            } else {
                // Fetch Ledger for Customers/Vendors
                const ledgerResponse = await fetch('/accounting/ledger/party/' + id);
                const ledgerResult = await ledgerResponse.json();

                // Sort newest first
                const allEntries = (ledgerResult.success && ledgerResult.ledger.length > 0)
                    ? [...ledgerResult.ledger].sort((a, b) => new Date(b.journal.date) - new Date(a.journal.date))
                    : [];

                // Build cumulative balances (oldest→newest direction)
                const oldestFirst = [...allEntries].reverse();
                const cumulativeBalances = [];
                let bal = 0;
                for (const entry of oldestFirst) {
                    if (role === 'customer') bal += (entry.debit - entry.credit);
                    else bal += (entry.credit - entry.debit);
                    cumulativeBalances.push(bal);
                }
                const total = allEntries.length;

                function buildModalSOAHtml(pageSize, currentPage) {
                    let startIdx = 0, endIdx = total;
                    let pageEntries = allEntries;
                    if (pageSize !== 'all') {
                        startIdx = (currentPage - 1) * pageSize;
                        endIdx   = Math.min(startIdx + pageSize, total);
                        pageEntries = allEntries.slice(startIdx, endIdx);
                    }

                    let rowsHtml = '';
                    for (let j = 0; j < pageEntries.length; j++) {
                        const entry = pageEntries[j];
                        const globalIdx = startIdx + j;
                        const balance = cumulativeBalances[total - 1 - globalIdx];

                        let viewButton = '';
                        if (entry.journal.reference) {
                            let docTitle = entry.journal.description || (entry.journal.voucher_no ? 'Invoice ' + entry.journal.voucher_no : 'Document');
                            const desc = (entry.journal.description || '').toLowerCase();
                            if (desc.includes('sale')) {
                                viewButton = `<button type="button" onclick="openIframeModal('/sales/${entry.journal.reference}', '${docTitle}')" class="btn btn-soft-primary btn-sm px-2 py-0 fs-11"><i class="ri-eye-line me-1"></i>View</button>`;
                            } else if (desc.includes('purchase')) {
                                viewButton = `<button type="button" onclick="openIframeModal('/accounting/purchase/view/${entry.journal.reference}', '${docTitle}')" class="btn btn-soft-primary btn-sm px-2 py-0 fs-11"><i class="ri-eye-line me-1"></i>View</button>`;
                            }
                        }

                        const debitVal  = (entry.debit > 0 || entry.credit < 0) ? Math.abs(entry.debit || entry.credit).toLocaleString(undefined, { minimumFractionDigits: 2 }) : '-';
                        const creditVal = (entry.credit > 0 || entry.debit < 0) ? Math.abs(entry.credit || entry.debit).toLocaleString(undefined, { minimumFractionDigits: 2 }) : '-';
                        const debitClass  = (entry.debit > 0 || entry.credit < 0) ? 'text-success' : 'text-muted';
                        const creditClass = (entry.credit > 0 || entry.debit < 0) ? 'text-danger' : 'text-muted';
                        const balLabel = role === 'customer' ? (balance >= 0 ? 'Dr' : 'Cr') : (balance >= 0 ? 'Cr' : 'Dr');

                        rowsHtml += `
                            <tr>
                                <td class="text-muted">${new Date(entry.journal.date).toLocaleDateString()}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <div class="fw-semibold text-dark">${entry.journal.description || '-'}</div>
                                        ${entry.journal.voucher_no ? `<span class="badge bg-soft-info text-info fs-10">${entry.journal.voucher_no}</span>` : ''}
                                        ${viewButton}
                                    </div>
                                    <div class="text-muted fs-12">${entry.details || ''}</div>
                                </td>
                                <td class="text-end fw-medium ${debitClass}">${debitVal}</td>
                                <td class="text-end fw-medium ${creditClass}">${creditVal}</td>
                                <td class="text-end fw-bold text-dark bg-light-subtle">
                                    ${Math.abs(balance).toLocaleString(undefined, { minimumFractionDigits: 2 })}
                                    <small class="text-muted fw-normal">${balLabel}</small>
                                </td>
                            </tr>
                        `;
                    }

                    // Page totals
                    let pageTotalDebit = 0, pageTotalCredit = 0;
                    for (const entry of pageEntries) {
                        if (entry.debit > 0 || entry.credit < 0) pageTotalDebit  += Math.abs(entry.debit || entry.credit);
                        if (entry.credit > 0 || entry.debit < 0) pageTotalCredit += Math.abs(entry.credit || entry.debit);
                    }
                    let grandTotalDebit = 0, grandTotalCredit = 0;
                    for (const entry of allEntries) {
                        if (entry.debit > 0 || entry.credit < 0) grandTotalDebit  += Math.abs(entry.debit || entry.credit);
                        if (entry.credit > 0 || entry.debit < 0) grandTotalCredit += Math.abs(entry.credit || entry.debit);
                    }
                    const grandBalance = cumulativeBalances.length > 0 ? cumulativeBalances[cumulativeBalances.length - 1] : 0;
                    const grandBalLabel = role === 'customer' ? (grandBalance >= 0 ? 'Dr' : 'Cr') : (grandBalance >= 0 ? 'Cr' : 'Dr');

                    // Pagination controls
                    let paginationHtml = '';
                    if (pageSize !== 'all' && total > 0) {
                        const totalPages = Math.ceil(total / pageSize);
                        const from = startIdx + 1, to = endIdx;
                        let btns = '';
                        btns += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}"><a class="page-link soa-modal-page" href="#" data-page="${currentPage - 1}">‹</a></li>`;
                        const delta = 2;
                        let pages2 = [], prev2 = null;
                        for (let i = 1; i <= totalPages; i++) {
                            if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) pages2.push(i);
                        }
                        for (const p of pages2) {
                            if (prev2 !== null && p - prev2 > 1) btns += `<li class="page-item disabled"><span class="page-link">…</span></li>`;
                            btns += `<li class="page-item ${p === currentPage ? 'active' : ''}"><a class="page-link soa-modal-page" href="#" data-page="${p}">${p}</a></li>`;
                            prev2 = p;
                        }
                        btns += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}"><a class="page-link soa-modal-page" href="#" data-page="${currentPage + 1}">›</a></li>`;

                        paginationHtml = `
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-2 pt-2 border-top">
                                <div class="text-muted fs-12">Showing ${from} to ${to} of ${total} records</div>
                                <nav><ul class="pagination pagination-sm mb-0">${btns}</ul></nav>
                            </div>
                        `;
                    }

                    return `
                        <div class="card border-0 shadow-none mb-0">
                            <div class="card-header p-0 pb-3 bg-transparent border-0 d-flex align-items-center flex-wrap gap-2">
                                <h6 class="card-title mb-0 flex-grow-1"><i class="ri-file-list-3-line me-1 align-bottom text-primary"></i> Statement of Account</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <label class="text-muted fs-12 mb-0">Show</label>
                                    <select id="soaModalPageSize" class="form-select form-select-sm" style="min-width: 75px;">
                                        <option value="10" ${pageSize === 10 ? 'selected' : ''}>10</option>
                                        <option value="25" ${pageSize === 25 ? 'selected' : ''}>25</option>
                                        <option value="50" ${pageSize === 50 ? 'selected' : ''}>50</option>
                                        <option value="100" ${pageSize === 100 ? 'selected' : ''}>100</option>
                                        <option value="all" ${pageSize === 'all' ? 'selected' : ''}>All</option>
                                    </select>
                                    <button class="btn btn-soft-primary btn-sm" onclick="doUserPrint()"><i class="ri-printer-line me-1"></i> Print</button>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-nowrap align-middle mb-0">
                                    <thead class="table-light fs-11 text-uppercase">
                                        <tr>
                                            <th style="width: 100px;">Date</th>
                                            <th>Description</th>
                                            <th class="text-end" style="width: 120px;">Debit</th>
                                            <th class="text-end" style="width: 120px;">Credit</th>
                                            <th class="text-end" style="width: 140px;">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody class="fs-13">
                                        ${rowsHtml || '<tr><td colspan="5" class="text-center py-5 text-muted"><i class="ri-file-history-line fs-24 d-block mb-2"></i>No transactions found for this period</td></tr>'}
                                    </tbody>
                                    ${pageEntries.length > 0 ? `
                                    <tfoot class="table-light fs-12 fw-bold">
                                        <tr>
                                            <td colspan="2" class="text-end text-muted text-uppercase fs-11">${pageSize !== 'all' ? `Page ${currentPage} Totals` : 'Grand Totals'}</td>
                                            <td class="text-end text-success">${pageTotalDebit.toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                                            <td class="text-end text-danger">${pageTotalCredit.toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                                            <td class="text-end"></td>
                                        </tr>
                                        ${pageSize !== 'all' ? `
                                        <tr class="border-top">
                                            <td colspan="2" class="text-end text-muted text-uppercase fs-11">Grand Totals</td>
                                            <td class="text-end text-success">${grandTotalDebit.toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                                            <td class="text-end text-danger">${grandTotalCredit.toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                                            <td class="text-end fw-bold text-dark">
                                                ${Math.abs(grandBalance).toLocaleString(undefined, { minimumFractionDigits: 2 })}
                                                <small class="text-muted fw-normal ms-1">${grandBalLabel}</small>
                                            </td>
                                        </tr>
                                        ` : ''}
                                    </tfoot>
                                    ` : ''}
                                </table>
                            </div>
                            ${paginationHtml}
                        </div>
                    `;
                }

                // Initial render
                let soaModalPageSize = 10;
                let soaModalCurrentPage = 1;

                const ledgerHtml = buildModalSOAHtml(soaModalPageSize, soaModalCurrentPage);
                renderViewModal('viewUserModal', ledgerHtml, null, headerHtml);

                const modal = new bootstrap.Modal(document.getElementById('viewUserModal'));
                modal.show();

                // Attach page-size and pagination handlers after modal is shown
                setTimeout(() => {
                    attachModalPaginationHandlers();

                    function attachModalPaginationHandlers() {
                        // Re-attach page-size select (re-rendered on each page/size change)
                        const psSel = document.getElementById('soaModalPageSize');
                        if (psSel) {
                            psSel.addEventListener('change', function() {
                                soaModalPageSize = this.value === 'all' ? 'all' : parseInt(this.value);
                                soaModalCurrentPage = 1;
                                const newHtml = buildModalSOAHtml(soaModalPageSize, soaModalCurrentPage);
                                renderViewModal('viewUserModal', newHtml, null, headerHtml);
                                attachModalPaginationHandlers();
                            });
                        }
                        // Re-attach page number links
                        document.querySelectorAll('.soa-modal-page').forEach(a => {
                            a.addEventListener('click', function(e) {
                                e.preventDefault();
                                const p = parseInt(this.dataset.page);
                                const totalPages = Math.ceil(total / soaModalPageSize);
                                if (p >= 1 && p <= totalPages) {
                                    soaModalCurrentPage = p;
                                    const newHtml = buildModalSOAHtml(soaModalPageSize, soaModalCurrentPage);
                                    renderViewModal('viewUserModal', newHtml, null, headerHtml);
                                    attachModalPaginationHandlers();
                                }
                            });
                        });
                    }
                }, 300);


                return; // modal.show() already called above
            }
            const modal = new bootstrap.Modal(document.getElementById('viewUserModal'));
            modal.show();
        } catch (e) {
            console.error(e);
            toastr.error('Error loading details');
        }
    }

    function openEditModal(id) {
        fetch('/users/' + id)
            .then(r => r.json())
            .then(result => {
                if (!result.success) return toastr.error('Failed to load record');
                const u = result.user;
                document.getElementById('editUserId').value = u.id;
                document.getElementById('editFirstName').value = u.firstname || '';
                document.getElementById('editLastName').value = u.lastname || '';
                document.getElementById('editEmail').value = u.email || '';
                document.getElementById('editUsername').value = u.username || '';
                document.getElementById('editPhone').value = u.phone || '';
                document.getElementById('editAddress').value = u.address || '';
                if (document.getElementById('editPartyType') && u.fk_partytype_id) {
                    document.getElementById('editPartyType').value = u.fk_partytype_id;
                }
                const currentRole = '<%= role %>';
                if (currentRole !== 'customer' && currentRole !== 'vendor') {
                    const pw = document.getElementById('editPassword');
                    pw.value = '';
                    pw.placeholder = 'Leave blank to keep current';
                    const btn = pw.nextElementSibling;
                    if (btn) {
                        btn.querySelector('i').classList.remove('ri-eye-off-line');
                        btn.querySelector('i').classList.add('ri-eye-line');
                    }
                } else {
                    if (u.ob_date) document.getElementById('editObDate').value = u.ob_date;
                    if (u.ob_primary_debit !== undefined) document.getElementById('editObPrimaryDebit').value = u.ob_primary_debit;
                    if (u.ob_primary_credit !== undefined) document.getElementById('editObPrimaryCredit').value = u.ob_primary_credit;
                    if (u.ob_contra_account) document.getElementById('editObContraAccount').value = u.ob_contra_account;
                    if (u.ob_contra_debit !== undefined) document.getElementById('editObContraDebit').value = u.ob_contra_debit;
                    if (u.ob_contra_credit !== undefined) document.getElementById('editObContraCredit').value = u.ob_contra_credit;
                    // Re-evaluate badge
                    balanceOB(document.getElementById('editObPrimaryDebit'), 'primary', 'debit', 'edit');
                }
                const modal = new bootstrap.Modal(document.getElementById('editUserModal'));
                modal.show();
            })
            .catch(e => { console.error(e); toastr.error('Error loading record'); });
    }

    function validateForm(formId) {
        const form = document.getElementById(formId);
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return null;
        }
        const phone = form.querySelector('input[name="phone"]').value;
        if (phone && phone.length < 8) {
            toastr.error('Phone number must be at least 8 characters');
            form.querySelector('input[name="phone"]').focus();
            return null;
        }
        const data = {};
        new FormData(form).forEach((value, key) => { data[key] = value; });
        return data;
    }

    function saveUser() {
        const data = validateForm('addUserForm');
        if (!data) return;
        fetch('/users/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                toastr.success(result.message);
                const modal = bootstrap.Modal.getInstance(document.getElementById('addUserModal'));
                if (modal) modal.hide();
                setTimeout(() => window.location.reload(), 800);
            } else {
                toastr.error(result.message || 'Error saving record');
            }
        })
        .catch(e => { console.error(e); toastr.error('Failed to save record'); });
    }

    function updateUser() {
        const data = validateForm('editUserForm');
        if (!data) return;
        fetch('/users/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                toastr.success(result.message);
                const modal = bootstrap.Modal.getInstance(document.getElementById('editUserModal'));
                if (modal) modal.hide();
                setTimeout(() => window.location.reload(), 800);
            } else {
                toastr.error(result.message || 'Error updating record');
            }
        })
        .catch(e => { console.error(e); toastr.error('Failed to update record'); });
    }

    function deleteRecord(id) {
        $.confirm({
            title: 'Confirm Delete',
            content: 'Are you sure you want to delete this record?',
            theme: 'material',
            useBootstrap: false,
            boxWidth: '30%',
            type: 'red',
            buttons: {
                confirm: {
                    text: 'Yes, Delete',
                    btnClass: 'btn-danger',
                    action: function () {
                        fetch('/users/' + id + '/delete', { method: 'POST' })
                            .then(r => r.json())
                            .then(result => {
                                if (result.success) {
                                    toastr.success(result.message);
                                    setTimeout(() => window.location.reload(), 800);
                                } else {
                                    toastr.error(result.message || 'Error deleting record');
                                }
                            })
                            .catch(e => { console.error(e); toastr.error('Failed to delete record'); });
                    }
                },
                cancel: {
                    text: 'No',
                    btnClass: 'btn-primary'
                }
            }
        });
    }
</script>

