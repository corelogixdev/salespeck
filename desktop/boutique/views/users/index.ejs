<script src="/assets/js/print-helper.js"></script>
<script>
    const printerConfig = <%- JSON.stringify(typeof printerConfig !== 'undefined' ? printerConfig : { printer: 'Default', printerType: 'standard', paper: 'A4', width: 210, height: 297, fontSize: 12, silentPrinting: false, numberOfPrints: 1 }) %>;
    window.printerConfig = printerConfig;

async function doUserPrint() {
    if (window.SalesPeckPrinter && typeof window.SalesPeckPrinter.print === 'function') {
        await window.SalesPeckPrinter.print();
    } else {
        window.print();
    }
}

function openIframeModal(url, title = 'Document View') {
    document.getElementById('iframeModalTitle').innerText = title;
    
    const iframe = document.getElementById('iframeModalContent');
    iframe.src = url;
    
    const modal = new bootstrap.Modal(document.getElementById('iframeModal'));
    modal.show();
    
    document.getElementById('iframeModal').addEventListener('hidden.bs.modal', function () {
        iframe.src = '';
    }, { once: true });
}
</script>
