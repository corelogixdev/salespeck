<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Customer Receipt - <%= order.ordernum %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fff; color: #000; font-size: 13px; }
        .receipt-box { max-width: 820px; margin: 15px auto; border: 1.5px solid #000; padding: 25px; background: #fff; position: relative; }
        .urdu-txt { font-family: 'Noto Nastaliq Urdu', 'Jameel Noori Nastaleeq', 'Segoe UI', sans-serif; opacity: 0.65; font-size: 11px; font-weight: normal; }
        .eng-label { font-weight: 700; color: #000; font-size: 12px; }
        .grid-table { width: 100%; border-collapse: collapse; border: 1.5px solid #000; margin-top: 10px; }
        .grid-table th, .grid-table td { border: 1px solid #000 !important; padding: 4px 6px; font-size: 12px; }
        .grid-table th { background-color: #f5f5f5 !important; text-align: center; font-weight: bold; text-transform: uppercase; }
        .particulars-cell { position: relative; vertical-align: top; }
        .watermark-bg { position: absolute; top: 30%; left: 25%; width: 50%; opacity: 0.06; pointer-events: none; }
        .totals-row td { font-weight: bold; font-size: 13px; }
        
        /* Laser Printer / PDF Viewer Page Setup */
        @media print {
            @page {
                size: A4 portrait;
                margin: 10mm;
            }
            html, body {
                background: #ffffff !important;
                color: #000000 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print { display: none !important; }
            .receipt-box { border: 1.5px solid #000 !important; max-width: 100% !important; width: 100% !important; margin: 0 !important; padding: 15px !important; box-shadow: none !important; }
        }
    </style>
</head>
<body>

<div class="container no-print my-3 text-center d-flex justify-content-center gap-2">
    <a href="/sales-orders/details/<%= order.id %>" class="btn btn-outline-secondary btn-lg shadow-sm">
        <i class="ri-arrow-left-line me-1"></i> Back to Order Details
    </a>
    <a href="/sales-orders/job-ticket/<%= order.id %>" target="_blank" class="btn btn-dark btn-lg shadow-sm">
        <i class="ri-scissors-line me-1"></i> Print Workshop Slip
    </a>
    <button onclick="window.print()" class="btn btn-primary btn-lg shadow">
        <i class="ri-printer-line me-1"></i> Print Customer Receipt (PDF / Laser)
    </button>
</div>

<div class="receipt-box">
    <!-- Top Branding & Order Header -->
    <div class="row align-items-center pb-2 border-bottom border-dark">
        <!-- Left: Boutique Logo & Name -->
        <div class="col-4">
            <% if (company.logo) { %>
                <img src="<%= company.logo %>" style="max-height: 65px;" alt="Logo" class="mb-1"><br>
            <% } else { %>
                <div style="font-size: 26px; font-weight: 900; letter-spacing: -1px; text-transform: uppercase; line-height: 1;">
                    <span style="font-size: 36px; line-height: 1;">T</span> <%= company.name %>
                </div>
            <% } %>
            <div style="font-size: 10px; font-weight: bold; letter-spacing: 1.5px; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 2px 4px; display: inline-block; margin-top: 2px;">
                <%= company.tagline || 'BRIDAL | PARTY | FORMAL' %>
            </div>
        </div>

        <!-- Middle: Dynamic Contact Details -->
        <div class="col-4 text-center" style="font-size: 11px; line-height: 1.3;">
            <div class="fw-semibold">🏢 <%= company.address %></div>
            <div class="fw-bold mt-1">📱 <%= company.phone %></div>
            <% if (company.email) { %><div class="text-muted">✉️ <%= company.email %></div><% } %>
        </div>

        <!-- Right: Dates & Order Number -->
        <div class="col-4 text-end" style="font-size: 12px;">
            <div><strong>Date:</strong> <u><%= new Date(order.bookingDate).toLocaleDateString() %></u></div>
            <div class="mt-1"><strong>Delivery Date:</strong> <u><%= order.deliveryDate ? new Date(order.deliveryDate).toLocaleDateString() : '____' %></u></div>
            <div class="mt-2 fs-16 fw-bold">
                Order No. <span class="border-bottom border-2 border-dark px-2"><%= order.ordernum.replace('SO-', '') %></span>
            </div>
        </div>
    </div>

    <!-- M/S Customer Line -->
    <div class="py-2 border-bottom border-dark" style="font-size: 14px;">
        <strong>M/S:</strong> <span class="fw-bold border-bottom border-dark px-2"><%= customerDetails ? `${customerDetails.firstname || ''} ${customerDetails.lastname || ''}`.trim() : (order.customer || 'Walk-in Client') %></span>
        <% if (customerDetails && customerDetails.phone) { %>
            <span class="ms-4"><strong>Cell:</strong> <u><%= customerDetails.phone %></u></span>
        <% } %>
    </div>

    <!-- Extract Measurements -->
    <% 
        let m = {};
        if (order.items && order.items.length > 0 && order.items[0].notes) {
            try { m = JSON.parse(order.items[0].notes); } catch(e) {}
        }
        if (!m.lambai && measurements.globalUpper) {
            m = { ...measurements.globalUpper, ...measurements.globalLower, ...measurements.globalEmbroidery };
        }
    %>

    <!-- Main Content Table -->
    <table class="grid-table">
        <thead>
            <tr>
                <th style="width: 28%;">Size (Measurements)</th>
                <th style="width: 42%;">Particulars</th>
                <th style="width: 15%;">Rate</th>
                <th style="width: 15%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <!-- Prominent English + Dim Urdu Measurement List Column -->
                <td style="vertical-align: top; padding: 0;">
                    <table class="w-100 border-0" style="font-size: 12px; line-height: 1.5;">
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.lambai || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Length</span>
                                <small class="urdu-txt ms-1">لمبائی</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.gheera || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Flare / Daman</span>
                                <small class="urdu-txt ms-1">گھیرا</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.bazu || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Sleeve</span>
                                <small class="urdu-txt ms-1">بازو</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.bazu_mori || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Cuff / Opening</span>
                                <small class="urdu-txt ms-1">بازوموری</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.teera || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Shoulder</span>
                                <small class="urdu-txt ms-1">تیرہ</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.chest || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Chest</span>
                                <small class="urdu-txt ms-1">چیسٹ</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.kamar || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Waist</span>
                                <small class="urdu-txt ms-1">کمر</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.hip || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Hip</span>
                                <small class="urdu-txt ms-1">ہپ</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.chaak || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Side Slit</span>
                                <small class="urdu-txt ms-1">چاک</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.shalwar_lambai || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Trouser Length</span>
                                <small class="urdu-txt ms-1">شلوارلمبائی</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.paincha || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Bottom Opening</span>
                                <small class="urdu-txt ms-1">پائنچہ</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.thigh || '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Thigh Width</span>
                                <small class="urdu-txt ms-1">تھائی</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.lower_style === 'Lehenga/Gharara' ? '✔' : '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Lehenga / Gharara</span>
                                <small class="urdu-txt ms-1">لہنگا/غرارہ</small>
                            </td>
                        </tr>
                        <tr class="border-bottom">
                            <td class="text-start ps-1 fw-bold"><%= m.lower_style === 'Churidar' ? '✔' : '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Churidar</span>
                                <small class="urdu-txt ms-1">چوڑی دار</small>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-start ps-1 fw-bold"><%= m.lower_style === 'Flipper' ? '✔' : '____' %></td>
                            <td class="text-end pe-2">
                                <span class="eng-label">Flapper / Flipper</span>
                                <small class="urdu-txt ms-1">فلیپر</small>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- Particulars Item List -->
                <td class="particulars-cell" style="min-height: 280px;">
                    <!-- Semi-transparent Watermark -->
                    <% if (company.logo) { %>
                        <img src="<%= company.logo %>" class="watermark-bg" alt="Watermark">
                    <% } %>

                    <div style="position: relative; z-index: 2;">
                        <% (order.items || []).forEach((item, idx) => { 
                            let itemNotes = {};
                            try { if (item.notes && item.notes.startsWith('{')) itemNotes = JSON.parse(item.notes); } catch(e){}
                        %>
                        <div class="mb-3">
                            <div class="fw-bold text-dark fs-13">#<%= idx + 1 %>. <%= item.item_name %> (<%= item.item_type %>)</div>
                            <% if (itemNotes.pattern_code) { %><div class="fs-12 text-muted">Design Pattern: <%= itemNotes.pattern_code %></div><% } %>
                            <% if (itemNotes.dupatta_specs) { %><div class="fs-12 text-muted">Dupatta: <%= itemNotes.dupatta_specs %></div><% } %>
                            <% if (itemNotes.thread_details) { %><div class="fs-12 text-muted">Thread/Zari: <%= itemNotes.thread_details %></div><% } %>
                            <% if (itemNotes.extra_charge && itemNotes.extra_charge > 0) { %><div class="fs-12 text-dark fw-semibold">Extra Work Charge: Rs. <%= itemNotes.extra_charge %></div><% } %>
                        </div>
                        <% }) %>

                        <% if (order.designNotes) { %>
                            <div class="mt-3 pt-2 border-top border-secondary fs-12">
                                <strong>Design Notes:</strong> <%= order.designNotes %>
                            </div>
                        <% } %>
                    </div>
                </td>

                <!-- Rate Column -->
                <td class="text-end align-top">
                    <% (order.items || []).forEach(item => { %>
                        <div class="mb-3 fw-semibold"><%= (item.price || 0).toLocaleString() %></div>
                    <% }) %>
                </td>

                <!-- Amount Column -->
                <td class="text-end align-top">
                    <% (order.items || []).forEach(item => { %>
                        <div class="mb-3 fw-bold"><%= (item.subtotal || 0).toLocaleString() %></div>
                    <% }) %>
                </td>
            </tr>

            <!-- Totals Rows -->
            <tr class="totals-row">
                <td colspan="2" class="border-0"></td>
                <td class="text-center bg-light fw-bold">Total</td>
                <td class="text-end fw-bold">Rs. <%= (order.totalAmount || 0).toLocaleString() %></td>
            </tr>
            <tr class="totals-row">
                <td colspan="2" class="border-0"></td>
                <td class="text-center bg-light fw-bold">Advance</td>
                <td class="text-end text-success fw-bold">Rs. <%= (order.advancePayment || 0).toLocaleString() %></td>
            </tr>
            <tr class="totals-row">
                <td colspan="2" class="border-0"></td>
                <td class="text-center bg-light fw-bold">Balance</td>
                <td class="text-end text-danger fw-bold fs-14">Rs. <%= (order.balanceAmount || 0).toLocaleString() %></td>
            </tr>
        </tbody>
    </table>

    <!-- Hardcoded Terms & Conditions Note (Exact wording from receipt image) -->
    <div class="mt-3 pt-2 border-top border-dark fs-11" style="line-height: 1.4;">
        <strong>NOTE:</strong> We don't accept any responsibility if the garments are damaged or lost in case the delivery is not take within one month from the date of order.<br>
        we are not responsible for delay in work due to unavoidable circumstances.<br>
        Once order booked cannot be cancelled. If cancelled 20% will be charged.
    </div>

    <!-- Signatures -->
    <div class="d-flex justify-content-between align-items-end mt-4 pt-3 fw-bold fs-12">
        <div>Customer's Signature ______________________</div>
        <div>Signature ______________________</div>
    </div>
</div>

</body>
</html>
