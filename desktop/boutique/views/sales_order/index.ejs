<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="ri-cut-line text-warning me-2"></i>Boutique Orders Dashboard</h3>
            <p class="text-muted mb-0">Manage measurement bookings, embroidery pipeline, status tracking, and fulfillments.</p>
        </div>
        <div>
            <a href="/sales-orders/book" class="btn btn-success btn-lg shadow-sm">
                <i class="ri-add-line me-1"></i> Book New Order
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2 col-sm-4">
        <a href="/sales-orders?status=ALL" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-12 fw-bold text-uppercase opacity-75">Total Orders</span>
                        <i class="ri-folders-line fs-20"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-white"><%= stats.total %></h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2 col-sm-4">
        <a href="/sales-orders?status=BOOKED" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-12 fw-bold text-uppercase opacity-75">Booked</span>
                        <i class="ri-bookmark-line fs-20"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-white"><%= stats.booked %></h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2 col-sm-4">
        <a href="/sales-orders?status=IN_EMBROIDERY" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-12 fw-bold text-uppercase opacity-75">In Work</span>
                        <i class="ri-t-shirt-line fs-20"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark"><%= stats.inWork %></h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2 col-sm-4">
        <a href="/sales-orders?status=READY" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-12 fw-bold text-uppercase opacity-75">Ready for Pickup</span>
                        <i class="ri-checkbox-circle-line fs-20"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-white"><%= stats.ready %></h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2 col-sm-4">
        <a href="/sales-orders?status=FULFILLED" class="text-decoration-none">
            <div class="card border-0 shadow-sm bg-secondary text-white h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fs-12 fw-bold text-uppercase opacity-75">Fulfilled</span>
                        <i class="ri-shopping-bag-line fs-20"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-white"><%= stats.fulfilled %></h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fs-12 fw-bold text-uppercase opacity-75">Advance Paid</span>
                    <i class="ri-money-dollar-circle-line fs-20"></i>
                </div>
                <h4 class="fw-bold mb-0 text-white"><%= stats.totalAdvance.toLocaleString() %></h4>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="GET" action="/sales-orders" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="ri-search-line"></i></span>
                    <input type="text" name="search" class="form-control border-0 bg-light" placeholder="Search by Order # or Customer..." value="<%= searchQuery %>">
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select border-0 bg-light" onchange="this.form.submit()">
                    <option value="ALL" <%= currentStatus === 'ALL' ? 'selected' : '' %>>All Statuses</option>
                    <option value="BOOKED" <%= currentStatus === 'BOOKED' ? 'selected' : '' %>>Booked</option>
                    <option value="IN_EMBROIDERY" <%= currentStatus === 'IN_EMBROIDERY' ? 'selected' : '' %>>In Embroidery</option>
                    <option value="IN_STITCHING" <%= currentStatus === 'IN_STITCHING' ? 'selected' : '' %>>In Stitching</option>
                    <option value="READY" <%= currentStatus === 'READY' ? 'selected' : '' %>>Ready for Pickup</option>
                    <option value="FULFILLED" <%= currentStatus === 'FULFILLED' ? 'selected' : '' %>>Fulfilled (Sold)</option>
                    <option value="CANCELLED" <%= currentStatus === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-3 text-end">
                <a href="/sales-orders" class="btn btn-outline-secondary btn-sm">Reset Filters</a>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Order #</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Promised Delivery</th>
                        <th>Status</th>
                        <th>Total Amount</th>
                        <th>Advance Paid</th>
                        <th>Balance</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders.length === 0) { %>
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="ri-inbox-archive-line fs-36 d-block mb-2"></i>
                            No sales orders found matching criteria.
                        </td>
                    </tr>
                    <% } else { %>
                        <% orders.forEach(order => { %>
                        <tr>
                            <td class="ps-3 fw-bold">
                                <a href="/sales-orders/details/<%= order.id %>" class="text-primary text-decoration-none">
                                    <%= order.ordernum %>
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark"><%= order.customerName %></div>
                            </td>
                            <td><%= order.bookingDate ? new Date(order.bookingDate).toLocaleDateString() : '-' %></td>
                            <td>
                                <% if (order.deliveryDate) { %>
                                    <span class="fw-semibold text-dark"><%= new Date(order.deliveryDate).toLocaleDateString() %></span>
                                <% } else { %>
                                    <span class="text-muted">Not Set</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (order.status === 'BOOKED') { %>
                                    <span class="badge bg-info-subtle text-info px-2 py-1"><i class="ri-bookmark-line me-1"></i>Booked</span>
                                <% } else if (order.status === 'IN_EMBROIDERY') { %>
                                    <span class="badge bg-warning-subtle text-warning px-2 py-1"><i class="ri-magic-line me-1"></i>In Embroidery</span>
                                <% } else if (order.status === 'IN_STITCHING') { %>
                                    <span class="badge bg-primary-subtle text-primary px-2 py-1"><i class="ri-scissors-line me-1"></i>In Stitching</span>
                                <% } else if (order.status === 'READY') { %>
                                    <span class="badge bg-success-subtle text-success px-2 py-1"><i class="ri-checkbox-circle-line me-1"></i>Ready for Pickup</span>
                                <% } else if (order.status === 'FULFILLED') { %>
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1"><i class="ri-check-double-line me-1"></i>Fulfilled</span>
                                <% } else { %>
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1"><%= order.status %></span>
                                <% } %>
                            </td>
                            <td class="fw-bold"><%= (order.totalAmount || 0).toLocaleString() %></td>
                            <td class="text-success fw-semibold"><%= (order.advancePayment || 0).toLocaleString() %></td>
                            <td class="text-danger fw-bold"><%= (order.balanceAmount || 0).toLocaleString() %></td>
                            <td class="text-end pe-3">
                                <div class="btn-group">
                                    <a href="/sales-orders/details/<%= order.id %>" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="ri-eye-line"></i> View
                                    </a>
                                    <a href="/sales-orders/job-ticket/<%= order.id %>" target="_blank" class="btn btn-sm btn-outline-dark" title="Print Workshop Slip">
                                        <i class="ri-printer-line"></i> Ticket
                                    </a>
                                    <% if (order.status !== 'FULFILLED' && order.status !== 'CANCELLED') { %>
                                        <a href="/sales/form?salesorder_id=<%= order.id %>" class="btn btn-sm btn-success" title="Fulfill & Generate Invoice">
                                            <i class="ri-shopping-bag-line me-1"></i> Fulfill
                                        </a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
