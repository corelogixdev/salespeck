<%- contentFor('body') %>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0"><%= title %></h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="/accounting/coa">Accounting</a></li>
                    <li class="breadcrumb-item active"><%= title %></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Historical Cash Closings</h5>
                <a href="/accounting/cash-closing" class="btn btn-primary btn-sm">
                    <i class="ri-add-line align-bottom me-1"></i> Perform New Cash Closing
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date & Time</th>
                                <th class="text-end">Actual Cash Balance (Rs.)</th>
                                <th>Notes / Remarks</th>
                                <th>Performed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (closings && closings.length > 0) { %>
                                <% closings.forEach(function(closing) { %>
                                    <tr>
                                        <td><%= new Date(closing.date).toLocaleString() %></td>
                                        <td class="text-end fw-bold text-primary"><%= closing.closingbalance ? closing.closingbalance.toLocaleString(undefined, {minimumFractionDigits: 2}) : '0.00' %></td>
                                        <td><%= closing.note || '-' %></td>
                                        <td><span class="badge bg-secondary-subtle text-secondary"><%= closing.fk_user_in_cashclosing || 'System' %></span></td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="text-center">No cash closing records found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
