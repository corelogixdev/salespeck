{
  "name": "openmenu",
  "description": "OpenMenu for POS,Stocks and Invoicing.",
  "version": "1.0.7",
  "private": "true",
  "main": "main.js",
  "scripts": {
    "start:electron": "electron .",
    "dev": "nodemon --exec \"electron .\"",
    "prisma:pull": "prisma db pull",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed-must-data.js",
    "prisma:seed:must": "node prisma/seed-must-data.js",
    "prisma:seed:test-small": "node prisma/test-small-data-seed.js",
    "prisma:seed:test-large": "node prisma/test-large-data-seed.js",
    "prisma:bootstrap": "node scripts/prisma-bootstrap.js",
    "prebuild": "prisma generate",
    "build": "electron-builder",
    "postbuild": "rimraf dist/win-unpacked",
    "upload": "node build/upload.js",
    "test-local-installed-update": "node test-local-installed-update.js",
  },
  "build": {
    "appId": "io.openmenu.app",
    "productName": "openmenu",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/prisma/**",
      "node_modules/@prisma/**",
      "prisma/**"
    ],
    "files": [
      "assets/**/*",
      "build/**/*",
      "config/**/*",
      "controllers/**/*",
      "generated/**/*",
      "middleware/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/prisma/**/*",
      "routes/**/*",
      "scripts/**/*",
      "server/**/*",
      "utils/**/*",
      "views/**/*",
      "prisma/**/*",
      "prisma.config.ts",
      "installEnv.js",
      "main.js",
      "preload.js",
      ".env"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitlab.com/api/v4/projects/62990895/packages/generic/openmenu/release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "requestExecutionLevel": "admin"
    },
    "mac": {
      "target": []
    },
    "linux": {
      "target": []
    }
  },
  "license": "MIT",
  "author": "Atta Rasul",
  "dependencies": {
    "@prisma/adapter-libsql": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@prisma/client-runtime-utils": "^7.7.0",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "prisma": "^7.7.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-reload": "^1.5.0",
    "nodemon": "^3.1.7",
    "rimraf": "^6.0.1"
  }
}
