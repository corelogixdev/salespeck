<div class="flex-grow-1">
  <h4 class="fs-16 mb-1">Good Morning, <%= user.firstname + " " + user.lastname %>!</h4>
  <p class="text-muted mb-0">Here's what's happening with your store
      today.</p>
</div>
<div class="row my-3">
  <div class="col-lg-4">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1 overflow-hidden">
            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">
              Today's Sales
            </p>
          </div>
          <div class="flex-shrink-0">
            <% if (salesArrowDirection === 'up') { %>
            <h5 class="text-success fs-14 mb-0">
              <i class="ri-arrow-right-up-line fs-13 align-middle"></i>
              +<%= salesPercentageChange %> %
            </h5>
            <% } else { %>
            <h5 class="text-danger fs-14 mb-0">
              <i class="ri-arrow-right-down-line fs-13 align-middle"></i>
              <%= salesPercentageChange %> %
            </h5>                  
            <% } %>
          </div>
        </div>
        <div class="d-flex align-items-end justify-content-between mt-4">
          <div>
            <h4 class="fs-22 fw-semibold ff-secondary mb-4">
              Rs.<span class="counter-value" data-target="<%= todaysSalesAmount %>">
                <%= todaysSalesAmount %>
              </span>
            </h4>
            <a href="/sales" class="text-decoration-underline text-muted">View Sales</a>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-success-subtle rounded fs-3">
              <span class="text-success fs-5">PKR</span>
            </span>
          </div>
        </div>
      </div><!-- end card body -->
    </div><!-- end card -->
  </div>

  <div class="col-lg-4">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1 overflow-hidden">
            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">
              Today's Customers
            </p>
          </div>
          <div class="flex-shrink-0">
            <% if (customerArrowDirection === 'up') { %>
            <h5 class="text-success fs-14 mb-0">
              <i class="ri-arrow-right-up-line fs-13 align-middle"></i>
              +<%= customerPercentageChange %> %
            </h5>
            <% } else { %>
            <h5 class="text-danger fs-14 mb-0">
              <i class="ri-arrow-right-down-line fs-13 align-middle"></i>
              <%= customerPercentageChange %> %
            </h5>
            <% } %>
          </div>
        </div>
        <div class="d-flex align-items-end justify-content-between mt-4">
          <div>
            <h4 class="fs-22 fw-semibold ff-secondary mb-4">
              <span class="counter-value" data-target="<%= todayCustomersCount %>">
                <%= todayCustomersCount %>
              </span>
            </h4>
            <a href="/users?role=customer" class="text-decoration-underline text-muted">View Customers</a>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-success-subtle rounded fs-1">
              <i class="bx bx-user-plus fs-3 text-success"></i>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1 overflow-hidden">
            <p class="text-uppercase fw-medium text-muted text-truncate mb-0">
              Total Sales
            </p>
          </div>
        </div>
        <div class="d-flex align-items-end justify-content-between mt-4">
          <div>
            <h4 class="fs-22 fw-semibold ff-secondary mb-4">
              <span class="counter-value" data-target="<%= totalSalesCount %>">
                <%= totalSalesCount %>
              </span>
            </h4>
            <a href="/sales" class="text-decoration-underline text-muted">View Sales</a>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-success-subtle rounded fs-3">
              <i class="bx bx-cart fs-2 text-success"></i>
            </span>
          </div>
        </div>
      </div><!-- end card body -->
    </div><!-- end card -->
  </div>

</div>
<!-- Charts Row -->
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <div id="barChart"></div>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <div id="usersChart"></div>
      </div>
    </div>
  </div>
</div>

<script>
  let topProducts = <%- JSON.stringify(topFiveSoldProductsWithSoldQuantity) %>;
  let topProducts_chartData = {
    labels: [],
    data: []
  };
  for (let i = 0; i < 5; i++) {
    topProducts_chartData.labels.push(topProducts[i]?.product_name || '');
    topProducts_chartData.data.push(topProducts[i]?.total_quantity || 0);
  }

  let months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  let totalSales = <%- JSON.stringify(salesCountByMonth) %>;
  let totalSales_chartData = months.reduce((acc, month, index) => {
    let monthNumber = (index + 1).toString().padStart(2, '0');
    acc.labels.push(month);
    let sales = totalSales.find(sale => sale.month === monthNumber);
    acc.data.push(sales?.total || 0);
    return acc;
  }, {
    labels: [],
    data: []
  });
  document.addEventListener('DOMContentLoaded', () => {
    const topProductsSales = document.getElementById('barChart')
    const monthSaleGraph = document.getElementById('usersChart')

    const topProductsSalesChart = new ApexCharts(topProductsSales, {
      chart: {
        type: 'bar',
        height: 350
      },
      series: [{
        name: 'Quantity',
        data: topProducts_chartData.data
      }],
      xaxis: {
        categories: topProducts_chartData.labels
      },
      colors: ['#7084C7'],
      plotOptions: {
        bar: {
          horizontal: true
        }
      }
    });

    const monthSaleGraphChart = new ApexCharts(monthSaleGraph, {
      chart: {
        type: 'line',
        height: 350
      },
      series: [{
        name: 'Sales',
        data: totalSales_chartData.data
      }],
      xaxis: {
        categories: totalSales_chartData.labels
      },
      colors: ['#7084C7'],
      menubar: false
    });

    topProductsSalesChart.render();
    monthSaleGraphChart.render();
  });
</script>
<style>
  .apexcharts-zoomin-icon,
  .apexcharts-zoomout-icon,
  .apexcharts-zoom-icon,
  .apexcharts-pan-icon,
  .apexcharts-reset-icon {
    display: none !important;
  }
</style>