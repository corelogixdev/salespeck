<h4 class="text-secondary">Welcome <%= user.name %>, <span class="text-success">
      <%= company.name %>
    </span></h4>
<div class="row my-3">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h5 class="text-secondary">Today's Sales</h5>
            <h3 class="text-success">
              <%= todaySalesCount %>
            </h3>
          </div>
          <div class="icon">
            <i class="fas fa-shopping-cart fa-3x text-success"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- today customers -->

  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h5 class="text-secondary">Today's Customers</h5>
            <h3 class="text-success">
              <%= todayCustomersCount %>
            </h3>
          </div>
          <div class="icon">
            <i class="fas fa-users fa-3x text-success"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- total sales -->

  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h5 class="text-secondary">Total Sales</h5>
            <h3 class="text-success">
              <%= totalSalesCount %>
            </h3>
          </div>
          <div class="icon">
            <i class="fas fa-chart-line fa-3x text-success"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
<!-- Charts Row -->
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <canvas id="barChart"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <canvas id="usersChart"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
  let topProducts = <%- JSON.stringify(topFiveSoldProductsWithSoldQuantity) %>;
  let topProducts_chartData = topProducts.reduce((acc, product) => {
    acc.labels.push(product?.product_name || 'Unknown');
    acc.data.push(product?.total_quantity || 0);
    return acc;
  }, {
    labels: [],
    data: []
  });

  let months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  let totalSales = <%- JSON.stringify(salesCountByMonth) %>;
  let totalSales_chartData = months.reduce((acc, month, index) => {
    let monthNumber = (index+1).toString().padStart(2, '0');
    acc.labels.push(month);
    let sales = totalSales.find(sale => sale.month === monthNumber);
    acc.data.push(sales?.total || 0);
    return acc;
  }, {
    labels: [],
    data: []
  });

  document.addEventListener('DOMContentLoaded', () => {
    const topProductsSales = document.getElementById('barChart').getContext('2d');
    const monthSaleGraph = document.getElementById('usersChart').getContext('2d');

    const topProductsSalesChart = new Chart(topProductsSales, {
      type: 'bar',
      data: {
        labels: topProducts_chartData.labels,
        datasets: [{
          label: 'Top Products Sales',
          data: topProducts_chartData.data,
          backgroundColor: [
            'rgba(255, 99, 132, 0.2)',
            'rgba(54, 162, 235, 0.2)',
            'rgba(255, 206, 86, 0.2)',
            'rgba(75, 192, 192, 0.2)',
            'rgba(153, 102, 255, 0.2)'
          ],
          borderColor: [
            'rgba(255, 99, 132, 1)',
            'rgba(54, 162, 235, 1)',
            'rgba(255, 206, 86, 1)',
            'rgba(75, 192, 192, 1)',
            'rgba(153, 102, 255, 1)'
          ],
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        }
      }
    });
   
    const monthSaleGraphChart = new Chart(monthSaleGraph, {
      type: 'line',
      data: {
        labels: totalSales_chartData.labels,
        datasets: [{
          label: 'Monthly Sales',
          data: totalSales_chartData.data,
          backgroundColor: [
            'rgba(255, 99, 132, 0.2)',
          ],
          borderColor: [
            'rgba(255, 99, 132, 1)',
          ],
          borderWidth: 1
        }]
      },
      options: {
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  });
</script>