<div class="auth-bg">
    <div class="auth-page-wrapper">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div class="card mt-4 card-bg-fill">
                        <div class="card-body p-4">
                            <div class="text-center">
                                <img src="/assets/images/icon.png" alt="" height="100" class="mb-1">
                                <h3 class="text-primary mb-3">Welcome Back!</h3>
                                <p class="text-muted">Sign in to continue to OpenMenu.</p>
                            </div>
                            <div class="p-2">
                                <form action="/login" method="post">
                                    <div class="mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <div class="position-relative auth-pass-inputgroup">
                                            <input type="email" 
                                                   class="form-control pe-5 <%= locals.errors?.email ? 'is-invalid' : '' %>" 
                                                   id="email" 
                                                   name="email" 
                                                   value="ranamuaviya127@gmail.com"
                                                   placeholder="Enter email" 
                                                   required>
                                            <% if (locals.errors?.email) { %>
                                                <div class="invalid-feedback"><%= errors.email %></div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="password">Password</label>
                                        <div class="position-relative auth-pass-inputgroup">
                                            <input type="password" 
                                                    value="emir@123"
                                                   class="form-control pe-5 <%= locals.errors?.password ? 'is-invalid' : '' %>" 
                                                   id="password"
                                                   name="password" 
                                                   placeholder="Enter password" 
                                                   autocomplete="on"
                                                   required>
                                            <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted" 
                                                   type="button" 
                                                   onclick="togglePassword(this)">
                                                <i class="ri-eye-fill align-middle"></i>
                                            </button>
                                            <% if (locals.errors?.password) { %>
                                                <div class="invalid-feedback"><%= errors.password %></div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="mt-4">
                                        <button class="btn btn-primary w-100" type="submit">
                                            <i class="ri-login-box-line align-middle me-1"></i> Sign In
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="mt-3">
                                <div class="row">
                                    <div class="col-6 text-start">
                                        <p class="mb-0 text-muted">
                                            Powered by <a href="javascript:void(0);" class="fw-semibold text-primary text-decoration-underline">OpenMenu</a>
                                        </p>
                                    </div>
                                    <div class="col-6 text-end">
                                        <p class="mb-0 text-muted">
                                            Don't have an account? <a href="/register" class="fw-semibold text-primary text-decoration-underline">Register</a>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(button) {
            const input = button.parentElement.querySelector('input');
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('ri-eye-fill');
                icon.classList.add('ri-eye-off-fill');
            } else {
                input.type = 'password';
                icon.classList.remove('ri-eye-off-fill');
                icon.classList.add('ri-eye-fill');
            }
        }
    </script>
</div>