<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Brands</h4>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addBrandModal">
                        <i class="bx bx-plus me-1"></i> Add Brand
                    </button>
                    <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
                        <i class="ri-refresh-line align-middle"></i> Refresh
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Search Form -->
                <form method="GET" action="/brands" class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="search-box">
                            <input type="text" class="form-control search" name="name_like" 
                                placeholder="Search by brand name..." value="<%= query.name_like || '' %>">
                            <i class="ri-search-line search-icon"></i>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <select class="form-select" name="status">
                            <option value="">All Status</option>
                            <option value="1" <%= query.status === '1' ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= query.status === '0' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <div class="col-md-5 d-flex align-items-center justify-content-end">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="ri-search-line me-1 align-bottom"></i> Search
                            </button>
                            <% if (query.name_like || query.status) { %>
                                <a href="/brands" class="btn btn-danger btn-sm">
                                    <i class="ri-close-line align-bottom me-1"></i> Clear
                                </a>
                            <% } %>
                        </div>
                    </div>
                </form>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Status</th>
                                <th scope="col" style="text-align: end;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!brands || brands.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <i class="ri-error-warning-line align-middle me-1"></i> No data found
                                    </td>
                                </tr>
                            <% } else { %>
                                <% brands.forEach(brand => { %>
                                    <tr>
                                        <td class="fw-medium"><%= brand.name %></td>
                                        <td><%= brand.description || '-' %></td>
                                        <td>
                                            <span class="badge bg-<%= brand.status ? 'success' : 'danger' %>">
                                                <%= brand.status ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td style="text-align: end;">
                                            <button type="button" onclick="editBrand('<%= brand.id %>')" class="btn btn-soft-warning btn-sm">
                                                <i class="ri-pencil-fill align-middle"></i> Edit
                                            </button>
                                            <button type="button" onclick="deleteBrand('<%= brand.id %>')" class="btn btn-soft-danger btn-sm">
                                                <i class="ri-delete-bin-fill align-middle"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Enhanced Pagination -->
                <% if (pagination && pagination.totalPages > 0) { %>
                    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
                        <!-- Records Info -->
                        <div class="text-muted">
                            Showing <strong><%= pagination.startRecord %></strong> to 
                            <strong><%= pagination.endRecord %></strong> of 
                            <strong><%= pagination.totalCount %></strong> entries
                        </div>

                        <!-- Page Size Selector -->
                        <div class="d-flex align-items-center gap-2">
                            <label for="pageSize" class="text-muted mb-0">Show:</label>
                            <select id="pageSize" class="form-select form-select-sm" style="width: 80px;"
                                onchange="(function() { const params = new URLSearchParams(window.location.search); params.set('page', 1); params.set('pageSize', this.value); window.location.href = '/brands?' + params.toString(); }).call(this)">
                                <option value="10" <%= (pagination.pageSize || 10) == 10 ? 'selected' : '' %>>10</option>
                                <option value="25" <%= (pagination.pageSize || 10) == 25 ? 'selected' : '' %>>25</option>
                                <option value="50" <%= (pagination.pageSize || 10) == 50 ? 'selected' : '' %>>50</option>
                                <option value="100" <%= (pagination.pageSize || 10) == 100 ? 'selected' : '' %>>100</option>
                                <option value="200" <%= (pagination.pageSize || 10) == 200 ? 'selected' : '' %>>200</option>
                                <option value="500" <%= (pagination.pageSize || 10) == 500 ? 'selected' : '' %>>500</option>
                                <option value="1000" <%= (pagination.pageSize || 10) == 1000 ? 'selected' : '' %>>1000</option>
                                <option value="9999" <%= (pagination.pageSize || 10) == 9999 ? 'selected' : '' %>>All</option>
                            </select>
                        </div>

                        <!-- Pagination Controls -->
                        <% if (pagination.totalPages > 1) { %>
                            <nav aria-label="Page navigation">
                                <ul class="pagination mb-0">
                                    <!-- First Page -->
                                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="<%= pagination.currentPage === 1 ? '#' : '/brands?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + (pagination.pageSize ? 'pageSize=' + pagination.pageSize + '&' : '') + 'page=1' %>" title="First">
                                            <i class="ri-arrow-left-double-line"></i>
                                        </a>
                                    </li>
                                    
                                    <!-- Previous Page -->
                                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-link" href="<%= pagination.currentPage === 1 ? '#' : '/brands?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + (pagination.pageSize ? 'pageSize=' + pagination.pageSize + '&' : '') + 'page=' + (pagination.currentPage - 1) %>" title="Previous">
                                            <i class="mdi mdi-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    <!-- Page Numbers -->
                                    <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                                        <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                                            <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                                <a class="page-link" href="/brands?<%= query.name_like ? 'name_like=' + query.name_like + '&' : '' %><%= query.status ? 'status=' + query.status + '&' : '' %><%= pagination.pageSize ? 'pageSize=' + pagination.pageSize + '&' : '' %>page=<%= i %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } else if (i === 2 || i === pagination.totalPages - 1) { %>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                        <% } %>
                                    <% } %>
                                    
                                    <!-- Next Page -->
                                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/brands?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + (pagination.pageSize ? 'pageSize=' + pagination.pageSize + '&' : '') + 'page=' + (pagination.currentPage + 1) %>" title="Next">
                                            <i class="mdi mdi-chevron-right"></i>
                                        </a>
                                    </li>
                                    
                                    <!-- Last Page -->
                                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                                        <a class="page-link" href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/brands?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + (pagination.pageSize ? 'pageSize=' + pagination.pageSize + '&' : '') + 'page=' + pagination.totalPages %>" title="Last">
                                            <i class="ri-arrow-right-double-line"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Add Brand Modal -->
<div class="modal fade" id="addBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addBrandForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="brandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brandName" name="name" required>
                        <div class="invalid-feedback">Please enter brand name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="brandDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="brandDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="statusActive" value="1" checked>
                                <label class="form-check-label" for="statusActive">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="statusInactive" value="0">
                                <label class="form-check-label" for="statusInactive">Inactive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveBrand()">Save Brand</button>
            </div>
        </div>
    </div>
</div>

<!--Edit Brand Modal -->
<div class="modal fade" id="editBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editBrandForm" class="needs-validation" novalidate>
                    <input type="hidden" id="editBrandId" name="id">
                    <div class="mb-3">
                        <label for="editBrandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editBrandName" name="name" required>
                        <div class="invalid-feedback">Please enter brand name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="editBrandDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editBrandDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="editStatusActive" value="1">
                                <label class="form-check-label" for="editStatusActive">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="editStatusInactive" value="0">
                                <label class="form-check-label" for="editStatusInactive">Inactive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="updateBrand()">Update Brand</button>
            </div>
        </div>
    </div>
</div>

<style>
    .search-box {
        position: relative;
    }

    .search-box .search-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: var(--vz-gray-600);
    }

    .search-box .form-control {
        padding-left: 35px;
        background-color: var(--vz-card-bg-custom);
        border-color: var(--vz-border-color);
    }

    .search-box .form-control:focus {
        border-color: var(--vz-primary);
    }
</style>

<script>
    // Save brand
    function saveBrand() {
        const form = document.getElementById('addBrandForm');
        if (form.checkValidity()) {
            const data = {
                name: document.getElementById('brandName').value,
                description: document.getElementById('brandDescription').value,
                status: document.querySelector('input[name="status"]:checked').value
            };

            fetch('/brands/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        toastr.success(data.message || 'Brand created successfully');
                        // Close modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('addBrandModal'));
                        if (modal) modal.hide();
                        // Reload after toast
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toastr.error(data.message || 'Error saving brand');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    toastr.error('Failed to save brand');
                });
        } else {
            form.classList.add('was-validated');
        }
    }

    // Edit brand
    function editBrand(id) {
        fetch(`/brands/${id}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const brand = data.brand;
                    document.getElementById('editBrandId').value = brand.id;
                    document.getElementById('editBrandName').value = brand.name;
                    document.getElementById('editBrandDescription').value = brand.description || '';

                    if (brand.status == 1) {
                        document.getElementById('editStatusActive').checked = true;
                    } else {
                        document.getElementById('editStatusInactive').checked = true;
                    }

                    const modal = new bootstrap.Modal(document.getElementById('editBrandModal'));
                    modal.show();
                }
            })
            .catch(error => console.error('Error:', error));
    }

    // Update brand
    function updateBrand() {
        const form = document.getElementById('editBrandForm');
        if (form.checkValidity()) {
            const id = document.getElementById('editBrandId').value;
            const data = {
                id: id,
                name: document.getElementById('editBrandName').value,
                description: document.getElementById('editBrandDescription').value,
                status: document.querySelector('#editBrandForm input[name="status"]:checked').value
            };

            fetch('/brands/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        toastr.success(data.message || 'Brand updated successfully');
                        // Close modal
                        const modal = bootstrap.Modal.getInstance(document.getElementById('editBrandModal'));
                        if (modal) modal.hide();
                        // Reload after toast
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        toastr.error(data.message || 'Error updating brand');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    toastr.error('Failed to update brand');
                });
        } else {
            form.classList.add('was-validated');
        }
    }

    // Delete brand
    function deleteBrand(id) {
        $.confirm({
            title: 'Delete Brand',
            content: 'Are you sure you want to delete this brand?',
            type: 'red',
            typeAnimated: true,
            buttons: {
                delete: {
                    text: 'Delete',
                    btnClass: 'btn-danger',
                    action: function() {
                        fetch('/brands/delete', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ id: id })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    toastr.success(data.message || 'Brand deleted successfully');
                                    setTimeout(() => window.location.reload(), 1000);
                                } else {
                                    toastr.error(data.message || 'Error deleting brand');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                toastr.error('Failed to delete brand');
                            });
                    }
                },
                cancel: {
                    text: 'Cancel',
                    btnClass: 'btn-secondary'
                }
            }
        });
    }
</script>