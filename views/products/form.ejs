<div class="page_header d-flex justify-content-between align-items-center mb-3">
  <h3><%= title %></h3>
</div>
<div class="card">
  <div class="card-body">
    <form id="form">
      <% if (product) { %>
        <input type="hidden" name="id" value="<%= product.id %>">
      <% } %>
      <div class="row">
        <div class="col-lg-6">
          <div class="form-group">
            <label for="name" class="form-label">Name:</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= product ? product.name : '' %>" required>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="barcode" class="form-label">Barcode:</label>
            <input type="text" class="form-control" id="barcode" name="barcode" value="<%= product ? product.barcode : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="category" class="form-label">Category:</label>
            <input type="text" class="form-control" id="category" name="category" value="<%= product ? product.category : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="carrycost" class="form-label">Carry Cost:</label>
            <input type="number" step="0.01" class="form-control" id="carrycost" name="carrycost" value="<%= product ? product.carrycost : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="discount" class="form-label">Discount:</label>
            <input type="number" step="0.01" class="form-control" id="discount" name="discount" value="<%= product ? product.discount : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="purchaseprice" class="form-label">Purchase Price:</label>
            <input type="number" step="0.01" class="form-control" id="purchaseprice" name="purchaseprice" value="<%= product ? product.purchaseprice : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="purchaseactive" class="form-check-label">Purchase Active:</label>
            <input type="checkbox" class="form-check" id="purchaseactive" name="purchaseactive" <%= product && product.purchaseactive ? 'checked' : '' %>>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="quantity" class="form-label">Quantity:</label>
            <input type="number" step="0.01" class="form-control" id="quantity" name="quantity" value="<%= product ? product.quantity : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="saleprice" class="form-label">Sale Price:</label>
            <input type="number" step="0.01" class="form-control" id="saleprice" name="saleprice" value="<%= product ? product.saleprice : '' %>">
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-group">
            <label for="saleactive" class="form-check-label">Sale Active:</label>
            <input type="checkbox" class="form-check" id="saleactive" name="saleactive" <%= product && product.saleactive ? 'checked' : '' %>>
          </div>
        </div>
      </div>
      <button type="submit" class="btn btn-primary mt-3">
        <%= product ? 'Update' : 'Create' %>
      </button>
    </form>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('form').addEventListener('submit', async (event) => {
      event.preventDefault();
      document.querySelectorAll('input').forEach(input => {
        input.style.borderColor = '';
      });
      const name = document.getElementById('name').value;
      if (name.length < 2) {
        document.getElementById('name').style.borderColor = 'red';
        return;
      }
      const formData = new FormData(event.target);
      const data = Object.fromEntries(formData.entries());
      try {
        const response = await fetch('/products/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (result.success) {
          $.alert({
            title: 'Success!',
            content: result.message,
            type: 'green',
            theme: 'modern',
            buttons: {
              ok: function () {
                $('#form').trigger('reset');
              },
            },
          });
        } else {
          $.alert({
            title: 'Error!',
            content: result.message,
            type: 'red',
            theme: 'modern',
          });
        }
      } catch (error) {
        $.alert({
          title: 'Error!',
          content: 'An error occurred while saving the product.',
          type: 'red',
          theme: 'modern',
        });
      }
    });
  });
</script>