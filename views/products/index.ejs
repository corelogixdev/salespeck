<div class="page_header d-flex justify-content-between align-items-center mb-3">
  <h3>
    <%= title %>
  </h3>
  <div>
    <a href="/products/form" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Products</a>
  </div>
</div>
<style>
  td{
    background-color: inherit !important;
  }
  .limit-text {
    width: 100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
<div class="card">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Barcode</th>
          <th>Name</th>
          <th>Category</th>
          <th>Carry Cost</th>
          <th>Discount</th>
          <th>Purchase Price</th>
          <th>Purchase Active</th>
          <th>Quantity</th>
          <th>Sale Price</th>
          <th>Sale Active</th>
          <!-- align at end -->
          <th style="text-align: end;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(product => { %>
          <!-- make the tr red if the quantitiy is zero or make it yellow if the quantity is less then 10 -->
          <!-- <tr> -->
            <tr data-bg="<%- product.quantity === 0 ? 'rgb(255, 106, 106)' : product.quantity < 10 ? 'rgb(247, 247, 144)' : '' %>">
            <td><%= product.id %></td>
            <td><%= product.barcode %></td>
            <td class="limit-text" title="<%= product.name %>"><%= product.name %></td>
            <td><%= product.category %></td>
            <td><%= product.carrycost %></td>
            <td><%= product.discount %></td>
            <td><%= product.purchaseprice %></td>
            <td><%= product.purchaseactive ? 'Yes' : 'No' %></td>
            <td><%= product.quantity %></td>
            <td><%= product.saleprice %></td>
            <td><%= product.saleactive ? 'Yes' : 'No' %></td>
            <td style="text-align: end;">
              <a href="/products/form?id=<%= product.id %>" class="btn btn-warning btn-sm" title="Edit Product">
                <i class="fas fa-edit"></i>
              </a>
              <form onsubmit="event.preventDefault(); deleteProduct('<%- product.id %>')" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm" title="Delete Product">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<script>
    $(document).ready(function () {
      $('tr[data-bg]').each(function () {
        const bgColor = $(this).data('bg'); // Get the data-bg attribute
        if (bgColor) {
          $(this).css('background-color', bgColor); // Apply the background color
        }
      });
    });

  async function deleteProduct(id) {
    $.alert({
      title: 'Confirm!',
      content: 'Are you sure you want to delete this product?',
      theme: 'material',
      useBootstrap: false,
      boxWidth: '30%',
      buttons: {
        confirm: {
          text: 'Yes',
          btnClass: 'btn-danger',
          action: async function () {
            const response = await fetch(`/products/${id}/delete`, {
              method: 'POST',
            });
            let result = await response.json();
            if (result.success) {
              $.alert({
                title: 'Success!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'green',
                buttons: {
                  confirm: {
                    text: 'OK',
                    btnClass: 'btn-primary',
                    action: function () {
                      window.location.href = result.redirectUrl;
                    }
                  }
                }
              });
            } else {
              $.alert({
                title: 'Error!',
                boxWidth: '30%',
                content: result.message,
                theme: 'material',
                useBootstrap: false,
                type: 'red',
              });
            }
          }
        },
        cancel: {
          text: 'No',
          btnClass: 'btn-primary',
        }
      }
    });
  }
</script>