<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1"><%= title %></h4>
        <div class="d-flex gap-2">
          <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
            <i class="ri-refresh-line align-middle"></i> Refresh
          </button>
        </div>
      </div>
      <div class="card-body">
        <div class="live-preview">
          <!-- Search Form -->
           <% if (permissions.productsSearch) { %>
            <form id="searchForm" method="POST" action="/products" class="row g-3 mb-4">
              <div class="col-xxl-3 col-sm-4">
                <div class="search-box">
                  <input type="text" 
                         class="form-control search" 
                         name="name"
                         placeholder="Search by product name..."
                         value="<%= searchParams?.name || '' %>">
                  <i class="ri-shopping-basket-2-line search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-3 col-sm-3">
                <div class="search-box">
                  <input type="text" 
                         class="form-control search" 
                         name="barcode"
                         placeholder="Search by barcode..."
                         value="<%= searchParams?.barcode || '' %>">
                  <i class="ri-barcode-line search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-3 col-sm-3">
                <div class="search-box">
                  <input type="text" 
                         class="form-control search" 
                         name="category"
                         placeholder="Search by category..."
                         value="<%= searchParams?.category || '' %>">
                  <i class="ri-list-check-2 search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-2 col-sm-2 d-flex align-items-center justify-content-end">
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">
                    <i class="ri-search-line me-1 align-bottom"></i> Search
                  </button>
                  <% if (searchParams?.name || searchParams?.barcode || searchParams?.category) { %>
                    <a href="/products" class="btn btn-sm btn-danger">
                      <i class="ri-close-line align-bottom me-1"></i> Clear
                    </a>
                  <% } %>
                </div>
              </div>
            </form>
           <% } %>
        

          <!-- Table -->
          <div class="table-responsive">
            <table class="table table-striped table-nowrap align-middle mb-0">
              <thead>
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Barcode</th>
                  <th scope="col">Name</th>
                  <th scope="col">Category</th>
                  <th scope="col">Discount</th>
                  <th scope="col">Purchase Price</th>
                  <th scope="col">Purchase Active</th>
                  <th scope="col">Quantity</th>
                  <th scope="col">Sale Price</th>
                  <th scope="col">Sale Active</th>
                  <% if (permissions.productsUpdate || permissions.productsView ) { %>
                    <th scope="col" style="text-align: end;">Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% if (!data || data.length === 0) { %>
                  <tr>
                    <td colspan="11" class="text-center">
                      <i class="ri-error-warning-line align-middle me-1"></i> No products found
                    </td>
                  </tr>
                <% } else { %>
                  <% data.forEach(product => { %>
                    <tr data-bg="<%- product.quantity === 0 ? 'var(--vz-danger-bg-subtle)' : product.quantity < 10 ? 'var(--vz-warning-bg-subtle)' : '' %>">
                      <td class="fw-medium"><%= product.id %></td>
                      <td class="limit-text" title="<%= product.barcode %>"><%= product.barcode %></td>
                      <td class="limit-text" title="<%= product.name %>"><%= product.name %></td>
                      <td class="limit-text" title="<%= product.category %>"><%= product.category %></td>
                      <td><%= product.discount || 0 %>%</td>
                      <td>Rs.<%= product.purchaseprice %></td>
                      <td><span class="badge bg-<%= product.purchaseactive ? 'success' : 'danger' %>">
                        <%= product.purchaseactive ? 'Yes' : 'No' %>
                      </span></td>
                      <td><%= product.quantity %></td>
                      <td>Rs.<%= product.saleprice %></td>
                      <td><span class="badge bg-<%= product.saleactive ? 'success' : 'danger' %>">
                        <%= product.saleactive ? 'Yes' : 'No' %>
                      </span></td>
                      <% if (permissions.productsUpdate || permissions.productsView ) { %>
                        <td style="text-align: end;">
                          <% if (permissions.productsUpdate || permissions.productsView) { %>
                              <div class="dropdown" style="position: static !important;">
                                  <button class="btn btn-soft-secondary btn-sm dropdown-toggle" 
                                          type="button" 
                                          data-bs-toggle="dropdown" 
                                          aria-expanded="false">
                                      <i class="ri-more-2-fill"></i>
                                  </button>
                                  <ul class="dropdown-menu">
                                      <% if (permissions.productsUpdate) { %>
                                          <li>
                                              <a class="dropdown-item d-flex align-items-center" 
                                                 href="/products/quantity/form/<%= product.id %>" 
                                                 target="_blank">
                                                  <i class="ri-add-circle-line me-2 align-middle text-primary"></i>
                                                  Update Quantity
                                              </a>
                                          </li>
                                          <li>
                                              <a class="dropdown-item d-flex align-items-center" 
                                                 href="/inventorylogs/<%= product.id %>" 
                                                 target="_blank">
                                                  <i class="ri-history-line me-2 align-middle text-info"></i>
                                                  View Inventory Logs
                                              </a>
                                          </li>
                                          <li>
                                              <a class="dropdown-item d-flex align-items-center" 
                                                 href="/products/form?id=<%= product.id %>" 
                                                 target="_blank">
                                                  <i class="ri-pencil-fill me-2 align-middle text-warning"></i>
                                                  Edit Product
                                              </a>
                                          </li>
                                      <% } %>
                                      <% if (permissions.productsDelete) { %>
                                          <li>
                                              <a class="dropdown-item d-flex align-items-center" 
                                                 href="javascript:void(0);" 
                                                 onclick="deleteProduct('<%= product.id %>')">
                                                  <i class="ri-delete-bin-fill me-2 align-middle text-danger"></i>
                                                  Delete Product
                                              </a>
                                          </li>
                                      <% } %>
                                  </ul>
                              </div>
                          <% } %>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .limit-text {
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  tr[data-bg] td {
    background-color: inherit !important;
  }
  /* Add to existing styles */
  .dropdown-item {
      padding: 0.5rem 1rem;
  }
  .dropdown-item:hover {
      background-color: var(--vz-light);
  }
  .dropdown-menu {
      min-width: 150px;
  }
  /* Add search box styling */
  .search-box {
      position: relative;
  }
  .search-box .search-icon {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 18px;
      color: var(--vz-gray-600);
  }
  .search-box .form-control {
      padding-left: 35px;
      background-color: var(--vz-card-bg-custom);
      border-color: var(--vz-border-color);
  }
  .search-box .form-control:focus {
      border-color: var(--vz-primary);
  }
</style>

<script>
    $(document).ready(function () {
      $('tr[data-bg]').each(function () {
        const bgColor = $(this).data('bg'); // Get the data-bg attribute
        if (bgColor) {
          $(this).css('background-color', bgColor); // Apply the background color
        }
      });
    });

  async function deleteProduct(id) {
    $.alert({
      title: 'Confirm!',
      content: 'Are you sure you want to delete this product?',
      theme: 'material',
      useBootstrap: false,
      boxWidth: '30%',
      buttons: {
        confirm: {
          text: 'Yes',
          btnClass: 'btn-danger',
          action: async function () {
            const response = await fetch(`/products/${id}/delete`, {
              method: 'POST',
            });
            let result = await response.json();
            if (result.success === true) {
              $.alert({
                title: 'Success!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'green',
                buttons: {
                  confirm: {
                    text: 'OK',
                    btnClass: 'btn-primary',
                    action: function () {
                      window.location.href = result.redirectUrl;
                    }
                  }
                }
              });
            } else {
              $.alert({
                title: 'Error!',
                boxWidth: '30%',
                content: result.message,
                theme: 'material',
                useBootstrap: false,
                type: 'red',
              });
            }
          }
        },
        cancel: {
          text: 'No',
          btnClass: 'btn-primary',
        }
      }
    });
  }
</script>