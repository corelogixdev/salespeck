<div class="card">
  <div class="card-header align-items-center d-flex">
    <h4 class="card-title mb-0 flex-grow-1">
      <%= title %>
    </h4>
    <div class="d-flex gap-2 align-items-center">
      <button class="btn btn-soft-info btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#productFilters" aria-expanded="false" aria-controls="productFilters">
        <i class="ri-filter-3-line align-bottom me-1"></i> Filters
      </button>
      <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
        <i class="ri-refresh-line align-middle"></i> Refresh
      </button>
    </div>
  </div>

  <div class="card-body">
    <div class="collapse mb-3" id="productFilters">
      <%
        const categoryOptions = categories.map(c => ({ value: c.id, label: c.name }));
        const brandOptions = brands.map(b => ({ value: b.id, label: b.name }));
      %>
      <%- include('../components/partials/filter-section', {
        filters: [
          { name: 'name', label: 'Product Name', type: 'text', placeholder: 'Search by name...', icon: 'ri-search-line', colSize: 2 },
          { name: 'barcode', label: 'Barcode', type: 'text', placeholder: 'Barcode...', icon: 'ri-barcode-line', colSize: 2 },
          { name: 'category', label: 'Category', type: 'select', options: categoryOptions, colSize: 2 },
          { name: 'brand', label: 'Brand', type: 'select', options: brandOptions, colSize: 2 },
          { name: 'stock_status', label: 'Stock Status', type: 'toggle', options: [
            { value: 'in_stock', label: 'In Stock' },
            { value: 'low_stock', label: 'Low Stock' },
            { value: 'out_of_stock', label: 'Out of Stock' }
          ], colSize: 3 },
          { label: 'Price Range', type: 'range', names: ['price_min', 'price_max'], placeholders: ['Min', 'Max'], colSize: 2 },
          { name: 'sale_active', label: 'Sale Active', type: 'toggle', options: [{ value: '1', label: 'Yes' }, { value: '0', label: 'No' }], colSize: 2 },
          { name: 'purchase_active', label: 'Purchase Active', type: 'toggle', options: [{ value: '1', label: 'Yes' }, { value: '0', label: 'No' }], colSize: 2 }
        ],
        values: query,
        action: '/products',
        buttonColSize: 2
      }) %>
    </div>

    <%
      const brandMap = {};
      brands.forEach(b => brandMap[b.id] = b.name);
      const categoryMap = {};
      categories.forEach(c => categoryMap[c.id] = c.name);

      const tableColumns = [
        { key: 'barcode', label: 'Barcode', sortable: true },
        { key: 'name', label: 'Name', sortable: true, render: (row) => `<h6 class="fs-14 mb-0">${row.name}</h6>` },
        { key: 'category', label: 'Category', sortable: true, render: (row) => categoryMap[row.category] || '-' },
        { key: 'discount', label: 'Discount', sortable: true, render: (row) => `${row.discount || 0}%` },
        { key: 'purchaseprice', label: 'Purchase Price', sortable: true, render: (row) => typeof row.purchaseprice === 'number' ? row.purchaseprice.toFixed(2) : row.purchaseprice },
        { key: 'purchaseactive', label: 'Purchase Active', sortable: true, render: (row) => row.purchaseactive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>' },
        { 
          key: 'quantity', 
          label: 'Quantity', 
          sortable: true, 
          render: (row) => {
            let badge = '';
            if (row.quantity === 0) badge = '<span class="badge bg-danger">Out of Stock</span>';
            else if (row.quantity < 10) badge = `<span class="badge bg-warning">${row.quantity} (Low)</span>`;
            else badge = `<span class="badge bg-success">${row.quantity}</span>`;
            return badge + ` <button type="button" class="btn btn-sm btn-ghost-primary waves-effect waves-light p-0 ms-1" onclick="updateQuantity('${row.id}', '${row.name.replace(/'/g, "\\'")}', '${row.quantity}')" title="Add Quantity"><i class="ri-add-circle-line fs-16 align-middle"></i></button>`;
          }
        },
        { key: 'saleprice', label: 'Sale Price', sortable: true, render: (row) => typeof row.saleprice === 'number' ? row.saleprice.toFixed(2) : row.saleprice },
        { key: 'saleactive', label: 'Sale Active', sortable: true, render: (row) => row.saleactive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>' },
        {
          key: 'actions',
          label: 'Actions',
          sortable: false,
          class: 'text-end',
          render: (row) => {
            return `<div class="btn-group btn-group-sm action-group" role="group">
              <button type="button" class="btn btn-soft-info action-btn" onclick="openViewModal('${row.id}')" title="View"><i class="ri-eye-line"></i></button>
              <button type="button" class="btn btn-soft-warning action-btn" onclick="openEditModal('${row.id}')" title="Edit"><i class="ri-pencil-fill"></i></button>
              <button type="button" class="btn btn-soft-danger action-btn" onclick="deleteRecord('${row.id}')" title="Delete"><i class="ri-delete-bin-fill"></i></button>
            </div>`;
          }
        }
      ];
    %>

    <%- include('../components/partials/data-table', {
      columns: tableColumns,
      data: data,
      sortBy: sortBy,
      sortOrder: sortOrder,
      baseUrl: '/products',
      query: query
    }) %>

    <%- include('../components/partials/pagination', {
      pagination: pagination,
      baseUrl: '/products',
      query: query
    }) %>
  </div>
</div>

<% if (permissions.productsCreate) { %>
<%- include('../components/partials/floating-action-btn', {
  targetModal: '#addProductModal',
  icon: 'ri-add-line',
  tooltip: 'New Product',
  colorClass: 'btn-primary',
  show: true
}) %>
<% } %>

<!-- Add Product Modal -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-gradient-primary text-white">
        <h5 class="modal-title">Create Product</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addProductForm" class="needs-validation" novalidate>
          <div class="row gy-3">
            <div class="col-md-6">
              <label for="addName" class="form-label">Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addName" name="name" required>
            </div>
            <div class="col-md-6">
              <label for="addBarcode" class="form-label">Barcode</label>
              <div class="input-group">
                <input type="text" class="form-control" id="addBarcode" name="barcode" placeholder="Scan or enter barcode">
                <button class="btn btn-outline-secondary" type="button" id="addBarcodeManual">Manual</button>
                <button class="btn btn-outline-primary active" type="button" id="addBarcodeScan">Barcode</button>
              </div>
            </div>
            <div class="col-md-6">
              <label for="addTaxid" class="form-label">Tax Type</label>
              <select class="form-select" id="addTaxid" name="taxid">
                <option value="">Select Tax Type</option>
                <% taxes.forEach(tax => { %>
                  <option value="<%= tax.id %>"><%= tax.name.toUpperCase() %> (<%= tax.percentage %>%)</option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="addCategory" class="form-label">Category</label>
              <select class="form-select" id="addCategory" name="category">
                <option value="">Select Category</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="addBrand" class="form-label">Brand</label>
              <select class="form-select" id="addBrand" name="brand">
                <option value="">Select Brand</option>
                <% brands.forEach(brand => { %>
                  <option value="<%= brand.id %>"><%= brand.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label for="addCarrycost" class="form-label">Carry Cost</label>
              <input type="number" step="0.01" class="form-control" id="addCarrycost" name="carrycost">
            </div>
            <div class="col-md-6">
              <label for="addDiscount" class="form-label">Discount</label>
              <input type="number" step="0.01" class="form-control" id="addDiscount" name="discount">
            </div>
            <div class="col-md-6">
              <label for="addPurchaseprice" class="form-label">Purchase Price</label>
              <input type="number" step="0.01" class="form-control" id="addPurchaseprice" name="purchaseprice">
            </div>
            <div class="col-md-6">
              <label for="addQuantity" class="form-label">Quantity</label>
              <input type="number" step="0.01" class="form-control" id="addQuantity" name="quantity">
            </div>
            <div class="col-md-6">
              <label for="addSaleprice" class="form-label">Sale Price</label>
              <input type="number" step="0.01" class="form-control" id="addSaleprice" name="saleprice">
            </div>
            <div class="col-md-12">
              <div class="d-flex gap-4 align-items-center mt-2">
                <div class="form-check form-switch">
                  <input type="checkbox" class="form-check-input" id="addSaleactive" name="saleactive" checked>
                  <label class="form-check-label" for="addSaleactive">Sale Active</label>
                </div>
                <div class="form-check form-switch">
                  <input type="checkbox" class="form-check-input" id="addPurchaseactive" name="purchaseactive" checked>
                  <label class="form-check-label" for="addPurchaseactive">Purchase Active</label>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="saveProduct()">Save Product</button>
      </div>
    </div>
  </div>
</div>

