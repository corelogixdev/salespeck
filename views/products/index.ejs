<div class="page_header d-flex justify-content-between align-items-center mb-3">
  <h3>
    <%= title %>
  </h3>
  <div>
    <a href="/products/form" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Products</a>
  </div>
</div>
<style>
  td{
    background-color: inherit !important;
  }
</style>
<div class="card">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Barcode</th>
          <th>Category</th>
          <th>Carry Cost</th>
          <th>Discount</th>
          <th>Name</th>
          <th>Purchase Price</th>
          <th>Purchase Active</th>
          <th>Quantity</th>
          <th>Sale Price</th>
          <th>Sale Active</th>
          <!-- align at end -->
          <th style="text-align: end;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(product => { %>
          <!-- make the tr red if the quantitiy is zero or make it yellow if the quantity is less then 10 -->
          <!-- <tr> -->
            <tr style="<%= product.quantity === 0 ? 'background-color: rgb(255, 106, 106);' : product.quantity < 10 ? 'background-color: rgb(247, 247, 144);' : '' %>">
            <td><%= product.id %></td>
            <td><%= product.barcode %></td>
            <td><%= product.category %></td>
            <td><%= product.carrycost %></td>
            <td><%= product.discount %></td>
            <td><%= product.name %></td>
            <td><%= product.purchaseprice %></td>
            <td><%= product.purchaseactive ? 'Yes' : 'No' %></td>
            <td><%= product.quantity %></td>
            <td><%= product.saleprice %></td>
            <td><%= product.saleactive ? 'Yes' : 'No' %></td>
            <td style="text-align: end;">
              <a href="/products/form?id=<%= product.id %>" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i> Edit
              </a>
              <form action="/products/<%= product.id %>/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>