<div class="page_header d-flex justify-content-between align-items-center mb-3">
  <h3>
    <%= title %>
  </h3>
  <div>
    <a href="/products/form" class="btn btn-primary"><i class="fas fa-plus"></i> Create New Products</a>
  </div>
</div>
<div class="card">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <!-- algin at end -->
          <th style="text-align: end;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(product=> { %>
          <tr>
            <td>
              <%= product.id %>
            </td>
            <td>
              <%= product.name %>
            </td>
            <td style="text-align: end;">
              <a href="/products/form?id=<%= product.id %>"
                class="btn btn-warning btn-sm"><i
                  class="fas fa-edit"></i> Edit</a>
              <form action="/products/<%= product.id %>/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm" ><i
                    class="fas fa-trash"></i> Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </div>
</div>