<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Update Product Quantity</h4>
            </div>
            <div class="card-body">
                <form id="quantityForm" method="POST" action="/products/quantity/save">
                    <input type="hidden" name="id" value="<%= product.id %>">
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input type="text" class="form-control" value="<%= product.name %>" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Current Quantity</label>
                            <input type="text" class="form-control" value="<%= product.quantity %>" readonly>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Quantity * 
                                <small class="text-muted">(Enter positive number to add quantity and negative number to reduce quantity)</small>
                            </label>
                            <input type="number" name="quantity" class="form-control" min="<%= -1 * product.quantity %>" required>
                        </div>
                        <div class="col-md-12 mt-3">
                            <label class="form-label">Note *</label>
                            <textarea name="note" class="form-control" required rows="3" placeholder="Enter reason for quantity addition"></textarea>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('quantityForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    try {
        const response = await fetch(this.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(Object.fromEntries(new FormData(this))),
        });
        const result = await response.json();
        if (result.success) {
            $.alert({
                title: 'Success!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'green',
                buttons: {
                    confirm: {
                        text: 'OK',
                        btnClass: 'btn-primary',
                        action: function() {
                            window.location.reload();
                        }
                    }
                }
            });
        } else {
            $.alert({
                title: 'Error!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'red',
            });
        }
    } catch (error) {
        $.alert({
            title: 'Error!',
            content: 'An error occurred while saving',
            boxWidth: '30%',
            theme: 'material',
            useBootstrap: false,
            type: 'red',
        });
    }
});
</script>
