<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Taxes</h4>
            <div class="page-title-right">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTaxModal">
                    <i class="bx bx-plus me-1"></i> Add Tax
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Percentage</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="taxesTableBody">
                            <% taxes.forEach(tax => { %>
                                <tr>
                                    <td><%= tax.id %></td>
                                    <td><%= tax.name %></td>
                                    <td><%= tax.percentage %>%</td>
                                    <td>
                                        <button class="btn btn-sm btn-info edit-tax" data-id="<%= tax.id %>">
                                            <i class="bx bx-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger delete-tax" data-id="<%= tax.id %>">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Add Tax Modal -->
<div class="modal fade" id="addTaxModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="taxForm">
                    <div class="mb-3">
                        <label class="form-label">Tax Name</label>
                        <input type="text" class="form-control" id="taxName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Percentage</label>
                        <input type="number" class="form-control" id="taxPercentage" required min="0" max="100" step="0.01">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveTax">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Tax Modal -->
<div class="modal fade" id="editTaxModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editTaxForm">
                    <input type="hidden" id="editTaxId">
                    <div class="mb-3">
                        <label class="form-label">Tax Name</label>
                        <input type="text" class="form-control" id="editTaxName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Percentage</label>
                        <input type="number" class="form-control" id="editTaxPercentage" required min="0" max="100" step="0.01">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="updateTax">Update</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Save new tax
    document.getElementById('saveTax').addEventListener('click', async function() {
        const name = document.getElementById('taxName').value;
        const percentage = document.getElementById('taxPercentage').value;
        
        try {
            const response = await fetch('/accounting/taxes/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, percentage })
            });
            const result = await response.json();
            if (result.status === "success") {
                $.alert({
                    title: 'Success!',
                    content: result.message,
                    boxWidth: '30%',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'green',
                    buttons: {
                        confirm: {
                            text: 'OK',
                            btnClass: 'btn-primary',
                            action: function () {
                                window.location.reload();
                            }
                        }
                    }
                });
            } else {
                $.alert({
                    title: 'Error!',
                    boxWidth: '30%',
                    content: result.message || 'Failed to add tax',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'red',
                });
            }
        } catch (error) {
            $.alert({
                title: 'Error!',
                boxWidth: '30%',
                content: 'Error occurred while adding tax',
                theme: 'material',
                useBootstrap: false,
                type: 'red',
            });
        }
    });

    // Edit tax
    document.querySelectorAll('.edit-tax').forEach(button => {
        button.addEventListener('click', async function() {
            const taxId = this.dataset.id;
            const row = this.closest('tr');
            
            document.getElementById('editTaxId').value = taxId;
            document.getElementById('editTaxName').value = row.cells[1].textContent;
            document.getElementById('editTaxPercentage').value = row.cells[2].textContent.replace('%', '');
            
            new bootstrap.Modal(document.getElementById('editTaxModal')).show();
        });
    });

    // Update tax
    document.getElementById('updateTax').addEventListener('click', async function() {
        const id = document.getElementById('editTaxId').value;
        const name = document.getElementById('editTaxName').value;
        const percentage = document.getElementById('editTaxPercentage').value;
        
        try {
            const response = await fetch(`/accounting/taxes/save`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, percentage, id })
            });
            const result = await response.json();
            if (result.status === "success") {
                $.alert({
                    title: 'Success!',
                    content: result.message,
                    boxWidth: '30%',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'green',
                    buttons: {
                        confirm: {
                            text: 'OK',
                            btnClass: 'btn-primary',
                            action: function () {
                                window.location.reload();
                            }
                        }
                    }
                });
            } else {
                $.alert({
                    title: 'Error!',
                    boxWidth: '30%',
                    content: result.message || 'Failed to update tax',
                    theme: 'material',
                    useBootstrap: false,
                    type: 'red',
                });
            }
        } catch (error) {
            $.alert({
                title: 'Error!',
                boxWidth: '30%',
                content: 'Error occurred while updating tax',
                theme: 'material',
                useBootstrap: false,
                type: 'red',
            });
        }
    });

    // Delete tax
    document.querySelectorAll('.delete-tax').forEach(button => {
        button.addEventListener('click', function() {
            const taxId = this.dataset.id;
            $.alert({
                title: 'Confirm!',
                content: 'Are you sure you want to delete this tax?',
                theme: 'material',
                useBootstrap: false,
                boxWidth: '30%',
                buttons: {
                    confirm: {
                        text: 'Yes',
                        btnClass: 'btn-danger',
                        action: async function () {
                            try {
                                const response = await fetch(`/accounting/taxes/delete/${taxId}`, {
                                    method: 'GET'
                                });
                                const result = await response.json();
                                if (result.status === "success") {
                                    $.alert({
                                        title: 'Success!',
                                        content: result.message,
                                        boxWidth: '30%',
                                        theme: 'material',
                                        useBootstrap: false,
                                        type: 'green',
                                        buttons: {
                                            confirm: {
                                                text: 'OK',
                                                btnClass: 'btn-primary',
                                                action: function () {
                                                    window.location.reload();
                                                }
                                            }
                                        }
                                    });
                                } else {
                                    $.alert({
                                        title: 'Error!',
                                        boxWidth: '30%',
                                        content: result.message || 'Failed to delete tax',
                                        theme: 'material',
                                        useBootstrap: false,
                                        type: 'red',
                                    });
                                }
                            } catch (error) {
                                $.alert({
                                    title: 'Error!',
                                    boxWidth: '30%',
                                    content: 'Error occurred while deleting tax',
                                    theme: 'material',
                                    useBootstrap: false,
                                    type: 'red',
                                });
                            }
                        }
                    },
                    cancel: {
                        text: 'No',
                        btnClass: 'btn-primary',
                    }
                }
            });
        });
    });
});
</script>
