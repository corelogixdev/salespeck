<div class="card">
    <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">Taxes</h4>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-soft-info btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#taxFilters" aria-expanded="false" aria-controls="taxFilters">
                <i class="ri-filter-3-line align-bottom me-1"></i> Filters
            </button>
            <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
                <i class="ri-refresh-line align-middle"></i> Refresh
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="collapse mb-3" id="taxFilters">
            <%- include('../../components/partials/filter-section', {
                filters: [
                    { name: 'name_like', label: 'Search', type: 'text', placeholder: 'Search by tax name...', icon: 'ri-search-line', colSize: 4 }
                ],
                values: query,
                action: '/accounting/taxes'
            }) %>
        </div>

        <%
        const tableColumns = [
            { key: 'name', label: 'Tax Name', sortable: true },
            { key: 'percentage', label: 'Rate (%)', sortable: true, render: (row) => `${row.percentage}%` },
            {
                key: 'actions',
                label: 'Actions',
                sortable: false,
                class: 'text-end',
                render: (row) => {
                    let html = '<div class="btn-group btn-group-sm action-group" role="group">';
                    html += `<button type="button" class="btn btn-soft-info action-btn" onclick="openViewModal('${row.id}')" title="View"><i class="ri-eye-line"></i></button>`;
                    html += `<button type="button" class="btn btn-soft-warning action-btn" onclick="openEditModal('${row.id}')" title="Edit"><i class="ri-pencil-fill"></i></button>`;
                    html += `<button type="button" class="btn btn-soft-danger action-btn" onclick="deleteRecord('${row.id}')" title="Delete"><i class="ri-delete-bin-fill"></i></button>`;
                    html += '</div>';
                    return html;
                }
            }
        ];
        %>

        <%- include('../../components/partials/data-table', {
            columns: tableColumns,
            data: taxes,
            sortBy: sortBy,
            sortOrder: sortOrder,
            baseUrl: '/accounting/taxes',
            query: query
        }) %>

        <%- include('../../components/partials/pagination', {
            pagination: pagination,
            baseUrl: '/accounting/taxes',
            query: query
        }) %>
    </div>
</div>

<%- include('../../components/partials/floating-action-btn', {
    targetModal: '#addTaxModal',
    icon: 'ri-add-line',
    tooltip: 'Create New Tax',
    colorClass: 'btn-primary',
    show: true
}) %>

<!-- Create Modal -->
<div class="modal fade" id="addTaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title">Add Tax</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addTaxForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="taxName" class="form-label">Tax Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="taxName" name="name" required>
                        <div class="invalid-feedback">Please enter tax name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="taxPercentage" class="form-label">Tax Rate (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="taxPercentage" name="percentage" required>
                        <div class="invalid-feedback">Please enter tax rate.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveTax()">Save Tax</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editTaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-gradient-warning text-white">
                <h5 class="modal-title">Edit Tax</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editTaxForm" class="needs-validation" novalidate>
                    <input type="hidden" id="editTaxId" name="id">
                    <div class="mb-3">
                        <label for="editTaxName" class="form-label">Tax Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editTaxName" name="name" required>
                        <div class="invalid-feedback">Please enter tax name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="editTaxPercentage" class="form-label">Tax Rate (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="editTaxPercentage" name="percentage" required>
                        <div class="invalid-feedback">Please enter tax rate.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-warning" onclick="updateTax()">Update Tax</button>
            </div>
        </div>
    </div>
</div>

<!-- View Modal -->
<%- include('../../components/partials/view-modal', {
    id: 'viewTaxModal',
    title: 'Tax Details'
}) %>

<script>
    function openViewModal(id) {
        fetch('/accounting/taxes/' + id)
            .then(r => r.json())
            .then(result => {
                if (!result.success) return toastr.error('Failed to load details');
                const t = result.tax;
                renderViewModal('viewTaxModal', [
                    { label: 'Tax Name', value: t.name },
                    { label: 'Rate (%)', value: t.percentage + '%' }
                ]);
                const modal = new bootstrap.Modal(document.getElementById('viewTaxModal'));
                modal.show();
            })
            .catch(e => { console.error(e); toastr.error('Error loading details'); });
    }

    function openEditModal(id) {
        fetch('/accounting/taxes/' + id)
            .then(r => r.json())
            .then(result => {
                if (!result.success) return toastr.error('Failed to load record');
                const t = result.tax;
                document.getElementById('editTaxId').value = t.id;
                document.getElementById('editTaxName').value = t.name || '';
                document.getElementById('editTaxPercentage').value = t.percentage || '';
                const modal = new bootstrap.Modal(document.getElementById('editTaxModal'));
                modal.show();
            })
            .catch(e => { console.error(e); toastr.error('Error loading record'); });
    }

    function validateForm(formId) {
        const form = document.getElementById(formId);
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return null;
        }
        const data = {};
        new FormData(form).forEach((value, key) => { data[key] = value; });
        data.percentage = parseFloat(data.percentage);
        return data;
    }

    function saveTax() {
        const data = validateForm('addTaxForm');
        if (!data) return;
        fetch('/accounting/taxes/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                toastr.success(result.message);
                const modal = bootstrap.Modal.getInstance(document.getElementById('addTaxModal'));
                if (modal) modal.hide();
                setTimeout(() => window.location.reload(), 800);
            } else {
                toastr.error(result.message || 'Error saving tax');
            }
        })
        .catch(e => { console.error(e); toastr.error('Failed to save tax'); });
    }

    function updateTax() {
        const data = validateForm('editTaxForm');
        if (!data) return;
        fetch('/accounting/taxes/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                toastr.success(result.message);
                const modal = bootstrap.Modal.getInstance(document.getElementById('editTaxModal'));
                if (modal) modal.hide();
                setTimeout(() => window.location.reload(), 800);
            } else {
                toastr.error(result.message || 'Error updating tax');
            }
        })
        .catch(e => { console.error(e); toastr.error('Failed to update tax'); });
    }

    function deleteRecord(id) {
        $.confirm({
            title: 'Confirm Delete',
            content: 'Are you sure you want to delete this tax?',
            theme: 'material',
            useBootstrap: false,
            boxWidth: '30%',
            type: 'red',
            buttons: {
                confirm: {
                    text: 'Yes, Delete',
                    btnClass: 'btn-danger',
                    action: function () {
                        fetch('/accounting/taxes/' + id + '/delete', { method: 'POST' })
                            .then(r => r.json())
                            .then(result => {
                                if (result.success) {
                                    toastr.success(result.message);
                                    setTimeout(() => window.location.reload(), 800);
                                } else {
                                    toastr.error(result.message || 'Error deleting tax');
                                }
                            })
                            .catch(e => { console.error(e); toastr.error('Failed to delete tax'); });
                    }
                },
                cancel: {
                    text: 'No',
                    btnClass: 'btn-primary'
                }
            }
        });
    }
</script>
