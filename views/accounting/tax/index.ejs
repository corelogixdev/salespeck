<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Taxes</h4>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addTaxModal">
                        <i class="bx bx-plus me-1"></i> Add Tax
                    </button>
                    <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
                        <i class="ri-refresh-line align-middle"></i> Refresh
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Search Form -->
                <form method="GET" action="/accounting/taxes" class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="search-box">
                            <input type="text" class="form-control search" name="name_like" 
                                placeholder="Search by tax name..." value="<%= query.name_like || '' %>">
                            <i class="ri-search-line search-icon"></i>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <select class="form-select" name="status">
                            <option value="">All Status</option>
                            <option value="1" <%= query.status === '1' ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= query.status === '0' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <div class="col-md-5 d-flex align-items-center justify-content-end">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="ri-search-line me-1 align-bottom"></i> Search
                            </button>
                            <% if (query.name_like || query.status) { %>
                                <a href="/accounting/taxes" class="btn btn-danger btn-sm">
                                    <i class="ri-close-line align-bottom me-1"></i> Clear
                                </a>
                            <% } %>
                        </div>
                    </div>
                </form>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Description</th>
                                <th scope="col">Rate (%)</th>
                                <th scope="col">Status</th>
                                <th scope="col" style="text-align: end;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!taxes || taxes.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center">
                                        <i class="ri-error-warning-line align-middle me-1"></i> No data found
                                    </td>
                                </tr>
                            <% } else { %>
                                <% taxes.forEach(tax => { %>
                                    <tr>
                                        <td class="fw-medium"><%= tax.id %></td>
                                        <td><%= tax.name %></td>
                                        <td><%= tax.description || '-' %></td>
                                        <td><%= tax.rate %>%</td>
                                        <td>
                                            <span class="badge bg-<%= tax.status ? 'success' : 'danger' %>">
                                                <%= tax.status ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td style="text-align: end;">
                                            <button type="button" onclick="editTax('<%= tax.id %>')" class="btn btn-soft-warning btn-sm">
                                                <i class="ri-pencil-fill align-middle"></i> Edit
                                            </button>
                                            <button type="button" onclick="deleteTax('<%= tax.id %>')" class="btn btn-soft-danger btn-sm">
                                                <i class="ri-delete-bin-fill align-middle"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (pagination && pagination.totalPages > 1) { %>
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Showing <strong><%= pagination.startRecord %></strong> to 
                            <strong><%= pagination.endRecord %></strong> of 
                            <strong><%= pagination.totalCount %></strong> entries
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= pagination.currentPage === 1 ? '#' : '/accounting/taxes?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + 'page=' + (pagination.currentPage - 1) %>">
                                        <i class="mdi mdi-chevron-left"></i>
                                    </a>
                                </li>
                                <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                                    <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                                        <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                            <a class="page-link" href="/accounting/taxes?<%= query.name_like ? 'name_like=' + query.name_like + '&' : '' %><%= query.status ? 'status=' + query.status + '&' : '' %>page=<%= i %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                    <% } else if (i === 2 || i === pagination.totalPages - 1) { %>
                                        <li class="page-item disabled"><a class="page-link">...</a></li>
                                    <% } %>
                                <% } %>
                                <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/accounting/taxes?' + (query.name_like ? 'name_like=' + query.name_like + '&' : '') + (query.status ? 'status=' + query.status + '&' : '') + 'page=' + (pagination.currentPage + 1) %>">
                                        <i class="mdi mdi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Add Tax Modal -->
<div class="modal fade" id="addTaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addTaxForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="taxName" class="form-label">Tax Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="taxName" name="name" required>
                        <div class="invalid-feedback">Please enter tax name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="taxDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="taxDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="taxRate" class="form-label">Tax Rate (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="taxRate" name="rate" required>
                        <div class="invalid-feedback">Please enter tax rate.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="statusActive" value="1" checked>
                                <label class="form-check-label" for="statusActive">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="statusInactive" value="0">
                                <label class="form-check-label" for="statusInactive">Inactive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveTax()">Save Tax</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Tax Modal -->
<div class="modal fade" id="editTaxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Tax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editTaxForm" class="needs-validation" novalidate>
                    <input type="hidden" id="editTaxId" name="id">
                    <div class="mb-3">
                        <label for="editTaxName" class="form-label">Tax Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editTaxName" name="name" required>
                        <div class="invalid-feedback">Please enter tax name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="editTaxDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editTaxDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editTaxRate" class="form-label">Tax Rate (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" class="form-control" id="editTaxRate" name="rate" required>
                        <div class="invalid-feedback">Please enter tax rate.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="editStatusActive" value="1">
                                <label class="form-check-label" for="editStatusActive">Active</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="status" id="editStatusInactive" value="0">
                                <label class="form-check-label" for="editStatusInactive">Inactive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="updateTax()">Update Tax</button>
            </div>
        </div>
    </div>
</div>

<style>
    .search-box {
        position: relative;
    }

    .search-box .search-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: var(--vz-gray-600);
    }

    .search-box .form-control {
        padding-left: 35px;
        background-color: var(--vz-card-bg-custom);
        border-color: var(--vz-border-color);
    }

    .search-box .form-control:focus {
        border-color: var(--vz-primary);
    }
</style>

<script>
    // Save tax
    async function saveTax() {
        const form = document.getElementById('addTaxForm');
        if (form.checkValidity()) {
            const data = {
                name: document.getElementById('taxName').value,
                description: document.getElementById('taxDescription').value,
                rate: parseFloat(document.getElementById('taxRate').value),
                status: parseInt(document.querySelector('#addTaxForm input[name="status"]:checked').value)
            };

            try {
                const response = await fetch('/accounting/taxes/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.message || 'Error saving tax');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error saving tax');
            }
        } else {
            form.classList.add('was-validated');
        }
    }

    // Edit tax
    async function editTax(id) {
        try {
            const response = await fetch(`/accounting/taxes/${id}`);
            const data = await response.json();

            if (data.success) {
                const tax = data.tax;
                document.getElementById('editTaxId').value = tax.id;
                document.getElementById('editTaxName').value = tax.name;
                document.getElementById('editTaxDescription').value = tax.description || '';
                document.getElementById('editTaxRate').value = tax.rate;

                if (tax.status == 1) {
                    document.getElementById('editStatusActive').checked = true;
                } else {
                    document.getElementById('editStatusInactive').checked = true;
                }

                const modal = new bootstrap.Modal(document.getElementById('editTaxModal'));
                modal.show();
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error loading tax details');
        }
    }

    // Update tax
    async function updateTax() {
        const form = document.getElementById('editTaxForm');
        if (form.checkValidity()) {
            const data = {
                name: document.getElementById('editTaxName').value,
                description: document.getElementById('editTaxDescription').value,
                rate: parseFloat(document.getElementById('editTaxRate').value),
                status: parseInt(document.querySelector('#editTaxForm input[name="status"]:checked').value)
            };

            const id = document.getElementById('editTaxId').value;

            try {
                const response = await fetch(`/accounting/taxes/save`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ...data, id })
                });

                const result = await response.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.message || 'Error updating tax');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error updating tax');
            }
        } else {
            form.classList.add('was-validated');
        }
    }

    // Delete tax
    async function deleteTax(id) {
        if (confirm('Are you sure you want to delete this tax?')) {
            try {
                const response = await fetch(`/accounting/taxes/delete/${id}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();
                if (result.success) {
                    window.location.reload();
                } else {
                    alert(result.message || 'Error deleting tax');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error deleting tax');
            }
        }
    }
</script>