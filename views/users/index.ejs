<div class="d-flex justify-content-between align-items-center mb-3">
  <h3><%= role === 'user' ? 'Users' : 'Customers' %></h3>
  <div>
    <a href="/users/form?role=<%= role %>" class="btn btn-primary"><i class="fas fa-plus"></i> Create New <%= role === 'user' ? 'User' : 'Customer' %></a>
  </div>
</div>
<div class="card">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Phone</th>
          <!-- if not customer the show -->
          <% if (role !== 'customer') { %>
          <th>Username</th>
          <th>Role</th>
          <% } %>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.name %></td>
            <td><%= user.phone %></td>
            <% if (role !== 'customer') { %>
            <td><%= user.username %></td>
            <td><%= user.role %></td>
            <% } %>
            <td>
              <a href="/users/form?id=<%= user.id %>&role=<%= user.role %>" class="btn btn-warning btn-sm <%= user.role == 'admin' ? 'custom_disabled' : '' %>"><i class="fas fa-edit"></i> Edit</a>
              <form action="/users/<%= user.id %>/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm" <%= user.role == 'admin' ? 'disabled' : '' %>><i class="fas fa-trash"></i> Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
