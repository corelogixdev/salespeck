<div class="card">
    <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">
            <%= role==='user' ? 'Users' : (role==='vendor' ? 'Vendors' : 'Customers' ) %> List
        </h4>
        <div class="d-flex gap-2">
            <% if ((role=='user' && permissions.usersCreate) || (role=='vendor' && permissions.vendorsCreate) ||
                (role=='customer' && permissions.customersCreate)) { %>
                <a href="/users/form?role=<%= role %>" class="btn btn-primary btn-sm">
                    <i class="ri-add-line align-bottom me-1"></i> Create New <%= role==='user' ? 'User' :
                        (role==='vendor' ? 'Vendor' : 'Customer' ) %>
                </a>
                <% } %>
                    <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
                        <i class="ri-refresh-line align-middle"></i> Refresh
                    </button>
        </div>
    </div>

    <div class="card-body">
        <!-- Search Filter -->
        <% if ((role=='user' && permissions.usersSearch) || (role=='vendor' && permissions.vendorsSearch) ||
            (role=='customer' && permissions.customersSearch)) { %>
            <form action="/users" method="GET" class="row g-2 mb-4 justify-content-end">
                <input type="hidden" name="role" value="<%= role %>">
                <div class="col-sm-3">
                    <div class="search-box">
                        <input type="text" class="form-control search" name="search"
                            placeholder="Search by name, username or phone" value="<%= query.search || '' %>">
                        <i class="ri-search-line search-icon"></i>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="search-box">
                        <input type="text" class="form-control search flatpickr-range" data-provider="flatpickr"
                            data-range="true" data-date-format="Y-m-d" name="daterange" placeholder="Filter by date range..."
                            value="<%= query.daterange || '' %>">
                         <i class="ri-calendar-2-line search-icon"></i>
                    </div>
                </div>
                <div class="col-auto d-flex gap-2 align-items-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="ri-search-line me-1 align-bottom"></i> Search
                    </button>
                    <% if (query.search) { %>
                        <a href="/users?role=<%= role %>" class="btn btn-danger">
                            <i class="ri-close-line align-bottom me-1"></i> Clear
                        </a>
                        <% } %>
                </div>
            </form>
            <% } %>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-striped table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Email</th>
                                <% if (role==='user' ) { %>
                                    <th scope="col">Username</th>
                                    <th scope="col">Role</th>
                                    <% } %>
                                        <% if ((role=='user' && (permissions.usersUpdate || permissions.usersDelete)) ||
                                            (role=='vendor' && (permissions.vendorsUpdate || permissions.vendorsDelete))
                                            || (role=='customer' && (permissions.customersUpdate ||
                                            permissions.customersDelete))) { %>
                                            <th scope="col" style="text-align: end;">Actions</th>
                                            <% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <%- include('_table_rows') %>
                        </tbody>
                    </table>
                </div>

                <!-- Enhanced Pagination -->
                <% if (pagination && pagination.totalPages > 0) { %>
                    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
                        <!-- Records Info -->
                        <div class="text-muted">
                            Showing <strong><%= pagination.startRecord %></strong> to 
                            <strong><%= pagination.endRecord %></strong> of 
                            <strong><%= pagination.totalCount %></strong> entries
                        </div>
                        
                        <!-- Page Size Selector -->
                        <div class="d-flex align-items-center gap-2">
                            <label for="pageSize" class="text-muted mb-0">Show:</label>
                            <select id="pageSize" class="form-select form-select-sm" style="width: 80px;"
                onchange="window.handlePageSizeChange(this, '/users?<%= new URLSearchParams({...query, role: role, page: 1}).toString() %>', <%= pagination.totalCount %>)">
                                <option value="10" <%= (pagination.pageSize || 10) == 10 ? 'selected' : '' %>>10</option>
                                <option value="25" <%= (pagination.pageSize || 10) == 25 ? 'selected' : '' %>>25</option>
                                <option value="50" <%= (pagination.pageSize || 10) == 50 ? 'selected' : '' %>>50</option>
                                <option value="100" <%= (pagination.pageSize || 10) == 100 ? 'selected' : '' %>>100</option>
                                <option value="200" <%= (pagination.pageSize || 10) == 200 ? 'selected' : '' %>>200</option>
                                <option value="500" <%= (pagination.pageSize || 10) == 500 ? 'selected' : '' %>>500</option>
                                <option value="1000" <%= (pagination.pageSize || 10) == 1000 ? 'selected' : '' %>>1000</option>
                                <option value="9999" <%= (pagination.pageSize || 10) == 9999 ? 'selected' : '' %>>All</option>
                            </select>
                        </div>

                        <!-- Pagination Controls -->
                        <% if (pagination.totalPages > 1) { %>
                            <nav aria-label="Page navigation">
                                <ul class="pagination mb-0">
                                    <!-- First Page -->
                                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="<%= pagination.currentPage === 1 ? '#' : '/users?' + new URLSearchParams(Object.assign({}, query, {role: role, page: 1})).toString() %>" title="First">
                                            <i class="ri-arrow-left-double-line"></i>
                                        </a>
                                    </li>

                                    <!-- Previous Page -->
                                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="<%= pagination.currentPage === 1 ? '#' : '/users?' + new URLSearchParams(Object.assign({}, query, {role: role, page: pagination.currentPage - 1})).toString() %>" title="Previous">
                                            <i class="mdi mdi-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Page Numbers -->
                                    <% for(let i=1; i <=pagination.totalPages; i++) { %>
                                        <% if (i===1 || i===pagination.totalPages || (i>= pagination.currentPage - 1 && i <=
                                                pagination.currentPage + 1)) { %>
                                                <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                                                    <a class="page-link"
                                                        href="/users?<%= new URLSearchParams(Object.assign({}, query, {role: role, page: i})).toString() %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                        <% } else if (i===2 || i===pagination.totalPages - 1) { %>
                                            <li class="page-item disabled"><a class="page-link">...</a></li>
                                        <% } %>
                                    <% } %>

                                    <!-- Next Page -->
                                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/users?' + new URLSearchParams(Object.assign({}, query, {role: role, page: pagination.currentPage + 1})).toString() %>" title="Next">
                                            <i class="mdi mdi-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Last Page -->
                                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/users?' + new URLSearchParams(Object.assign({}, query, {role: role, page: pagination.totalPages})).toString() %>" title="Last">
                                            <i class="ri-arrow-right-double-line"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        <% } %>
                    </div>
                <% } %>
    </div>
</div>

<script>
    async function deleteRecord(id) {
        $.alert({
            title: 'Confirm!',
            content: 'Are you sure you want to delete this record?',
            theme: 'material',
            useBootstrap: false,
            boxWidth: '30%',
            buttons: {
                confirm: {
                    text: 'Yes',
                    btnClass: 'btn-danger',
                    action: async function () {
                        const response = await fetch(`/users/${id}/delete`, {
                            method: 'POST'
                        });
                        let result = await response.json();
                        if (result.success === true) {
                            $.alert({
                                title: 'Success!',
                                content: result.message,
                                boxWidth: '30%',
                                theme: 'material',
                                useBootstrap: false,
                                type: 'green',
                                buttons: {
                                    confirm: {
                                        text: 'OK',
                                        btnClass: 'btn-success',
                                        action: function () {
                                            location.reload();
                                        }
                                    }
                                }
                            });
                        } else {
                            $.alert({
                                title: 'Error!',
                                content: result.message,
                                boxWidth: '30%',
                                theme: 'material',
                                useBootstrap: false,
                                type: 'red',
                                buttons: {
                                    confirm: {
                                        text: 'OK',
                                        btnClass: 'btn-danger',
                                    }
                                }
                            });
                        }
                    }
                },
                cancel: {
                    text: 'No',
                    btnClass: 'btn-primary',
                }
            }
        });
    }
</script>