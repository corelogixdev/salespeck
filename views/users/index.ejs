<div class="d-flex justify-content-between align-items-center mb-3">
  <h3><%= role === 'user' ? 'User' : 'Customers' %></h3>
  <div class="d-flex align-items-center gap-2 justify-content-center">
    <form action="/users" method="GET">
      <div class="input-group">
        <input type="hidden" name="role" value="<%= role %>">
        <input type="text" style="min-width: 18rem;" class="form-control" name="search" placeholder="Search by name, username or phone" required value="<%= typeof searchdata !== 'undefined' ? searchdata : '' %>">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
      </div>
    </form>
    <a href="/users/form?role=<%= role %>" class="btn btn-primary"><i class="fas fa-plus"></i> Create New <%= role === 'user' ? 'User' : 'Customer' %></a>
  </div>
</div>
<div class="card">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Phone</th>
          <!-- if not customer the show -->
          <% if (role !== 'customer') { %>
          <th>Username</th>
          <th>Role</th>
          <% } %>
          <th style="text-align: end;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(obj => { %>
          <tr>
            <td><%= obj.id %></td>
            <td><%= obj.name %></td>
            <td><%= obj.phone %></td>
            <% if (role !== 'customer') { %>
            <td><%= obj.username %></td>
            <td><%= obj.role %></td>
            <% } %>
            <td style="text-align: end;">
              <a href="/users/form?id=<%= obj.id %>&role=<%= obj.role %>" class="btn btn-warning btn-sm <%= obj.role == 'admin' ? 'custom_disabled' : '' %>"><i class="fas fa-edit"></i> Edit</a>
              <form action="/users/<%= obj.id %>/delete" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm" <%= obj.role == 'admin' ? 'disabled' : '' %>><i class="fas fa-trash"></i> Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <!-- if !data or data.length show no data found with an amazing icon -->
        <% if (!data || data.length === 0) { %>
          <tr>
            <td colspan="<%= role !== 'customer' ? 6 : 3 %>" style="text-align: center;">
              <i class="fas fa-exclamation-triangle"></i> No data found
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
