<div class="card">
  <div class="card-header align-items-center d-flex">
    <h4 class="card-title mb-0 flex-grow-1"><%= role === 'user' ? 'Users' : 'Customers' %> List</h4>
    <div class="d-flex gap-2">
      <% if ((role == 'user' && permissions.usersCreate) || (role == 'customer' && permissions.customersCreate)) { %>
        <a href="/users/form?role=<%= role %>" class="btn btn-primary btn-sm" target="_blank">
          <i class="ri-add-line align-bottom me-1"></i> Create New <%= role === 'user' ? 'Vendor' : 'Customer' %>
        </a>
      <% } %>
      <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
        <i class="ri-refresh-line align-middle"></i> Refresh
      </button>
    </div>
  </div>

  <div class="card-body">
    <div class="live-preview">
      <% if ((role == 'user' && permissions.usersSearch) || (role == 'customer' && permissions.customersSearch)) { %> 
        <form action="/users" method="GET" class="row g-2 mb-4 justify-content-end">
          <div class="col-sm-3">
            <div class="search-box">
              <input type="hidden" name="role" value="<%= role %>">
              <input type="text" 
                     class="form-control search" 
                     name="search" 
                     placeholder="Search by name, username or phone"
                     required 
                     value="<%= typeof searchdata !== 'undefined' ? searchdata : '' %>">
              <i class="ri-search-line search-icon"></i>
            </div>
          </div>
          <div class="col-auto d-flex gap-2 align-items-center">
            <button type="submit" class="btn btn-primary" style="padding: 5px 10px;">
              <i class="ri-search-line me-1 align-bottom"></i> Search
            </button>
            <% if (searchdata) { %>
              <a href="/users?role=<%= role %>" class="btn btn-danger d-flex align-items-center" style="padding: 5px 10px;">
                <i class="ri-close-line align-bottom me-1"></i> Clear
              </a>
            <% } %>
          </div>
        </form>
      <% } %>

      <div class="table-responsive">
        <table class="table table-striped table-nowrap align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Name</th>
              <th scope="col">Phone</th>
              <% if (role !== 'customer') { %>
                <th scope="col">Username</th>
                <th scope="col">Role</th>
              <% } %>
              <% if ((role == 'user' && (permissions.usersUpdate || permissions.usersDelete)) || 
                    (role == 'customer' && (permissions.customersUpdate || permissions.customersDelete))) { %>
                <th scope="col" style="text-align: end;">Actions</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% if (!data || data.length === 0) { %>
              <tr>
                <td colspan="<%= role !== 'customer' ? 6 : 4 %>" class="text-center">
                  <i class="ri-error-warning-line align-middle me-1"></i> No data found
                </td>
              </tr>
            <% } else { %>
              <% data.forEach(obj => { %>
                <tr>
                  <td class="fw-medium"><%= obj.id %></td>
                  <td><%= obj.firstname %> <%= obj.lastname %></td>
                  <td><%= obj.phone %></td>
                  <% if (role !== 'customer') { %>
                    <td><%= obj.username %></td>
                    <td><span class="badge bg-primary"><%= obj.role %></span></td>
                  <% } %>
                  <% if ((role == 'user' && (permissions.usersUpdate || permissions.usersDelete)) || 
                        (role == 'customer' && (permissions.customersUpdate || permissions.customersDelete))) { %>
                    <td style="text-align: end;">
                      <% if ((role == 'user' && permissions.usersUpdate) || 
                            (role == 'customer' && permissions.customersUpdate)) { %>
                        <a href="/users/form?id=<%= obj.id %>&role=<%= obj.role %>" 
                            class="btn btn-soft-warning btn-sm <%= obj.role == 'branchmanager' ? 'custom_disabled' : '' %>" 
                            target="_blank">
                          <i class="ri-pencil-fill align-middle"></i> Edit
                        </a>
                      <% } %>
                      <% if ((role == 'user' && permissions.usersDelete) || 
                            (role == 'customer' && permissions.customersDelete)) { %>
                        <button type="button" 
                                onclick="deleteRecord('<%= obj.id %>')"
                                class="btn btn-soft-danger btn-sm" 
                                <%= obj.role == 'branchmanager' ? 'disabled' : '' %>>
                          <i class="ri-delete-bin-fill align-middle"></i> Delete
                        </button>
                      <% } %>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
      
      <% if (pagination && pagination.totalPages > 1) { %>
      <div class="d-flex justify-content-end mt-4">
        <nav aria-label="Page navigation">
          <ul class="pagination">
              <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= pagination.currentPage === 1 ? '#' : '/users?role=' + role + (searchdata ? '&search=' + searchdata : '') + '&page=' + (pagination.currentPage - 1) %>">
                      <i class="mdi mdi-chevron-left"></i>
                  </a>
              </li>
              <% for(let i = 1; i <= pagination.totalPages; i++) { %>
                  <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                      <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                          <a class="page-link" href="/users?role=<%= role %><%= searchdata ? '&search=' + searchdata : '' %>&page=<%= i %>"><%= i %></a>
                      </li>
                  <% } else if (i === 2 || i === pagination.totalPages - 1) { %>
                      <li class="page-item disabled"><a class="page-link">...</a></li>
                  <% } %>
              <% } %>
              <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                  <a class="page-link" href="<%= pagination.currentPage === pagination.totalPages ? '#' : '/users?role=' + role + (searchdata ? '&search=' + searchdata : '') + '&page=' + (pagination.currentPage + 1) %>">
                      <i class="mdi mdi-chevron-right"></i>
                  </a>
              </li>
          </ul>
        </nav>
      </div>
      <% } %>
    </div>
  </div>
</div>


<script>
  async function deleteRecord(id) {
    $.alert({
      title: 'Confirm!',
      content: 'Are you sure you want to delete this record?',
      theme: 'material',
      useBootstrap: false,
      boxWidth: '30%',
      buttons: {
        confirm: {
          text: 'Yes',
          btnClass: 'btn-danger',
          action: async function () {
            const response = await fetch(`/users/${id}/delete`, {
              method: 'POST'
            });
            let result = await response.json();
            if (result.success === true) {
              $.alert({
                title: 'Success!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'green',
                buttons: {
                  confirm: {
                    text: 'OK',
                    btnClass: 'btn-success',
                    action: function () {
                      location.reload();
                    }
                  }
                }
              });
            } else {
              $.alert({
                title: 'Error!',
                content: result.message,
                boxWidth: '30%',
                theme: 'material',
                useBootstrap: false,
                type: 'red',
                buttons: {
                  confirm: {
                    text: 'OK',
                    btnClass: 'btn-danger',
                  }
                }
              });
            }
          }
        },
        cancel: {
          text: 'No',
          btnClass: 'btn-primary',
        }
      }
    });
  }
</script>