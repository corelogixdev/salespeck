<!doctype html>
<html data-layout="horizontal" data-topbar="light" data-sidebar="dark" data-sidebar-size="sm-hover" data-sidebar-image="none" data-preloader="disable">
<head>
    <meta charset="utf-8" />
    <title>OpenMenu</title>
    <link rel="icon" href="/assets/images/icon.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="/assets/js/layout.js"></script>
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/toastr.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/jquery-confirm.min.css" rel="stylesheet" type="text/css" />
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery-confirm.min.js"></script>
    <script src="/assets/js/theme-manager.js"></script>
    <script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
</head>
<style>
    .logo img {
        height: 50px;
    }
</style>
<body>
    <% if (typeof hidenav==='undefined' || hidenav !==true) { %>
        <div id="layout-wrapper">
            <header id="page-topbar">
                <div class="navbar-header">
                    <div class="d-flex">
                        <div class="navbar-brand-box horizontal-logo" style="padding-right: 10px;">
                            <a href="/" class="logo logo-dark">
                                <span class="logo-sm">
                                    <img src="/assets/images/icon.png" alt="" height="22">
                                </span>
                                <span class="logo-lg">
                                    <img src="/assets/images/icon.png" alt="" height="17">
                                </span>
                            </a>

                            <a href="/" class="logo logo-light">
                                <span class="logo-sm">
                                    <img src="/assets/images/icon.png" alt="" height="22">
                                </span>
                                <span class="logo-lg">
                                    <img src="/assets/images/icon.png" alt="" height="17">
                                </span>
                            </a>
                        </div>
                    </div>
                    <a href="/" style="display: block; min-width: fit-content;" class="fs-2 me-2">
                        Open Menu
                    </a>
                    <div id="scrollbar" class="navbar-menu" style="width: 100%;position: static;box-shadow: none;margin-top: 0; background-color: transparent;">
                        <div id="two-column-menu">
                        </div>
                        <ul class="navbar-nav" id="navbar-nav" style="display: flex;
                            flex-direction: row;
                            align-items: center;">
                            <li class="menu-title"><span data-key="t-menu">Menu</span></li>
                            <li class="nav-item">
                                <a class="nav-link menu-link pe-0" href="/" role="button">
                                    <i class="las la-tachometer-alt"></i> <span>Dashboard</span>
                                </a>
                            </li>
                            <% if (permissions.usersList || permissions.customersList) { %>
                                <li class="nav-item dropdown">
                                    <a class="nav-link menu-link" href="#sidebarStaff" data-bs-toggle="collapse"
                                        role="button" aria-expanded="false" aria-controls="sidebarStaff">
                                        <i class="las la-users"></i> <span>Staff</span>
                                    </a>
                                    <div class="collapse menu-dropdown" id="sidebarStaff">
                                        <ul class="nav nav-sm flex-column">
                                            <% if (permissions.usersList) { %>
                                                <li class="nav-item">
                                                    <a href="/users?role=user" class="nav-link">Users</a>
                                                </li>
                                            <% } %>
                                            <% if (permissions.customersList) { %>
                                                <li class="nav-item">
                                                    <a href="/users?role=customer"
                                                        class="nav-link">Customers</a>
                                                </li>
                                            <% } %>
                                        </ul>
                                    </div>
                                </li>
                            <% } %>
                            <% if (permissions.productsList) { %>
                                <li class="nav-item dropdown">
                                    <a class="nav-link menu-link" href="#sidebarProducts"
                                        data-bs-toggle="collapse" role="button"
                                        aria-expanded="false" aria-controls="sidebarProducts">
                                        <i class="las la-box"></i> <span>Products</span>
                                    </a>
                                    <div class="collapse menu-dropdown" id="sidebarProducts">
                                        <ul class="nav nav-sm flex-column">
                                            <li class="nav-item">
                                                <a href="/products" class="nav-link">Products List</a>
                                            </li>
                                            <% if (permissions.productsCreate) { %>
                                                <li class="nav-item">
                                                    <a href="/products/form" class="nav-link" target="_blank">New Product</a>
                                                </li>
                                            <% } %>
                                        </ul>
                                    </div>
                                </li>
                            <% } %>
                            <% if (permissions.settings) { %>
                                <li class="nav-item">
                                    <a class="nav-link menu-link pe-0" href="/settings" role="button">
                                        <i class="las la-cog"></i> <span>Settings</span>
                                    </a>
                                </li>
                            <% } %>
                            <% if (permissions.salesView || permissions.salesCreate ||
                                permissions.salesList) { %>
                                <li class="nav-item dropdown">
                                    <a class="nav-link menu-link" href="#sidebarSales"
                                        data-bs-toggle="collapse" role="button"
                                        aria-expanded="false" aria-controls="sidebarSales">
                                        <i class="las la-shopping-cart"></i> <span>Sales</span>
                                    </a>
                                    <div class="collapse menu-dropdown" id="sidebarSales">
                                        <ul class="nav nav-sm flex-column">
                                            <% if (permissions.salesView) { %>
                                                <li class="nav-item">
                                                    <a href="/sales" class="nav-link">Sales Report</a>
                                                </li>
                                            <% } %>
                                            <% if (permissions.salesCreate) { %>
                                                <li class="nav-item">
                                                    <a href="/sales/form"
                                                        class="nav-link"
                                                        target="_blank">New Sale</a>
                                                </li>
                                            <% } %>
                                        </ul>
                                    </div>
                                </li>
                            <% } %>
                            <li class="nav-item dropdown">
                                <a class="nav-link menu-link" href="#sidebarHR"
                                    data-bs-toggle="collapse" role="button"
                                    aria-expanded="false" aria-controls="sidebarHR">
                                    <i class="las la-user-tie"></i> <span>HR</span>
                                </a>
                                <div class="collapse menu-dropdown" id="sidebarHR">
                                    <ul class="nav nav-sm flex-column">
                                        <li class="nav-item">
                                            <a href="/attendance"
                                                class="nav-link">Attendance</a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="/leaves"
                                                class="nav-link">Leaves</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link menu-link" href="#sidebarSalaries"
                                                data-bs-toggle="collapse" role="button"
                                                aria-expanded="false" aria-controls="sidebarSalaries">
                                                Salaries
                                            </a>
                                            <div class="collapse menu-dropdown" id="sidebarSalaries">
                                                <ul class="nav nav-sm flex-column">
                                                    <li class="nav-item">
                                                        <a href="/salaries/templates"
                                                            class="nav-link">Salery
                                                            Templates</a>
                                                    </li>
                                                    <li class="nav-item">
                                                        <a href="/salaries/calculate"
                                                            class="nav-link">Calculate
                                                            Salaries</a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </li>

                            <!-- Add new Others dropdown menu -->
                            <li class="nav-item dropdown">
                                <a class="nav-link menu-link" href="#sidebarOthers"
                                    data-bs-toggle="collapse" role="button"
                                    aria-expanded="false" aria-controls="sidebarOthers">
                                    <!-- <i class="las la-ellipsis-h"></i>  -->
                                    <span>Others</span>
                                </a>
                                <div class="collapse menu-dropdown" id="sidebarOthers">
                                    <ul class="nav nav-sm flex-column">
                                        <li class="nav-item">
                                            <a href="https://openmenu.live" target="_blank" class="nav-link">
                                                <i class="las la-globe"></i> OpenMenu Live
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="/news" class="nav-link">
                                                <i class="las la-newspaper"></i> News
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a href="/help" class="nav-link">
                                                <i class="las la-question-circle"></i> Help
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="d-flex align-items-center">
                        <!-- <div class="ms-1 header-item d-none d-sm-flex">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
                                data-toggle="fullscreen">
                                <i class='bx bx-fullscreen fs-22'></i>
                            </button>
                        </div> -->

                        <div class="ms-1 header-item d-none d-sm-flex">
                            <button type="button" id="themeToggleBtn"
                                class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle light-dark-mode">
                                <i class='bx bx-moon fs-22'></i>
                            </button>
                        </div>

                        <div class="dropdown topbar-head-dropdown ms-1 header-item" id="notificationDropdown">
                            <button type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle"
