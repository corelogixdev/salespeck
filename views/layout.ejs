        <script>
            $(document).ready(function () {
                setTimeout(() => {
                    $('.format-date').each(function () {
                        var date = $(this).text();
                        $(this).text(moment(date).format('DD MMM YYYY'));
                    });
                });

                // Handle "New Sale" link - create tab if already on sales form page
                const newSaleLink = document.getElementById('new-sale-menu-link');
                if (newSaleLink) {
                    newSaleLink.addEventListener('click', function(e) {
                        // Check if we're already on the sales form page
                        if (window.location.pathname === '/sales/form') {
                            e.preventDefault();
                            // Trigger new tab creation if the function exists
                            if (typeof createNewTab === 'function') {
                                createNewTab();
                            } else {
                                // If tabs aren't initialized yet, wait a bit
                                setTimeout(() => {
                                    const newTabBtn = document.getElementById('new-sale-tab-btn');
                                    if (newTabBtn) {
                                        newTabBtn.click();
                                    }
                                }, 100);
                            }
                        }
                        // Otherwise, let the default navigation happen
                    });
                }
            });
        </script>
