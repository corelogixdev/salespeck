<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>OpenMenu</title>
  <!-- add favicon -->
  <link rel="icon" href="/assets/images/icon.ico" type="image/x-icon">
  <!-- Bootstrap CSS -->
  <link href="/node_modules/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css" rel="stylesheet">

  <!-- Include SweetAlert2 CSS -->
  <link rel="stylesheet" href="/node_modules/sweetalert2/dist/sweetalert2.min.css">
  <!-- Include Toastr CSS -->
  <link rel="stylesheet" href="/node_modules/toastr/build/toastr.min.css">

  <style>
    .custom_disabled {
      pointer-events: none;
      cursor: not-allowed;
      opacity: 0.5;
    }
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/dashboard"><img src="/assets/images/icon.png" style="width: 50px;">Open Menu</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <% if (user.role == 'admin') { %>
            <li class="nav-item">
              <a class="nav-link" href="/users?role=user">Users</a>
            </li>
          <li class="nav-item">
            <a class="nav-link" href="/products">Products</a>
          </li>
            <li class="nav-item">
              <a class="nav-link" href="/settings">Settings</a>
            </li>
            <% } %>
            <li class="nav-item">
              <a class="nav-link" href="/users?role=customer">Customers</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/sales" target="_blank">Sales</a>
            </li>
        </ul>
        <div class="d-flex gap-2 position-relative">
          <div class="result">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" id="navbar-search-input">
            <div id="result" style="position: absolute; top: 40px; border-radius: 10px; width: 100%; display: none; z-index: 9999;" class="card"></div>
          </div>
          <button class="btn btn-secondary" id="logout-btn"><i class="fa-solid fa-right-from-bracket"></i></button>
          <button class="btn btn-danger" id="close-btn"><i class="fa-solid fa-power-off"></i></button>
        </div>
      </div>
    </div>
  </nav>
  <div class="m-3">
    <%- body %>
  </div>
  <!-- Bootstrap JS, Popper.js, and jQuery -->
  <script src="/node_modules/jquery/dist/jquery.min.js"></script>
  <script src="/node_modules/popper.js/dist/umd/popper.min.js"></script>
  <script src="/node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
  <!-- Include SweetAlert2 JS -->
  <script src="/node_modules/sweetalert2/dist/sweetalert2.all.min.js"></script>
  <!-- Include Toastr JS -->
  <script src="/node_modules/toastr/build/toastr.min.js"></script>
  <script src="/node_modules/chart.js/dist/chart.umd.js"></script>

  <script>
    <% if (typeof message !== 'undefined' && message) { %>
      var message = JSON.parse('<%- JSON.stringify(message) %>');
      //console.log(message);
      // Swal.fire({
      //   icon: '<%= message.type %>',
      //   title: '<%= message.text %>',
      //   showConfirmButton: false,
      //   timer: 3000
      // });

      //show toaster
      toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-bottom-right",
        "showDuration": "300",
        "hideDuration": "1000",
        "timeOut": "5000",
        "extendedTimeOut": "1000",
        "showEasing": "swing",
        "hideEasing": "linear",
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut"
      }
      toastr[message.type](message.text);
    <% } %>
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      async function FetchData(query){
        try {
          const response = await fetch('/products/search', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ query }),
          });
          const data = await response.json();
          return data;
        } catch (error) {
          console.error('Error:', error);
        }
      }
      const searchInput = document.getElementById('navbar-search-input');
      let typingTimer;
      const typingInterval = 500; // 500ms
      searchInput.addEventListener('input', () => {
        clearTimeout(typingTimer);
        typingTimer = setTimeout(async () => {
          const query = searchInput.value;
          try {
            let response=await FetchData(query);
            let result = document.getElementById('result');
            result.innerHTML = '';
            result.style.display = 'block';
            if(response.data.length>0){
              response.data.forEach((item) => {
                let a = document.createElement('a');
                a.classList.add('dropdown-item', 'd-flex', 'justify-content-between', 'p-2', 'align-items-center', 'search-result');
                let span = document.createElement('span');
                span.innerText = item.name.substring(0, 20);
                a.appendChild(span);
                let span2 = document.createElement('span');
                span2.innerText = 'Rs.' + item.saleprice ?? 0;
                a.appendChild(span2);
                result.appendChild(a);
              });
            }else{
              let p = document.createElement('p');
              p.style.textWrap = 'auto';
              p.classList.add('dropdown-item', 'p-2', 'align-items-center', 'search-result');
              if(query){
                p.innerText = 'No data found for "'+query.substring(0, 20)+'"';
              }else{
                p.innerText = 'Type to search';
              }
              result.appendChild(p);
            }
          } catch (error) {
            console.error('Error:', error);
          }
        }, typingInterval);
      });
      searchInput.addEventListener('focus', () => {
        if (searchInput.value) {
          document.getElementById('result').style.display = 'block';
        }
      });
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.result')) {
          document.getElementById('result').style.display = 'none';
        }
      });

      document.querySelectorAll('.custom_disabled').forEach(link => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
        });
      });
    });

    document.getElementById('close-btn').addEventListener('click', () => {
      const dataToSend = { message: 'close-app' };
      if (window.api) {
        window.api.performAction(dataToSend); // Send data to main process
      }
    });

    document.getElementById('logout-btn').addEventListener('click', () => {
      window.location.href = '/logout';
    });

    if (window.api) {
      window.api.onActionResponse((response) => {
        console.log(response);
        //document.getElementById('response').innerText = response;
      });
    }
  </script>
</body>

</html>