    <!-- Global toast notification script -->
    <script>
        $(document).ready(function () {
            <% if (typeof message !== 'undefined' && message) { %>
                toastr.options = {
                    "closeButton": true,
                        "progressBar": true,
                            "positionClass": "toast-bottom-right",
