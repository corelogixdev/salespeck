<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">Customer Report</h4>
        <div class="d-flex gap-2">
          <button onclick="window.print()" class="btn btn-soft-info btn-sm">
            <i class="ri-printer-line"></i> Print
          </button>
        </div>
      </div>
      <div class="card-body">
        <!-- Filters -->
        <form method="GET" action="/reports/customers" class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" name="startDate" value="<%= reportData.filters.startDate || '' %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" name="endDate" value="<%= reportData.filters.endDate || '' %>">
          </div>
          <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
              <i class="ri-search-line me-1"></i> Filter
            </button>
          </div>
        </form>

        <!-- Summary Cards -->
        <div class="row mb-4">
          <div class="col-md-4">
            <div class="card border border-primary">
              <div class="card-body">
                <h6 class="text-muted mb-2">Total Customers</h6>
                <h4 class="mb-0"><%= reportData.totals.totalCustomers %></h4>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border border-success">
              <div class="card-body">
                <h6 class="text-muted mb-2">Total Sales</h6>
                <h4 class="mb-0"><%= reportData.totals.totalSales %></h4>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border border-info">
              <div class="card-body">
                <h6 class="text-muted mb-2">Total Revenue</h6>
                <h4 class="mb-0"><%= formatNumber(reportData.totals.totalRevenue) %></h4>
              </div>
            </div>
          </div>
        </div>

        <!-- Export Buttons -->
        <div class="d-flex gap-2 mb-3">
          <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, format: 'csv'}).toString() %>" class="btn btn-success btn-sm">
            <i class="ri-file-excel-line me-1"></i> Export CSV
          </a>
          <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, format: 'excel'}).toString() %>" class="btn btn-success btn-sm">
            <i class="ri-file-excel-2-line me-1"></i> Export Excel
          </a>
          <a href="/reports/customers?<%= new URLSearchParams({...reportData.filters, format: 'pdf'}).toString() %>" target="_blank" class="btn btn-danger btn-sm">
            <i class="ri-file-pdf-line me-1"></i> Export PDF
          </a>
        </div>

        <!-- Report Table -->
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th class="text-end">Total Purchases</th>
                <th class="text-end">Total Spent</th>
                <th>Last Purchase</th>
              </tr>
            </thead>
            <tbody>
              <% reportData.customers.forEach(customer => { %>
                <tr>
                  <td><%= `${customer.firstname || ''} ${customer.lastname || ''}`.trim() || 'N/A' %></td>
                  <td><%= customer.phone || 'N/A' %></td>
                  <td><%= customer.email || 'N/A' %></td>
                  <td class="text-end"><%= customer.totalPurchases || 0 %></td>
                  <td class="text-end"><%= formatNumber(customer.totalSpent) %></td>
                  <td>
                    <%= customer.lastPurchaseDate 
                      ? moment(customer.lastPurchaseDate).format('YYYY-MM-DD') 
                      : 'Never' %>
                  </td>
                </tr>
              <% }) %>
              <% if (reportData.customers.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center">No customers found</td>
                </tr>
              <% } %>
            </tbody>
            <tfoot>
              <tr class="fw-bold">
                <td colspan="3">TOTAL</td>
                <td class="text-end"><%= reportData.totals.totalSales %></td>
                <td class="text-end"><%= formatNumber(reportData.totals.totalRevenue) %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="text-muted mt-3">
          <small>Report generated on: <%= moment(reportData.generatedAt).format('YYYY-MM-DD HH:mm:ss') %></small>
        </div>
      </div>
    </div>
  </div>
</div>
