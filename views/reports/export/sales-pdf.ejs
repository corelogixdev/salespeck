<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Sales Report</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { color: #333; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    .text-end { text-align: right; }
    .summary { margin-top: 20px; }
  </style>
</head>
<body>
  <h1>Sales Report</h1>
  <p><strong>Generated:</strong> <%= moment(reportData.generatedAt).format('YYYY-MM-DD HH:mm:ss') %></p>
  <% if (reportData.filters.startDate || reportData.filters.endDate) { %>
    <p><strong>Period:</strong> <%= reportData.filters.startDate || 'All' %> to <%= reportData.filters.endDate || 'All' %></p>
  <% } %>
  
  <table>
    <thead>
      <tr>
        <th>Invoice #</th>
        <th>Date</th>
        <th>Customer</th>
        <th>Total Price</th>
        <th>Payment</th>
        <th>Discount</th>
      </tr>
    </thead>
    <tbody>
      <% reportData.sales.forEach(sale => { %>
        <tr>
          <td><%= sale.invoicenum || 'N/A' %></td>
          <td><%= moment(sale.createdAt).format('YYYY-MM-DD') %></td>
          <td><%= sale.Customer ? `${sale.Customer.firstname || ''} ${sale.Customer.lastname || ''}`.trim() : 'Walk-in' %></td>
          <td class="text-end"><%= parseFloat(sale.totalprice || 0).toFixed(2) %></td>
          <td class="text-end"><%= parseFloat(sale.totalpayment || 0).toFixed(2) %></td>
          <td class="text-end"><%= (parseFloat(sale.totalprice || 0) - parseFloat(sale.totalpayment || 0)).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr style="font-weight: bold;">
        <td colspan="3">TOTAL</td>
        <td class="text-end"><%= reportData.totals.totalAmount.toFixed(2) %></td>
        <td class="text-end"><%= reportData.totals.totalPayment.toFixed(2) %></td>
        <td class="text-end"><%= reportData.totals.totalDiscount.toFixed(2) %></td>
      </tr>
    </tfoot>
  </table>
</body>
</html>
