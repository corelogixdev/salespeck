<div class="page_header d-flex justify-content-between align-items-center mb-3">
    <h3>
        <%= title %>
    </h3>
    <div>
        <a href="/sales/form" class="btn btn-primary"><i class="fas fa-plus"></i> Sales</a>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <!-- SEARCH SECTION -->
        <form id="search-form" class="mb-4" action="/sales/search" method="POST">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="customer-search">Customer Name:</label>
                        <input type="text" class="form-control" id="customer-search" name="customer" placeholder="Search by customer name" value="<%= searchquery.customer %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="date-range">Date Range:</label>
                        <input type="text" class="form-control" id="date-range" name="daterange" placeholder="Select date range" value="<%= searchquery.daterange %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="product-id-search">Product ID:</label>
                        <input type="text" class="form-control" id="product-id-search" name="productId" placeholder="Search by product ID" value="<%= searchquery.productId %>">
                    </div>
                </div>
                <div class="col-md-2 d-flex flex-column align-items-center justify-content-center">
                    <div class="col w-75">
                        <button type="submit" class="btn btn-sm btn-primary w-100 d-block">
                            <i class="fas fa-search"></i> &nbsp; Search
                        </button>
                    </div>
                    <div class="col w-75 mt-1">
                        <button id="reset" type="button" class="btn btn-sm btn-info w-100 d-block">
                            <i class="fas fa-x"></i> &nbsp; Clear Search
                        </button>
                    </div>
                </div>
            </div>
        </form>
        <hr class="my-2">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Discount Percentage</th>
                    <th>Total</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% sales.forEach((sale, index)=> { %>
                    <% let products=sale.SoldPoducts.map(({Product})=>Product.name).join(', ') %>
                        <tr>
                            <td>
                                <%= sale.id %>
                            </td>
                            <td class="limit-text" title="<%= products %>">
                                <%= sale.SoldPoducts.map(({Product})=>Product.name).join(', ') %>
                            </td>
                            <td>
                                <%= sale.discountpercentage %>
                            </td>
                            <td>
                                <%= sale.totalpayment %>
                            </td>
                            <td class="date">
                                <%= sale.createdAt %>
                            </td>
                            <td>
                                <a href="/sales/<%= sale.id %>" class="btn btn-primary btn-sm" title="View Sale" target="_blank"><i
                                        class="fas fa-eye"></i></a>
                            </td>
                        </tr>
                        <% }) %>
                        <% if (!sales.length) { %>
                            <tr>
                                <td colspan="6" style="text-align: center;">
                                    <i class="fas fa-exclamation-triangle"></i> No data found
                                </td>
                            </tr>
                            <% } %>
            </tbody>
        </table>
    </div>
</div>
<!-- <script src="/node_modules/jquery/dist/jquery.min.js"></script> -->
<script src="/assets/js/jquery.min.js"></script>
<script src="/assets/js/moment.min.js"></script>
<script src="/assets/js/daterangepicker.min.js"></script>
<script>
    let daterange;
    $(function () {
        $('#date-range').daterangepicker({
            opens: 'center'
        }, function (start, end, label) {
            daterange = start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD');
        });
    });
    // format all dates with class 'date'
    $('.date').each(function () {
        $(this).text(moment($(this).text()).format('MMM DD, YYYY'));
        console.clear();
    });
    // on click of reset button clear form and refresh route
    $('#reset').click(function () {
        $('#search-form').trigger('reset');
        window.location.href = '/sales';
    });
</script>