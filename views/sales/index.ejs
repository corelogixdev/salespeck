<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1"><%= title %></h4>
        <div class="d-flex gap-2">
          <button onclick="window.location.reload()" class="btn btn-soft-success btn-sm" title="Refresh">
            <i class="ri-refresh-line align-middle"></i> Refresh
          </button>
        </div>
      </div>

      <div class="card-body">
        <div class="live-preview">
          <!-- Search Form -->
           <% if (permissions.salesSearch) { %>
            <form id="search-form" method="POST" action="/sales" class="row g-3 mb-4">
              <div class="col-xxl-3 col-sm-4">
                <div class="search-box">
                  <input type="text" 
                        class="form-control search flatpickr-range"
                        data-provider="flatpickr" 
                        data-range="true"
                        data-date-format="Y-m-d"
                        name="daterange" 
                        placeholder="Filter by date range..."
                        value="<%= searchquery?.daterange || '' %>">
                  <i class="ri-calendar-2-line search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-3 col-sm-3">
                <div class="search-box">
                  <input type="text" 
                        class="form-control search" 
                        name="customer"
                        placeholder="Search by customer..."
                        value="<%= searchquery?.customer || '' %>">
                  <i class="ri-user-line search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-3 col-sm-3">
                <div class="search-box">
                  <input type="number" 
                        class="form-control search" 
                        name="productId"
                        placeholder="Search by product ID..."
                        value="<%= searchquery?.productId || '' %>">
                  <i class="ri-shopping-basket-2-line search-icon"></i>
                </div>
              </div>
              <div class="col-xxl-2 col-sm-2 d-flex align-items-center justify-content-end">
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">
                    <i class="ri-search-line me-1 align-bottom"></i> Search
                  </button>
                  <% if (searchquery?.daterange || searchquery?.customer || searchquery?.productId) { %>
                    <button type="button" id="reset" class="btn btn-sm btn-danger">
                      <i class="ri-close-line align-bottom me-1"></i> Clear
                    </button>
                  <% } %>
                </div>
              </div>
            </form>
          <% } %>

          <!-- Table -->
          <div class="table-responsive">
            <table class="table table-striped table-nowrap align-middle mb-0">
            <thead>
                <tr>
                <th scope="col">Sale ID</th>
                <th scope="col">Product</th>
                <th scope="col">Discount %</th>
                <th scope="col">Total</th>
                <th scope="col">Created At</th>
                <th scope="col" style="text-align: end;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (!sales.length) { %>
                <tr>
                    <td colspan="6" class="text-center">
                    <i class="ri-error-warning-line align-middle me-1"></i> No sales found
                    </td>
                </tr>
                <% } else { %>
                <% sales.forEach((sale, index)=> { %>
                    <% let products=sale.SoldPoducts.map(({Product})=>Product.name).join(', ') %>
                    <tr>
                    <td class="fw-medium"><%= sale.id %></td>
                    <td class="limit-text" title="<%= products %>">
                        <%= products %>
                    </td>
                    <td><%= sale.discountpercentage %>%</td>
                    <td>Rs.<%= parseFloat(sale.totalpayment).toFixed(2) %></td>
                    <td class="date"><%= sale.createdAt %></td>
                    <td style="text-align: end;">
                        <a href="/sales/<%= sale.id %>" 
                            class="btn btn-soft-primary btn-sm" 
                            title="View Sale" 
                            target="_blank">
                        <i class="ri-eye-fill align-middle"></i> View
                        </a>
                    </td>
                    </tr>
                <% }) %>
                <% } %>
            </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .limit-text {
    max-width: 250px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

/* Search box styling */
.search-box {
    position: relative;
}

.search-box .search-icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    color: var(--vz-gray-600);
}

.search-box .form-control {
    padding-left: 35px;
    background-color: var(--vz-card-bg-custom);
    border-color: var(--vz-border-color);
}

.search-box .form-control:focus {
    border-color: var(--vz-primary);
}

.search-box .flatpickr-range {
    background-color: var(--vz-card-bg-custom);
}
</style>

<script src="/assets/js/jquery.min.js"></script>
<script src="/assets/js/moment.min.js"></script>
<script src="/assets/js/daterangepicker.min.js"></script>
<script>
$(document).ready(function() {
    // Initialize flatpickr
    flatpickr(".flatpickr-range", {
        mode: "range",
        placeholder: "Filter by date range",
        dateFormat: "Y-m-d"
    });

    // Format dates
    $('.date').each(function() {
        let date = new Date($(this).text());
        $(this).text(moment(date).format('D MMM, YYYY'));
    });

    // Reset form
    $('#reset').click(function() {
        window.location.href = '/sales';
    });
});
</script>