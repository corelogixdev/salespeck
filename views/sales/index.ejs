<div class="row">
<div class="col-lg-12">
    <div class="card">
    <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1"><%= title %></h4>
        <div class="flex-shrink-0">
        <a href="/sales/form" class="btn btn-primary">
            <i class="ri-add-line align-middle"></i> New Sale
        </a>
        </div>
    </div>

    <div class="card-body">
        <form id="search-form" class="mb-4 border-bottom pb-4" action="/sales/search" method="POST">
        <div class="row align-items-center justify-content-center">
            <div class="col-md-3">
            <div class="form-group">
                <label for="customer-search">Customer Name:</label>
                <input type="text" class="form-control" id="customer-search" name="customer" placeholder="Search by customer name" value="<%= searchquery.customer %>">
            </div>
            </div>
            <div class="col-md-3">
            <div class="form-group">
                <label for="date-range">Date Range:</label>
                <div class="input-group">
                <input name="daterange" id="date-range" type="text" class="form-control border-0 fs-13 dash-filter-picker shadow" data-provider="flatpickr" data-range-date="true" data-date-format="d M, Y" data-deafult-date="<%= searchquery.daterange %>">
                <label for="date-range" role="button" class="input-group-text bg-secondary border-secondary text-white">
                    <i class="ri-calendar-2-line"></i>
                </label>
                </div>
            </div>
            </div>
            <div class="col-md-3">
            <div class="form-group">
                <label for="product-id-search">Product ID:</label>
                <input type="text" class="form-control" id="product-id-search" name="productId" placeholder="Search by product ID" value="<%= searchquery.productId %>">
            </div>
            </div>
            <div class="col-md-2 d-flex flex-column align-items-center justify-content-center">
            <div class="col w-75">
                <button type="submit" class="btn btn-sm btn-primary w-100 d-block">
                <i class="fas fa-search"></i> &nbsp; Search
                </button>
            </div>
            <div class="col w-75 mt-1">
                <button id="reset" type="button" class="btn btn-sm btn-info w-100 d-block">
                <i class="fas fa-x"></i> &nbsp; Clear Search
                </button>
            </div>
            </div>
        </div>
        </form>
        
        <div class="live-preview">
        <div class="table-responsive">
            <table class="table table-striped table-nowrap align-middle mb-0">
            <thead>
                <tr>
                <th scope="col">Sale ID</th>
                <th scope="col">Product</th>
                <th scope="col">Discount %</th>
                <th scope="col">Total</th>
                <th scope="col">Created At</th>
                <th scope="col" style="text-align: end;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (!sales.length) { %>
                <tr>
                    <td colspan="6" class="text-center">
                    <i class="ri-error-warning-line align-middle me-1"></i> No sales found
                    </td>
                </tr>
                <% } else { %>
                <% sales.forEach((sale, index)=> { %>
                    <% let products=sale.SoldPoducts.map(({Product})=>Product.name).join(', ') %>
                    <tr>
                    <td class="fw-medium"><%= sale.id %></td>
                    <td class="limit-text" title="<%= products %>">
                        <%= products %>
                    </td>
                    <td><%= sale.discountpercentage %>%</td>
                    <td>Rs.<%= parseFloat(sale.totalpayment).toFixed(2) %></td>
                    <td class="date"><%= sale.createdAt %></td>
                    <td style="text-align: end;">
                        <a href="/sales/<%= sale.id %>" 
                            class="btn btn-soft-primary btn-sm" 
                            title="View Sale" 
                            target="_blank">
                        <i class="ri-eye-fill align-middle"></i> View
                        </a>
                    </td>
                    </tr>
                <% }) %>
                <% } %>
            </tbody>
            </table>
        </div>
        </div>
    </div>
    </div>
</div>
</div>

<style>
  .limit-text {
    max-width: 250px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script src="/assets/js/jquery.min.js"></script>
<script src="/assets/js/moment.min.js"></script>
<script src="/assets/js/daterangepicker.min.js"></script>
<script>
  $('#reset').click(function () {
    $('#search-form').find('input').val('');
    $('#search-form').submit();
  });
  $('.dash-filter-picker').attr('placeholder', moment().format('D MMM, YYYY'));
  if (!$('.dash-filter-picker').val()) {
    $('.dash-filter-picker').val(new Date());
}
  $('.date').each(function () {
    let date = new Date($(this).text());
    $(this).text(moment(date).format('D MMM, YYYY'));
  });
</script>