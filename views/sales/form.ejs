<div class="container" style="height: 83vh;">
    <div class="row justify-content-between" style="height: 100%;">
        <div class="col-lg-6 row flex-column justify-content-between h-100">
            <div>
                <div class="mb-3" id="search-product-sales-page-search-seaction" style="position: relative;">
                    <label for="product-search" class="form-label">Search Product:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="product-search"
                            placeholder="Enter product name or ID">
                        <div class="input-group-text">
                            <input type="checkbox" id="search-barcode"> Barcode
                        </div>
                    </div>
                    <div id="search-results" class="shadow rounded p-3 d-none"
                        style="position: absolute; width: 100%; z-index: 9999; background-color: white;"></div>
                </div>
            </div>
            <div>
                <div class="mb-3">
                    <label for="customer" class="form-label">Customer:</label>
                    <select id="customer" class="form-select">
                        <option value="">Select Customer</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Total Bill:</label>
                    <span id="total-bill-amount" class="form-control-plaintext d-inline">Rs.0.00</span>
                </div>
                <div class="mb-3">
                    <label for="discountpercentage" class="form-label">Discount Percentage</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="discountpercentage" value="0">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="total-payment" class="form-label">Total Payment:</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="total-payment">
                        <div class="input-group-text">
                            <input type="checkbox" id="ledger"> Ledger
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-responsive border" style="height: 80%; overflow-y: auto;">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="selected-products">
                    </tbody>
                </table>
            </div>
            <button class="btn btn-primary w-100 mt-5" onclick="sale()">Sale</button>
        </div>
    </div>
</div>
<style>
    .search-result-product:hover {
        background-color: #f8f9fa;
    }
</style>
<script>
    const productSearch = document.getElementById('product-search');
    const searchBarcode = document.getElementById('search-barcode');
    const customerDropdown = document.getElementById('customer');
    const totalBillAmount = document.getElementById('total-bill-amount');
    const totalPayment = document.getElementById('total-payment');
    const ledgerCheckbox = document.getElementById('ledger');
    const selectedProductsTable = document.getElementById('selected-products');
    let selectedProduct = null;
    let allProducts = [];
    async function fetchCustomers() {
        const response = await fetch('/users/customers');
        const customers = await response.json();
        customers.forEach(customer => {
            const option = document.createElement('option');
            option.value = customer.id;
            option.textContent = customer.name;
            customerDropdown.appendChild(option);
        });
    }
    function removeProduct(productId) {
        const row = document.getElementById(`product-row-${productId}`);
        if (row) {
            row.remove();
            updateTotalBill();
        }
    }
    function updateTotalBill() {
        let total = 0;
        let rows = document.querySelectorAll('#selected-products tr');
        rows.forEach(row => {
            const price = parseFloat(row.querySelector('.total-price').textContent);
            total += price;
        });
        totalBillAmount.textContent = `Rs. ${total.toFixed(2)}`;
    }
    function addProduct(product) {
        // if a product is already added, increase the quantity
        const existingRow = document.getElementById(`product-row-${product.id}`);
        if (existingRow) {
            const quantityElement = existingRow.querySelector('td:nth-child(3)');
            const priceElement = existingRow.querySelector('td:nth-child(4)');
            const totalElement = existingRow.querySelector('td:nth-child(5)');
            const quantity = parseInt(quantityElement.textContent);
            if (product.quantity <= quantity) {
                alert('Product quantity is not available');
                return;
            }
            quantityElement.textContent = quantity + 1;
            totalElement.textContent = ((quantity + 1) * parseFloat(priceElement.textContent)).toFixed(2);
            updateTotalBill();
            return;
        }
        product.quantity = 1;
        const row = document.createElement('tr');
        row.id = `product-row-${product.id}`;
        row.innerHTML = `
        <td>${product.id}</td>
        <td>${product.name}</td>
        <td>${product.quantity}</td>
        <td class="product-price">${product.saleprice}</td>
        <td class="total-price">${(product.quantity * product.saleprice).toFixed(2)}</td>
        <td>
          <button class="btn btn-danger btn-sm" onclick="removeProduct('${product.id}')">
            <i class="fas fa-trash-alt"></i>
          </button>
        </td>
      `;
        selectedProductsTable.appendChild(row);
        updateTotalBill();
    }
    function sale(){
        const customer = customerDropdown.value;
        const discountpercentage = parseInt(document.getElementById('discountpercentage').value);
        const totalPaymentValue = parseFloat(totalPayment.value);
        const ledger = ledgerCheckbox.checked;
        const products = [];
        document.querySelectorAll('#selected-products tr').forEach(row => {
            const productId = row.querySelector('td:nth-child(1)').textContent;
            const quantity = parseInt(row.querySelector('td:nth-child(3)').textContent);
            products.push({ productId, quantity });
        });
        fetch('/sales/save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ customer, discountpercentage, totalPayment: totalPaymentValue, ledger, products }),
        }).then(response => {
            if (response.ok) {
                alert('Sale added successfully');
                window.location.href = '/sales';
            } else {
                alert('Failed to add sale');
            }
        });
    }
    document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (event) => {
            if (!event.target.closest('#search-product-sales-page-search-seaction')) {
                document.getElementById('search-results').classList.add('d-none');
            }
        });
        productSearch.addEventListener('keydown', (event) => {
            const searchResults = document.getElementById('search-results');
            if (!searchResults.classList.contains('d-none')) {
                if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
                    event.preventDefault();
                }
                if (event.key === 'Enter') {
                    let _selectedProduct = allProducts.find(p => p.id === parseInt(selectedProduct));
                    if (_selectedProduct) {
                        addProduct(_selectedProduct);
                        productSearch.value = '';
                        searchResults.classList.add('d-none');
                    }
                }
                const productResults = searchResults.querySelectorAll('.search-result-product');
                if (productResults.length > 0) {
                    if (selectedProduct) {
                        const selectedElement = document.getElementById(`product-${selectedProduct}`);
                        selectedElement.style.backgroundColor = '';
                        let nextElement = null;
                        if (event.key === 'ArrowUp') {
                            nextElement = selectedElement.previousElementSibling;
                        } else if (event.key === 'ArrowDown') {
                            nextElement = selectedElement.nextElementSibling;
                        }
                        if (nextElement) {
                            selectedProduct = nextElement.id.split('-')[1];
                            nextElement.style.backgroundColor = '#f8f9fa';
                        } else {
                            selectedProduct = productResults[0].id.split('-')[1];
                            productResults[0].style.backgroundColor = '#f8f9fa';
                        }
                    } else {
                        selectedProduct = productResults[0].id.split('-')[1];
                        productResults[0].style.backgroundColor = '#f8f9fa';
                    }
                }
            }
        });
        productSearch.addEventListener('input', async () => {
            const query = productSearch.value;
            if (query.length === 0) {
                document.getElementById('search-results').classList.add('d-none');
                return;
            }
            const searchByBarcode = searchBarcode.checked;
            const response = await fetch('/products/get', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(searchByBarcode ? { barcode: query } : { name: query }),
            });
            const products = await response.json();

            const searchResults = document.getElementById('search-results');
            searchResults.classList.remove('d-none');
            searchResults.innerHTML = '';
            // get the matching product from all products and display them as result 
            let filteredProds = products.filter(product => product.name.toLowerCase().includes(query.toLowerCase()));
            filteredProds.forEach(product => {
                const productElement = document.createElement('div');
                productElement.classList.add('search-result-product', 'p-2', 'd-flex', 'justify-content-between', 'align-items-center');
                productElement.id = `product-${product.id}`;
                productElement.style.cursor = 'pointer';
                productElement.innerHTML = `
                    <span>${product.name}</span>
                    <span>Rs. ${product.saleprice}</span>
                    `;
                productElement.addEventListener('click', () => {
                    addProduct(product);
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                });
                searchResults.appendChild(productElement);
            });
        });

        fetchCustomers();
    });
</script>

