<!-- Tab Bar -->
<div class="card mb-3">
    <div class="card-body p-2">
        <ul class="nav nav-tabs nav-tabs-custom mb-0" id="sale-tabs" role="tablist">
            <!-- Tabs will be dynamically added here -->
        </ul>
        <button class="btn btn-sm btn-primary mt-2" id="new-sale-tab-btn">
            <i class="ri-add-line"></i> New Sale
        </button>
    </div>
</div>

<!-- Tab Content Container -->
<div id="sale-tab-content-container" style="height: 85vh; margin-top: -14px;">
    <!-- Tab content will be dynamically added here -->
</div>

<style>
    .search-result-product {
        transition: all 0.2s;
        color: var(--vz-body-color);
    }

    .search-result-product:hover {
        background-color: var(--vz-light);
    }

    .editable-input {
        outline: none;
        width: 50px;
        border: none;
        background-color: transparent;
        border-bottom: 1px solid transparent;
        pointer-events: none;
        text-align: center;
    }

    .tab-content-panel {
        display: none;
    }

    .tab-content-panel.active {
        display: block;
    }

    #search-results {
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
        background-color: var(--vz-card-bg);
        border: 1px solid var(--vz-border-color);
    }

    .select2-dropdown-custom {
        max-height: 200px;
        overflow-y: auto;
    }

    .select2-container--bootstrap-5 .select2-selection {
        min-height: 38px;
    }

    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        color: var(--vz-body-color);
        line-height: 36px;
    }

    .select2-container--bootstrap-5 .select2-dropdown {
        background-color: var(--vz-card-bg);
        border-color: var(--vz-border-color);
    }

    .select2-container--bootstrap-5 .select2-results__option {
        padding: 8px 12px;
        color: var(--vz-body-color);
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted {
        background-color: var(--vz-primary);
    }

    .product-name small {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    .product-name-cell {
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .nav-tabs .nav-link {
        position: relative;
        padding-right: 30px;
    }

    .tab-close-btn {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        font-size: 16px;
        cursor: pointer;
        padding: 0 4px;
        opacity: 0.6;
    }

    .tab-close-btn:hover {
        opacity: 1;
        color: var(--vz-danger);
    }
</style>

<script>
    // Tab Management System
    let saleTabs = [];
    let currentTabId = null;
    let tabCounter = 0;
    let allProducts = [];

    // Initialize first tab on page load
    document.addEventListener('DOMContentLoaded', () => {
        createNewTab();
        
        // New Sale button handler
        document.getElementById('new-sale-tab-btn').addEventListener('click', () => {
            createNewTab();
        });
    });

    function createNewTab() {
        tabCounter++;
        const tabId = `sale-tab-${tabCounter}`;
        const tabData = {
            id: tabId,
            customer: null,
            products: [],
            discountpercentage: 0,
            totalPayment: 0,
            ledger: false,
            previousEntry: null,
            selectedProduct: null
        };

        saleTabs.push(tabData);

        // Create tab button
        const tabButton = document.createElement('li');
        tabButton.className = 'nav-item';
        tabButton.innerHTML = `
            <a class="nav-link" id="${tabId}-btn" data-bs-toggle="tab" href="#${tabId}" role="tab" aria-selected="false">
                Sale ${tabCounter}
                <button class="tab-close-btn" onclick="closeTab('${tabId}', event)">&times;</button>
            </a>
        `;
        document.getElementById('sale-tabs').appendChild(tabButton);

        // Create tab content panel
        const tabContent = document.createElement('div');
        tabContent.className = 'tab-content-panel';
        tabContent.id = tabId;
        tabContent.innerHTML = getTabContentHTML(tabId);
        document.getElementById('sale-tab-content-container').appendChild(tabContent);

        // Switch to new tab
        switchToTab(tabId);

        // Initialize Select2 for customer dropdown in this tab
        setTimeout(() => {
            $(`#customer-${tabId}`).select2({
                theme: 'bootstrap-5',
                dropdownParent: $(`#customer-${tabId}`).parent(),
                ajax: {
                    url: '/sales/search-customers',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { search: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: data.map(customer => ({
                                id: customer.id,
                                text: `${customer.firstname} ${customer.lastname} (${customer.phone || 'No phone'})`
                            }))
                        };
                    },
                    cache: true
                },
                minimumInputLength: 1,
                placeholder: 'Search customer...',
                dropdownCssClass: 'select2-dropdown-custom',
            });

            // Store customer selection
            $(`#customer-${tabId}`).on('select2:select', function (e) {
                const tab = saleTabs.find(t => t.id === tabId);
                if (tab) tab.customer = e.params.data.id;
            });
        }, 100);
    }

    function getTabContentHTML(tabId) {
        return `
            <div class="row justify-content-between flex-wrap mt-0" style="height: 100%;">
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div class="mb-4" id="search-product-sales-page-search-seaction-${tabId}" style="position: relative;">
                                <label for="product-search-${tabId}" class="form-label text-muted text-uppercase fw-semibold">Search Product</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="product-search-${tabId}" placeholder="Enter product name or barcode">
                                    <div class="input-group-text">
                                        <div class="form-check mb-0">
                                            <input type="checkbox" class="form-check-input" checked id="search-barcode-${tabId}">
                                            <label class="form-check-label">Barcode</label>
                                        </div>
                                    </div>
                                </div>
                                <small class="text-warning">
                                    Out of stock or products with inactive sales won't appear in search results.
                                </small>
                                <div id="search-results-${tabId}" class="shadow-lg rounded p-3 d-none" style="position: absolute; width: 100%; z-index: 9999;"></div>
                            </div>

                            <div class="pt-3">
                                <div class="mb-3">
                                    <label for="customer-${tabId}" class="form-label text-muted text-uppercase fw-semibold">Customer</label>
                                    <select id="customer-${tabId}" class="form-select select2" data-placeholder="Select Customer">
                                        <option value="">Select Customer</option>
                                    </select>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label text-muted text-uppercase fw-semibold">Total Bill</label>
                                        <h4 id="total-bill-amount-${tabId}" class="mb-0">Rs.0.00</h4>
                                    </div>

                                    <div class="col-md-6">
                                        <label for="discountpercentage-${tabId}" class="form-label text-muted text-uppercase fw-semibold">Discount %</label>
                                        <input type="number" class="form-control" id="discountpercentage-${tabId}" value="0">
                                    </div>

                                    <div class="col-md-6">
                                        <label for="total-payment-${tabId}" class="form-label text-muted text-uppercase fw-semibold">Payment</label>
                                        <div class="input-group">
                                            <input type="number" class="form-control" id="total-payment-${tabId}">
                                            <div class="input-group-text">
                                                <div class="form-check mb-0">
                                                    <input type="checkbox" class="form-check-input" id="ledger-${tabId}">
                                                    <label class="form-check-label">Ledger</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label text-muted text-uppercase fw-semibold">Change</label>
                                        <h4 id="change-${tabId}" class="mb-0 text-success">Rs.0.00</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header align-items-center d-flex">
                            <h4 class="card-title mb-0 flex-grow-1">Selected Products</h4>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="height: calc(67vh);">
                                <table class="table table-striped table-nowrap align-middle mb-0">
                                    <thead class="table-light" style="position: sticky; top: 0;">
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Barcode</th>
                                            <th scope="col">Name</th>
                                            <th scope="col">Qty</th>
                                            <th scope="col">Price</th>
                                            <th scope="col">Total</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="selected-products-${tabId}"></tbody>
                                </table>
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-primary w-100" onclick="completeSale('${tabId}')">
                                    Complete Sale
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
    }

    function switchToTab(tabId) {
        // Hide all tab panels
        document.querySelectorAll('.tab-content-panel').forEach(panel => {
            panel.classList.remove('active');
        });

        // Show selected tab panel
        const tabPanel = document.getElementById(tabId);
        if (tabPanel) {
            tabPanel.classList.add('active');
        }

        // Update nav tabs
        document.querySelectorAll('#sale-tabs .nav-link').forEach(link => {
            link.classList.remove('active');
        });
        const tabBtn = document.getElementById(`${tabId}-btn`);
        if (tabBtn) {
            tabBtn.classList.add('active');
        }

        currentTabId = tabId;
        initializeTabEventListeners(tabId);
    }

    function closeTab(tabId, event) {
        event.stopPropagation();
        
        if (saleTabs.length <= 1) {
            toastr.warning('At least one sale tab must remain open');
            return;
        }

        // Remove tab from array
        saleTabs = saleTabs.filter(t => t.id !== tabId);

        // Remove tab button
        const tabBtn = document.getElementById(`${tabId}-btn`).closest('li');
        if (tabBtn) tabBtn.remove();

        // Remove tab content
        const tabPanel = document.getElementById(tabId);
        if (tabPanel) tabPanel.remove();

        // Switch to first remaining tab
        if (saleTabs.length > 0) {
            switchToTab(saleTabs[0].id);
        }
    }

    function initializeTabEventListeners(tabId) {
        const productSearch = document.getElementById(`product-search-${tabId}`);
        const searchBarcode = document.getElementById(`search-barcode-${tabId}`);
        const totalPayment = document.getElementById(`total-payment-${tabId}`);
        const discountpercentage = document.getElementById(`discountpercentage-${tabId}`);
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);

        if (!productSearch) return;

        // Update placeholder
        function updatePlaceholder() {
            if (searchBarcode.checked) {
                productSearch.placeholder = 'Scan or enter product barcode';
            } else {
                productSearch.placeholder = 'Enter product name';
            }
        }
        updatePlaceholder();
        searchBarcode.addEventListener('change', updatePlaceholder);

        // Product search handlers
        productSearch.addEventListener('keydown', async (event) => {
            const searchResults = document.getElementById(`search-results-${tabId}`);
            if (event.key === 'Enter') {
                event.preventDefault();
                event.stopPropagation();

                if (searchBarcode.checked) {
                    await searchProductByBarcode(productSearch.value, tabId);
                    return;
                } else {
                    const tab = saleTabs.find(t => t.id === tabId);
                    let _selectedProduct = allProducts.find(p => p.id === parseInt(tab.selectedProduct));
                    if (_selectedProduct) {
                        addProduct(_selectedProduct, tabId);
                    } else {
                        if (tab.previousEntry)
                            addProduct(tab.previousEntry, tabId);
                    }
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                    setTimeout(() => productSearch.focus(), 100);
                }
            }
        });

        productSearch.addEventListener('input', async () => {
            if (searchBarcode.checked) return;
            const query = productSearch.value;
            if (query.length === 0) {
                document.getElementById(`search-results-${tabId}`).classList.add('d-none');
                return;
            }
            const products = await getProducts({ name: query });
            if (products.length === 0) {
                document.getElementById(`search-results-${tabId}`).classList.add('d-none');
                return;
            }
            setAllProducts(products);
            const searchResults = document.getElementById(`search-results-${tabId}`);
            searchResults.classList.remove('d-none');
            searchResults.innerHTML = '';

            let filteredProds = products.filter(product => product.name.toLowerCase().includes(query.toLowerCase()));
            filteredProds.forEach(product => {
                const productElement = document.createElement('div');
                productElement.classList.add('search-result-product', 'p-2', 'd-flex', 'justify-content-between', 'align-items-center');
                productElement.id = `product-${product.id}-${tabId}`;
                productElement.style.cursor = 'pointer';
                productElement.innerHTML = `
                    <div>
                        <div class="product-name-cell" title="${product.name}">${product.name}</div>
                        <small class="d-block text-muted">Stock: ${product.quantity}</small>
                    </div>
                    <span>Rs. ${product.saleprice}</span>
                `;
                productElement.addEventListener('click', () => {
                    addProduct(product, tabId);
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                    const tab = saleTabs.find(t => t.id === tabId);
                    if (tab) tab.selectedProduct = null;
                    productSearch.focus();
                });
                searchResults.appendChild(productElement);
            });
        });

        // Payment input handler
        totalPayment.addEventListener('input', () => {
            UpdateChangePrice(tabId);
        });

        // Discount percentage handler
        discountpercentage.addEventListener('input', () => {
            updateTotalBill(tabId);
        });

        // Click handlers for editable inputs
        selectedProductsTable.addEventListener('click', (event) => {
            const target = event.target;
            if (target.tagName === 'TD') {
                const row = target.closest('tr');
                if (target.classList.contains('product-quantity')) {
                    let quantityElement = target.querySelector('.editable-input');
                    if (!quantityElement) return;
                    const quantity = parseInt(quantityElement.value);
                    const priceElement = row.querySelector('.product-price .editable-input');
                    const totalElement = row.querySelector('.product-total');
                    const price = parseFloat(priceElement.value);
                    createEdiableInput(
                        (event, input) => UpdateProductQuantity(event, input, quantityElement, price, totalElement, tabId),
                        quantity,
                        target,
                        'number'
                    );
                } else if (target.classList.contains('product-price')) {
                    let priceElement = target.querySelector('.editable-input');
                    const price = parseFloat(priceElement.value);
                    const quantityElement = row.querySelector('.product-quantity .editable-input');
                    const totalElement = row.querySelector('.product-total');
                    createEdiableInput(
                        (event, input) => {
                            if (event.key === 'Enter') {
                                const newPrice = parseFloat(input.value);
                                if (newPrice <= 0) {
                                    input.style.borderBottomColor = 'red';
                                    toastr.warning('Price should be greater than 0');
                                    return false;
                                }
                                priceElement.value = newPrice;
                                totalElement.textContent = parseFloat((parseInt(quantityElement.value) * newPrice));
                                updateTotalBill(tabId);
                            }
                        },
                        price,
                        target,
                        'number'
                    );
                }
            }
        });

        // Click outside to close search results
        document.addEventListener('click', (event) => {
            if (!event.target.closest(`#search-product-sales-page-search-seaction-${tabId}`)) {
                document.getElementById(`search-results-${tabId}`).classList.add('d-none');
            }
        });
    }

    // Tab button click handlers
    document.addEventListener('click', (event) => {
        if (event.target.closest('.nav-link') && event.target.closest('.nav-link').id) {
            const tabBtn = event.target.closest('.nav-link');
            const tabId = tabBtn.id.replace('-btn', '');
            if (saleTabs.find(t => t.id === tabId)) {
                switchToTab(tabId);
            }
        }
    });

    // Product management functions (scoped to tab)
    function removeProduct(productId, tabId) {
        const row = document.getElementById(`product-row-${productId}-${tabId}`);
        if (row) {
            row.remove();
            updateTotalBill(tabId);
            updateSerialNumbers(tabId);
        }
    }

    function addProduct(product, tabId) {
        const tab = saleTabs.find(t => t.id === tabId);
        if (!tab) return;

        tab.previousEntry = product;
        if (product.quantity <= 0) {
            toastr.warning('Product quantity is not available');
            return;
        }
        let discountedPrice = product.saleprice - (product.saleprice * product.discount / 100);
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);

        const existingRow = document.getElementById(`product-row-${product.id}-${tabId}`);
        if (existingRow) {
            checkIfProductIsExpired(existingRow, product);
            const quantityElement = existingRow.querySelector('.product-quantity').querySelector('.editable-input');
            const priceElement = existingRow.querySelector('.product-price').querySelector('.editable-input');
            const totalElement = existingRow.querySelector('.product-total');

            const quantity = parseInt(quantityElement.value);
            if (product.quantity < quantity + 1) {
                toastr.warning('Product quantity is not available');
                return;
            }
            quantityElement.value = quantity + 1;
            totalElement.textContent = Math.round((quantity + 1) * parseFloat(priceElement.value));
            checkIfProductIsExpired(existingRow, product);
            updateTotalBill(tabId);
            return;
        }

        let newQuantity = 1;
        const currentIndex = selectedProductsTable.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');
        row.id = `product-row-${product.id}-${tabId}`;
        row.innerHTML = `
            <td class="product-serial">${currentIndex}</td>
            <td class="product-barcode">${product.barcode}</td>
            <td class="product-name">
                <div class="product-name-cell" title="${product.name}">
                    ${product.name}
                    <small class="d-block text-muted">Stock: ${product.quantity}</small>
                </div>
            </td>
            <td class="product-quantity">
                <input type="text" class="editable-input" value="${newQuantity}" readonly>
            </td>
            <td class="product-price">
                <input type="text" class="editable-input" value="${discountedPrice}" readonly>
            </td>
            <td class="product-total">${newQuantity * discountedPrice}</td>
            <td class="product-action">
                <button class="btn btn-danger btn-sm" onclick="removeProduct('${product.id}', '${tabId}')">
                    <i class="bx bx-trash"></i>
                </button>
            </td>
        `;
        selectedProductsTable.appendChild(row);
        checkIfProductIsExpired(row, product);
        updateTotalBill(tabId);
    }

    function updateTotalBill(tabId) {
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        if (!selectedProductsTable) return;

        let total = 0;
        let rows = selectedProductsTable.querySelectorAll('tr');
        let discountpercentage = parseFloat(document.getElementById(`discountpercentage-${tabId}`).value || 0);
        rows.forEach(row => {
            const price = parseFloat(row.querySelector('.product-total').textContent);
            total += price;
        });
        total = total - (total * discountpercentage / 100);
        const totalBillAmount = document.getElementById(`total-bill-amount-${tabId}`);
        if (totalBillAmount) {
            totalBillAmount.textContent = `Rs. ${parseFloat(total).toFixed(2)}`;
        }
        UpdateChangePrice(tabId);
    }

    function updateSerialNumbers(tabId) {
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        if (!selectedProductsTable) return;
        const rows = selectedProductsTable.querySelectorAll('tr');
        rows.forEach((row, index) => {
            row.querySelector('.product-serial').textContent = index + 1;
        });
    }

    function UpdateChangePrice(tabId) {
        const totalBillAmount = document.getElementById(`total-bill-amount-${tabId}`);
        const totalPayment = document.getElementById(`total-payment-${tabId}`);
        const changeEl = document.getElementById(`change-${tabId}`);
        if (!totalBillAmount || !totalPayment || !changeEl) return;

        const totalBill = parseFloat(totalBillAmount.textContent.split(' ')[1]);
        const totalPrice = parseFloat(totalPayment.value) || 0;
        const change = totalPrice - totalBill;
        if (change < 0 || isNaN(change)) {
            changeEl.textContent = 'Rs. 0.00';
            return;
        }
        changeEl.textContent = `Rs. ${change.toFixed(2)}`;
    }

    function UpdateProductQuantity(event, input, quantityElement, price, totalElement, tabId) {
        if (event.key === 'Enter') {
            const row = input.closest('tr');
            const productId = row.id.split('-')[2];
            const product = allProducts.find(p => p.id === parseInt(productId));
            const newQuantity = parseInt(input.value);
            input.value = newQuantity;

            if (newQuantity <= 0) {
                input.style.borderBottomColor = 'red';
                toastr.warning('Quantity should be greater than 0');
                return false;
            } else if (newQuantity > product.quantity) {
                input.style.borderBottomColor = 'red';
                toastr.warning('Product quantity is not available');
                return false;
            }

            quantityElement.textContent = newQuantity;
            totalElement.textContent = Math.round(newQuantity * price);
            checkIfProductIsExpired(row, product);
            updateTotalBill(tabId);
        }
    }

    function checkIfProductIsExpired(row, product) {
        let quantity = parseInt(row.querySelector('.product-quantity .editable-input').value);
        let isExpired = false;

        if (product.expired > 0) {
            const nonExpiredStock = product.quantity - product.expired;
            isExpired = quantity >= nonExpiredStock;
        }

        if (isExpired) {
            row.style.backgroundColor = 'rgba(255, 0, 0, 0.1)';
            row.setAttribute('data-expired', 'true');
        } else {
            row.style.backgroundColor = '';
            row.setAttribute('data-expired', 'false');
        }

        return isExpired;
    }

    async function getProducts(body) {
        const response = await fetch('/sales/productsget', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const products = await response.json();
        setAllProducts(products);
        return products;
    }

    async function searchProductByBarcode(barcode, tabId) {
        const tab = saleTabs.find(t => t.id === tabId);
        if (!barcode) {
            return tab.previousEntry ? addProduct(tab.previousEntry, tabId) : null;
        }
        const products = await getProducts({ barcode });
        if (products.length > 0) {
            addProduct(products[0], tabId);
            document.getElementById(`product-search-${tabId}`).value = '';
            setTimeout(() => document.getElementById(`product-search-${tabId}`).focus(), 100);
        } else {
            toastr.warning('No product found.');
            document.getElementById(`product-search-${tabId}`).value = '';
            document.getElementById(`product-search-${tabId}`).focus();
        }
    }

    function setAllProducts(product) {
        if (Array.isArray(product)) {
            product.forEach(p => {
                if (!allProducts.find(ap => ap.id === p.id) && p.quantity > 0) {
                    allProducts.push(p);
                }
            });
        } else {
            if (!allProducts.find(p => p.id === product.id) && product.quantity > 0) {
                allProducts.push(product);
            }
        }
    }

    function postSaveInput(input) {
        input.style.borderBottom = '1px solid transparent';
        input.setAttribute('readonly', 'readonly');
        input.style.pointerEvents = 'none';
        input.onblur = null;
        input.onkeyup = null;
    }

    function createEdiableInput(onSave, value, target, inputtype) {
        const input = target.querySelector('.editable-input') || document.createElement('input');
        let prevInputType = input.getAttribute('type');
        if (prevInputType !== inputtype) {
            input.setAttribute('type', inputtype);
        }
        input.classList.add('editable-input');
        input.style.borderBottom = '1px solid #000';
        input.style.pointerEvents = 'all';
        input.removeAttribute('readonly');
        input.onkeyup = (event) => {
            if (event.key === 'Enter') {
                let success = onSave(event, input);
                if (success !== false) {
                    postSaveInput(input);
                }
            }
        };
        input.onblur = () => {
            let success = onSave({ key: 'Enter' }, input);
            if (success !== false) {
                postSaveInput(input);
            }
        };
        input.focus();
    }

    function completeSale(tabId) {
        const tab = saleTabs.find(t => t.id === tabId);
        if (!tab) return;

        const customerDropdown = document.getElementById(`customer-${tabId}`);
        const ledgerCheckbox = document.getElementById(`ledger-${tabId}`);
        const discountpercentage = parseFloat(document.getElementById(`discountpercentage-${tabId}`).value);
        const selectedProductsTable = document.getElementById(`selected-products-${tabId}`);
        const totalPayment = document.getElementById(`total-payment-${tabId}`);

        const customer = customerDropdown.value || null;
        const ledger = ledgerCheckbox.checked;
        const products = [];
        selectedProductsTable.querySelectorAll('tr').forEach(row => {
            const productId = row.id.split('-')[2];
            const quantity = parseInt(row.querySelector('td:nth-child(4)').querySelector('.editable-input').value);
            const price = parseFloat(row.querySelector('td:nth-child(5)').querySelector('.editable-input').value);
            products.push({ productId, quantity, price });
        });

        if (products.length === 0) {
            toastr.warning('Please select products');
            return;
        }

        const totalPaymentVal = parseFloat(totalPayment.value) || 0;
        const priceWithoutDiscount = products.reduce((acc, product) => acc + (product.quantity * product.price), 0);
        const totalPrice = priceWithoutDiscount;

        if (discountpercentage < 0 || discountpercentage > 100) {
            toastr.warning('Please enter valid discount percentage');
            return;
        }

        const priceWithDiscount = priceWithoutDiscount - (priceWithoutDiscount * discountpercentage / 100);
        if (totalPaymentVal < priceWithDiscount && !ledger) {
            toastr.warning('Please check the ledger option or pay the full amount');
            return;
        }
        if (totalPaymentVal < priceWithDiscount && !customer) {
            toastr.warning('Please select a customer or pay the full amount');
            return;
        }

        fetch('/sales/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customer, discountpercentage, totalPrice, ledger, products, totalPayment: totalPaymentVal }),
        }).then(async response => {
            let data = await response.json();
            if (response.ok) {
                $.alert({
                    title: 'Success!',
                    content: data.message,
                    theme: 'material',
                    useBootstrap: false,
                    boxWidth: '30%',
                    type: 'green',
                    buttons: {
                        confirm: {
                            text: 'Ok',
                            btnClass: 'btn-success',
                            action: function () {
                                window.location.href = '/sales/' + data.saleId;
                            }
                        }
                    }
                });
            } else {
                $.alert({
                    title: 'Error!',
                    content: data.message,
                    theme: 'material',
                    useBootstrap: false,
                    boxWidth: '30%',
                    type: 'red',
                    buttons: {
                        confirm: {
                            text: 'Ok',
                            btnClass: 'btn-danger',
                        }
                    }
                });
            }
        });
    }

    // Make functions globally accessible
    window.removeProduct = removeProduct;
    window.completeSale = completeSale;
    window.closeTab = closeTab;
    window.createNewTab = createNewTab;
</script>
</script>