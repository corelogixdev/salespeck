<div class="" style="height: 85vh; margin-top: -14px;">
    <div class="row justify-content-between flex-wrap mt-0" style="height: 100%;">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div class="mb-4" id="search-product-sales-page-search-seaction" style="position: relative;">
                        <label for="product-search" class="form-label text-muted text-uppercase fw-semibold">Search Product</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="product-search" 
                                placeholder="Enter product name or barcode">
                            <div class="input-group-text">
                                <div class="form-check mb-0">
                                    <input type="checkbox" class="form-check-input" checked id="search-barcode">
                                    <label class="form-check-label">Barcode</label>
                                </div>
                            </div>
                        </div>
                        <small class="text-warning">
                            Out of stock or products with inactive sales won’t appear in search results.
                        </small>
                        <div id="search-results" class="shadow-lg rounded p-3 d-none" 
                            style="position: absolute; width: 100%; z-index: 9999; background-color: white;">
                        </div>
                    </div>

                    <div class="pt-3">
                        <div class="mb-3">
                            <label for="customer" class="form-label text-muted text-uppercase fw-semibold">Customer</label>
                            <select id="customer" class="form-select select2" data-placeholder="Select Customer">
                                <option value="">Select Customer</option>
                            </select>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label text-muted text-uppercase fw-semibold">Total Bill</label>
                                <h4 id="total-bill-amount" class="mb-0">Rs.0.00</h4>
                            </div>

                            <div class="col-md-6">
                                <label for="discountpercentage" class="form-label text-muted text-uppercase fw-semibold">Discount %</label>
                                <input type="number" class="form-control" id="discountpercentage" value="0">
                            </div>

                            <div class="col-md-6">
                                <label for="total-payment" class="form-label text-muted text-uppercase fw-semibold">Payment</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="total-payment">
                                    <div class="input-group-text">
                                        <div class="form-check mb-0">
                                            <input type="checkbox" class="form-check-input" id="ledger">
                                            <label class="form-check-label">Ledger</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label text-muted text-uppercase fw-semibold">Change</label>
                                <h4 id="change" class="mb-0 text-success">Rs.0.00</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header align-items-center d-flex">
                    <h4 class="card-title mb-0 flex-grow-1">Selected Products</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="height: calc(67vh);">
                        <table class="table table-striped table-nowrap align-middle mb-0">
                            <thead class="table-light" style="position: sticky; top: 0;">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">ID</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Qty</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody id="selected-products"></tbody>
                        </table>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary w-100" onclick="sale()">
                            Complete Sale
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.search-result-product {
    transition: all 0.2s;
}
.search-result-product:hover {
    background-color: var(--vz-light);
}
.editable-input {
    outline: none;
    width: 50px;
    border: none;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    pointer-events: none;
    text-align: center;
}
#search-results {
    box-shadow: 0 5px 10px rgba(0,0,0,0.1);
}
.select2-dropdown-custom {
    max-height: 200px;
    overflow-y: auto;
}
.select2-container--bootstrap-5 .select2-selection {
    min-height: 38px;
    /* border: 1px solid var(--vz-input-border); */
    /* background-color: var(--vz-input-bg); */
}
.select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
    color: var(--vz-body-color);
    line-height: 36px;
}
.select2-container--bootstrap-5 .select2-dropdown {
    background-color: var(--vz-card-bg);
    border-color: var(--vz-border-color);
}
.select2-container--bootstrap-5 .select2-results__option {
    padding: 8px 12px;
    color: var(--vz-body-color);
}
.select2-container--bootstrap-5 .select2-results__option--highlighted {
    background-color: var(--vz-primary);
}
.product-name small {
    font-size: 0.75rem;
    opacity: 0.7;
}
.product-name-cell {
    max-width: 100px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
</style>

<script>
    const productSearch = document.getElementById('product-search');
    const searchBarcode = document.getElementById('search-barcode');
    const customerDropdown = document.getElementById('customer');
    const totalBillAmount = document.getElementById('total-bill-amount');
    const totalPayment = document.getElementById('total-payment');
    const ledgerCheckbox = document.getElementById('ledger');
    const selectedProductsTable = document.getElementById('selected-products');
    const discountpercentage = document.getElementById('discountpercentage');
    let ErrorString = '';
    let selectedProduct = null;
    let allProducts = [];
    function removeProduct(productId) {
        const row = document.getElementById(`product-row-${productId}`);
        if (row) {
            row.remove();
            updateTotalBill();
            updateSerialNumbers();
            ErrorString = '';
        }
    }
    function updateTotalBill() {
        let total = 0;
        let rows = document.querySelectorAll('#selected-products tr');
        let discountpercentage = parseInt(document.getElementById('discountpercentage').value || 0);
        rows.forEach(row => {
            const price = parseFloat(row.querySelector('.product-total').textContent);
            total += price;
        });
        total = total - (total * discountpercentage / 100);
        totalBillAmount.textContent = `Rs. ${parseInt(total)}`;
        UpdateChangePrice();
    }   
    let previousEntry;
    function addProduct(product) {
        previousEntry = product;
        if(product.quantity <= 0){
            toastr.warning('Product quantity is not available');
            return;
        }
        let discountedPrice = product.saleprice - (product.saleprice * product.discount / 100);
        discountedPrice = Math.round(discountedPrice);

        const existingRow = document.getElementById(`product-row-${product.id}`);
        if (existingRow) {
            checkIfProductIsExpired(existingRow, product);
            const quantityElement = existingRow.querySelector('.product-quantity').querySelector('.editable-input');
            const priceElement = existingRow.querySelector('.product-price').querySelector('.editable-input');
            const totalElement = existingRow.querySelector('.product-total');

            const quantity = parseInt(quantityElement.value);
            if (product.quantity < quantity + 1) {
                ErrorString = "Please enter valid quantity";
                toastr.warning('Product quantity is not available');
                return;
            }
            quantityElement.value = quantity + 1;

            totalElement.textContent = Math.round((quantity + 1) * parseFloat(priceElement.value));
            
            // Check expired status after quantity update
            checkIfProductIsExpired(existingRow, product);
            
            updateTotalBill();
            return;
        }
        let newQuantity = 1;
        const currentIndex = selectedProductsTable.querySelectorAll('tr').length + 1;
        const row = document.createElement('tr');
        row.id = `product-row-${product.id}`;
        row.innerHTML = `
        <td class="product-serial">${currentIndex}</td>
        <td class="product-id">${product.id}</td>
        <td class="product-name">
            <div class="product-name-cell" title="${product.name}">
                ${product.name}
                <small class="d-block text-muted">Stock: ${product.quantity}</small>
            </div>
        </td>
        <td class="product-quantity">
            <input type="text" class="editable-input" value="${newQuantity}" readonly>
        </td>
        <td class="product-price">
            <input type="text" class="editable-input" value="${discountedPrice}" readonly>
        </td>
        <td class="product-total">${newQuantity * discountedPrice}</td>
        <td class="product-action">
          <button class="btn btn-danger btn-sm" onclick="removeProduct('${product.id}')">
            <i class="bx bx-trash"></i>
          </button>
        </td>
      `;
        selectedProductsTable.appendChild(row);
        
        // Add check after creating new row
        checkIfProductIsExpired(row, product);
        
        updateTotalBill();
    }
    function updateSerialNumbers() {
        const rows = selectedProductsTable.querySelectorAll('tr');
        rows.forEach((row, index) => {
            row.querySelector('.product-serial').textContent = index + 1;
        });
    }
    function UpdateChangePrice(){
        const totalBill = parseFloat(totalBillAmount.textContent.split(' ')[1]);
        const totalPrice = parseFloat(totalPayment.value) || 0;
        const change = totalPrice - totalBill;
        const changeEl = document.getElementById('change');
        if (change < 0 || isNaN(change)) {
            changeEl.textContent = 'Rs. 0.00';
            return;
        }
        changeEl.textContent = `Rs. ${Math.round(change)}`;
    }
    function sale(){
        const customer = customerDropdown.value || null;
        const ledger = ledgerCheckbox.checked;
        const discountpercentage = parseInt(document.getElementById('discountpercentage').value);
        const products = [];
        document.querySelectorAll('#selected-products tr').forEach(row => {
            const productId = row.querySelector('td:nth-child(2)').textContent;
            const quantity = parseInt(row.querySelector('td:nth-child(4)').querySelector('.editable-input').value);
            const price = parseFloat(row.querySelector('td:nth-child(5)').querySelector('.editable-input').value);
            products.push({ productId, quantity , price });
        });
        if(products.length === 0){
            toastr.warning('Please select products');
            return;
        }
        const totalPaymentVal = parseFloat(totalPayment.value) || 0;
        const priceWithoutDiscount = products.reduce((acc, product) => acc + (product.quantity * product.price), 0);
        
        const totalPrice = Math.round(priceWithoutDiscount);

        // check if discount percent is valid

        if(discountpercentage < 0 || discountpercentage > 100){
            toastr.warning('Please enter valid discount percentage');
            return;
        }

        // check if user paid less
        if(totalPaymentVal < totalPrice && !ledger){
            toastr.warning('Please check the ledger option or pay the full amount');
            return;
        }
        if(totalPaymentVal < totalPrice && !customer){
            toastr.warning('Please select a customer or pay the full amount');
            return;
        }

        fetch('/sales/save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ customer, discountpercentage, totalPrice, ledger, products, totalPayment: totalPaymentVal }),
        }).then(async response => {
            let data = await response.json();
            console.log(data)
            if (response.ok) {
                $.alert({
                    title: 'Success!',
                    content: data.message,
                    theme: 'material',
                    useBootstrap: false,
                    boxWidth: '30%',
                    type: 'green',
                    buttons: {
                        confirm: {
                            text: 'Ok',
                            btnClass: 'btn-success',
                            action: function () {
                                window.open('/sales/'+ data.saleId, '_blank');
                                window.location.reload();
                            }
                        }
                    }
                });
            } else {
                $.alert({
                    title: 'Error!',
                    content: data.message,
                    theme: 'material',
                    useBootstrap: false,
                    boxWidth: '30%',
                    type: 'red',
                    buttons: {
                        confirm: {
                            text: 'Ok',
                            btnClass: 'btn-danger',
                        }
                    }
                });
            }
        });
    }
    async function getProducts(body){
        const response = await fetch('/sales/productsget', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(body),
        });
        const products = await response.json();
        allProducts = products;
        console.log(products);
        return products;
    }
    async function searchProductByBarcode(barcode){
        if(!barcode){
            return addProduct(previousEntry);
        }
        const products = await getProducts({ barcode });
        if(products.length > 0){
            addProduct(products[0]);
            productSearch.value = '';
        }else{
            toastr.warning('No product found.');
        }
    }
    function postSaveInput(input){
        input.style.borderBottom = '1px solid transparent';
        input.setAttribute('readonly', 'readonly');
        input.style.pointerEvents = 'none';
        input.onblur = null;
        input.onkeyup = null;
    }
    function createEdiableInput(onSave, value, target){
        const input = target.querySelector('.editable-input') || document.createElement('input');
        input.classList.add('editable-input');
        input.style.borderBottom = '1px solid #000';
        input.style.pointerEvents = 'all';
        input.removeAttribute('readonly');
        input.onkeyup = (event) => {
            if (event.key === 'Enter') {
                let success = onSave(event, input);
                if(success !== false){
                    postSaveInput(input);
                }
            }
        };
        input.onblur = () => {
            let success = onSave({key: 'Enter'}, input);
            if(success !== false){
                postSaveInput(input);
            }
        };
        input.addEventListener('keypress', (event) => {
            if (event.key < '0' || event.key > '9') {
                event.preventDefault();
            }
        });
        input.focus();
    }
    
    function checkIfProductIsExpired(row, product){
        let quantity = parseInt(row.querySelector('.product-quantity .editable-input').value);
        let isExpired = false;
        
        if (product.expired > 0) {
            const nonExpiredStock = product.quantity - product.expired;
            isExpired = quantity >= nonExpiredStock;
        }

        if (isExpired) {
            row.style.backgroundColor = 'rgba(255, 0, 0, 0.1)';
            row.setAttribute('data-expired', 'true');
        } else {
            row.style.backgroundColor = '';
            row.setAttribute('data-expired', 'false');
        }
        
        return isExpired;
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (event) => {
            if (!event.target.closest('#search-product-sales-page-search-seaction')) {
                document.getElementById('search-results').classList.add('d-none');
            }
        });
        productSearch.addEventListener('keydown', async (event) => {
            const searchResults = document.getElementById('search-results');
            if(event.key === 'Enter'){
                if(searchBarcode.checked){
                    event.preventDefault();
                    await searchProductByBarcode(productSearch.value);
                    return;
                }else{
                    let _selectedProduct = allProducts.find(p => p.id === parseInt(selectedProduct));
                    if (_selectedProduct) {
                        addProduct(_selectedProduct);
                    }else{
                        if(previousEntry)
                        addProduct(previousEntry);
                    }
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                }
            }
            if (!searchResults.classList.contains('d-none')) {
                if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
                    event.preventDefault();
                }
                const productResults = searchResults.querySelectorAll('.search-result-product');
                if (productResults.length > 0) {
                    if(productResults.length === 1){
                        selectedProduct = productResults[0].id.split('-')[1];
                        productResults[0].style.backgroundColor = '#f8f9fa';
                    }
                    if (selectedProduct) {
                        const selectedElement = document.getElementById(`product-${selectedProduct}`);
                        selectedElement.style.backgroundColor = '';
                        let nextElement = null;
                        if (event.key === 'ArrowUp') {
                            nextElement = selectedElement.previousElementSibling;
                        } else if (event.key === 'ArrowDown') {
                            nextElement = selectedElement.nextElementSibling;
                        }
                        if (nextElement) {
                            selectedProduct = nextElement.id.split('-')[1];
                            nextElement.style.backgroundColor = '#f8f9fa';
                        } else {
                            selectedProduct = productResults[0].id.split('-')[1];
                            productResults[0].style.backgroundColor = '#f8f9fa';
                        }
                    } else {
                        selectedProduct = productResults[0].id.split('-')[1];
                        productResults[0].style.backgroundColor = '#f8f9fa';
                    }
                }
            }
        });
        productSearch.addEventListener('input', async () => {
            if(searchBarcode.checked){
                return;
            }
            const query = productSearch.value;
            if (query.length === 0) {
                document.getElementById('search-results').classList.add('d-none');
                return;
            }
            const products = await getProducts({ name: query });
            if (products.length === 0) {
                document.getElementById('search-results').classList.add('d-none');
                return;
            }
            allProducts = products;
            const searchResults = document.getElementById('search-results');
            searchResults.classList.remove('d-none');
            searchResults.innerHTML = '';
            
            let filteredProds = products.filter(product => product.name.toLowerCase().includes(query.toLowerCase()));
            filteredProds.forEach(product => {
                const productElement = document.createElement('div');
                productElement.classList.add('search-result-product', 'p-2', 'd-flex', 'justify-content-between', 'align-items-center');
                productElement.id = `product-${product.id}`;
                productElement.style.cursor = 'pointer';
                productElement.innerHTML = `
                    <div>
                        <div class="product-name-cell" title="${product.name}">${product.name}</div>
                        <small class="d-block text-muted">Stock: ${product.quantity}</small>
                    </div>
                    <span>Rs. ${product.saleprice}</span>
                    `;
                productElement.addEventListener('click', () => {
                    addProduct(product);
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                });
                searchResults.appendChild(productElement);
            });
        });
        totalPayment.addEventListener('input', () => {
            UpdateChangePrice();
        });
        selectedProductsTable.addEventListener('click', (event) => {
            function UpdateProductQuantity(event, input, quantityElement , price, totalElement){
                if (event.key === 'Enter') {
                    const row = input.closest('tr');
                    const productId = row.querySelector('.product-id').textContent;
                    const product = allProducts.find(p => p.id === parseInt(productId));
                    const newQuantity = parseInt(input.value);
                    
                    if (newQuantity <= 0) {
                        input.style.borderBottomColor = 'red';
                        ErrorString = "Please enter valid quantity";
                        toastr.warning('Quantity should be greater than 0');
                        return false;
                    } else if(newQuantity > product.quantity) {
                        input.style.borderBottomColor = 'red';
                        ErrorString = "Please enter valid quantity";
                        toastr.warning('Product quantity is not available');
                        return false;
                    }
                    
                    ErrorString = '';
                    quantityElement.textContent = newQuantity;
                    totalElement.textContent = Math.round(newQuantity * price);
                    
                    // Check expired status after quantity update
                    checkIfProductIsExpired(row, product);
                    
                    updateTotalBill();
                }
            }
            const target = event.target;
            if(target.tagName === 'TD'){
                const row = target.closest('tr');
                if (target.classList.contains('product-quantity')) {
                    let quantityElement = target.querySelector('.editable-input');
                    if(!quantityElement){
                        return;
                    }
                    const quantity = Math.round(quantityElement.value);
                    const priceElement = row.querySelector('.product-price .editable-input');
                    const totalElement = row.querySelector('.product-total');
                    const price = parseFloat(priceElement.value);
                    createEdiableInput( 
                        (event, input) => UpdateProductQuantity(event, input, quantityElement , price, totalElement), 
                        quantity, 
                        target
                    );
                }
                else if (target.classList.contains('product-price')) {
                    let priceElement = target.querySelector('.editable-input');
                    const price = parseFloat(priceElement.value);
                    const quantityElement = row.querySelector('.product-quantity .editable-input');
                    const totalElement = row.querySelector('.product-total');
                    createEdiableInput( 
                        (event, input) => {
                            if (event.key === 'Enter') {
                                const newPrice = parseInt(input.value);
                                if (newPrice <= 0) {
                                    input.style.borderBottomColor = 'red';
                                    toastr.warning('Price should be greater than 0');
                                    return false;
                                }
                                priceElement.value = newPrice;
                                totalElement.textContent = parseInt((parseInt(quantityElement.value) * newPrice))
                                updateTotalBill();
                            }
                        },
                        price, 
                        target
                    );
                }
            }
        });
    });
    discountpercentage.addEventListener('input', () => {
        updateTotalBill();
    });
    $(document).ready(function() {
        $('#customer').select2({
            theme: 'bootstrap-5',
            dropdownParent: $('#customer').parent(),
            ajax: {
                url: '/sales/search-customers',
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        search: params.term
                    };
                },
                processResults: function(data) {
                    return {
                        results: data.map(customer => ({
                            id: customer.id,
                            text: `${customer.firstname} ${customer.lastname} (${customer.phone || 'No phone'})`
                        }))
                    };
                },
                cache: true
            },
            minimumInputLength: 1,
            placeholder: 'Search customer...',
            dropdownCssClass: 'select2-dropdown-custom',
        });
    });
    </script>