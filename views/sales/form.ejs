<div class="container" style="height: 83vh;">
    <div class="row justify-content-between" style="height: 100%;">
        <div class="col-lg-6 row flex-column justify-content-between h-100">
            <div>
                <div class="mb-3" id="search-product-sales-page-search-seaction" style="position: relative;">
                    <label for="product-search" class="form-label">Search Product:</label>
                    <div class="input-group d-flex align-items-center justify-content-between">
                        <input type="text" class="form-control" id="product-search"
                            placeholder="Enter product name or barcode.">
                        <div class="input-group-text">
                            <input type="checkbox" class="form-check mb-0" checked id="search-barcode">&nbsp; Barcode
                        </div>
                    </div>
                    <div id="search-results" class="shadow rounded p-3 d-none"
                        style="position: absolute; width: 100%; z-index: 9999; background-color: white;"></div>
                </div>
            </div>
            <div>
                <div class="mb-3">
                    <label for="customer" class="form-label">Customer:</label>
                    <select id="customer" class="form-select">
                    <option value="">Select Customer</option>
                        <% customers.forEach(customer => { %>
                            <option value="<%= customer.id %>"><%= customer.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="form-label fw-bold">Total Bill:</label>
                    <span id="total-bill-amount" class="form-control-plaintext d-inline">Rs.0.00</span>
                </div>
                <div>
                    <label for="discountpercentage" class="form-label">Discount Percentage</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="discountpercentage" value="0">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="total-payment" class="form-label">Total Payment:</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="total-payment">
                        <div class="input-group-text d-flex align-items-center justify-content-between">
                            <input type="checkbox" class="form-check mb-0" id="ledger">&nbsp; Ledger
                        </div>
                    </div>
                </div>
                <div>
                    <label class="form-label fw-bold">Change:</label>
                    <span id="change" class="form-control-plaintext d-inline">Rs.0.00</span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="table-responsive border" style="height: 80%; overflow-y: auto;">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="selected-products">
                    </tbody>
                </table>
            </div>
            <button class="btn btn-primary w-100 mt-5" onclick="sale()">Sale</button>
        </div>
    </div>
</div>
<style>
    .search-result-product:hover {
        background-color: #f8f9fa;
    }
    .editable-input {
        outline: none;
        width: 50px;
        border-top: none;
        border-left: none;
        border-right: none;
        background-color: transparent;
        border-bottom: 1px solid transparent;
        pointer-events: none;
    }
</style>
<script>
    const productSearch = document.getElementById('product-search');
    const searchBarcode = document.getElementById('search-barcode');
    const customerDropdown = document.getElementById('customer');
    const totalBillAmount = document.getElementById('total-bill-amount');
    const totalPayment = document.getElementById('total-payment');
    const ledgerCheckbox = document.getElementById('ledger');
    const selectedProductsTable = document.getElementById('selected-products');
    const discountpercentage = document.getElementById('discountpercentage');
    let ErrorString = '';
    let selectedProduct = null;
    let allProducts = [];
    function removeProduct(productId) {
        const row = document.getElementById(`product-row-${productId}`);
        if (row) {
            row.remove();
            updateTotalBill();
        }
    }
    function updateTotalBill() {
        let total = 0;
        let rows = document.querySelectorAll('#selected-products tr');
        let discountpercentage = parseInt(document.getElementById('discountpercentage').value || 0);
        rows.forEach(row => {
            const price = parseFloat(row.querySelector('.total-price').textContent);
            total += price;
        });
        total = total - (total * discountpercentage / 100);
        totalBillAmount.textContent = `Rs. ${parseInt(total)}`;
        UpdateChangePrice();
    }
    function addProduct(product) {
        console.log(product)
        if(product.quantity <= 0){
            toastr.warning('Product quantity is not available');
            return;
        }
        let discountedPrice = product.saleprice - (product.saleprice * product.discount / 100);
        discountedPrice = Math.round(discountedPrice);

        const existingRow = document.getElementById(`product-row-${product.id}`);
        if (existingRow) {
            const quantityElement = existingRow.querySelector('td:nth-child(3)').querySelector('.editable-input');
            const priceElement = existingRow.querySelector('td:nth-child(4)').querySelector('.editable-input');
            const totalElement = existingRow.querySelector('td:nth-child(5)');
            const quantity = parseInt(quantityElement.value);
            if (product.quantity <= quantity) {
                ErrorString = "Please enter valid quantity";
                toastr.warning('Product quantity is not available');
                return;
            }
            quantityElement.value = quantity + 1;

            totalElement.textContent = Math.round((quantity + 1) * parseFloat(priceElement.value));
            updateTotalBill();
            return;
        }
        let newQuantity = 1;
        const row = document.createElement('tr');
        row.id = `product-row-${product.id}`;
        row.innerHTML = `
        <td>${product.id}</td>
        <td>${product.name}</td>
        <td>
            <input type="text" class="editable-input" value="${newQuantity}" readonly>
        </td>
        <td class="product-price">
            <input type="text" class="editable-input" value="${discountedPrice}" readonly>
        </td>
        <td class="total-price">${newQuantity * product.saleprice}</td>
        <td>
          <button class="btn btn-danger btn-sm" onclick="removeProduct('${product.id}')">
            <i class="fas fa-trash-alt"></i>
          </button>
        </td>
      `;
        selectedProductsTable.appendChild(row);
        updateTotalBill();
    }
    function UpdateChangePrice(){
        const totalBill = parseFloat(totalBillAmount.textContent.split(' ')[1]);
        const totalPaymentValue = parseFloat(totalPayment.value);
        const change = totalPaymentValue - totalBill;
        const changeEl = document.getElementById('change');
        if (change < 0 || isNaN(change)) {
            changeEl.textContent = 'Rs. 0.00';
            return;
        }
        changeEl.textContent = `Rs. ${Math.round(change)}`;
    }
    function sale(){
        if(ErrorString){
            toastr.warning(ErrorString);
            return;
        }
        const products = [];
        document.querySelectorAll('#selected-products tr').forEach(row => {
            const productId = row.querySelector('td:nth-child(1)').textContent;
            const quantity = parseInt(row.querySelector('td:nth-child(3)').querySelector('.editable-input').value);
            const price = parseFloat(row.querySelector('td:nth-child(4)').querySelector('.editable-input').value);
            products.push({ productId, quantity , price });
        });
        if(products.length === 0){
            toastr.warning('Please select products');
            return;
        }
        const customer = customerDropdown.value;
        if(!customer){
            toastr.warning('Please select customer');
            return;
        }
        const discountpercentage = parseInt(document.getElementById('discountpercentage').value);
        const totalPaymentValue = parseFloat(totalPayment.value);
        if(!totalPaymentValue){
            toastr.warning('Please enter total payment, 0 for nothing');
            return;
        }
        const ledger = ledgerCheckbox.checked;
        fetch('/sales/save', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ customer, discountpercentage, totalPayment: totalPaymentValue, ledger, products }),
        }).then(response => {
            if (response.ok) {
                toastr.success('Sale added successfully');
                window.location.href = '/sales';
            } else {
                toastr.error('Failed to add sale');
            }
        });
    }
    async function getProducts(body){
        const response = await fetch('/products/get', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(body),
        });
        const products = await response.json();
        allProducts = products;
        return products;
    }
    async function searchProductByBarcode(barcode){
        const products = await getProducts({ barcode });
        if(products.length > 0){
            addProduct(products[0]);
            productSearch.value = '';
        }else{
            toastr.warning('No product found with this barcode');
        }
    }
    function postSaveInput(input){
        input.style.borderBottom = '1px solid transparent';
        input.setAttribute('readonly', 'readonly');
        input.style.pointerEvents = 'none';
        input.onblur = null;
        input.onkeyup = null;
    }
    function createEdiableInput(onSave, value, target){
        const input = target.querySelector('.editable-input') || document.createElement('input');
        input.classList.add('editable-input');
        input.style.borderBottom = '1px solid #000';
        input.style.pointerEvents = 'all';
        input.removeAttribute('readonly');
        input.onkeyup = (event) => {
            if (event.key === 'Enter') {
                let success = onSave(event, input);
                if(success !== false){
                    postSaveInput(input);
                }
            }
        };
        input.onblur = () => {
            let success = onSave({key: 'Enter'}, input);
            if(success !== false){
                postSaveInput(input);
            }
        };
        input.addEventListener('keypress', (event) => {
            if (event.key < '0' || event.key > '9') {
                event.preventDefault();
            }
        });
        input.focus();
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (event) => {
            if (!event.target.closest('#search-product-sales-page-search-seaction')) {
                document.getElementById('search-results').classList.add('d-none');
            }
        });
        productSearch.addEventListener('keydown', async (event) => {
            if(searchBarcode.checked && event.key === 'Enter'){
                event.preventDefault();
                await searchProductByBarcode(productSearch.value);
                return;
            }
            const searchResults = document.getElementById('search-results');
            if (!searchResults.classList.contains('d-none')) {
                if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
                    event.preventDefault();
                }
                if (event.key === 'Enter') {
                    let _selectedProduct = allProducts.find(p => p.id === parseInt(selectedProduct));
                    if (_selectedProduct) {
                        addProduct(_selectedProduct);
                        productSearch.value = '';
                        searchResults.classList.add('d-none');
                    }
                }
                const productResults = searchResults.querySelectorAll('.search-result-product');
                if (productResults.length > 0) {
                    if(productResults.length === 1){
                        selectedProduct = productResults[0].id.split('-')[1];
                        productResults[0].style.backgroundColor = '#f8f9fa';
                    }
                    if (selectedProduct) {
                        const selectedElement = document.getElementById(`product-${selectedProduct}`);
                        selectedElement.style.backgroundColor = '';
                        let nextElement = null;
                        if (event.key === 'ArrowUp') {
                            nextElement = selectedElement.previousElementSibling;
                        } else if (event.key === 'ArrowDown') {
                            nextElement = selectedElement.nextElementSibling;
                        }
                        if (nextElement) {
                            selectedProduct = nextElement.id.split('-')[1];
                            nextElement.style.backgroundColor = '#f8f9fa';
                        } else {
                            selectedProduct = productResults[0].id.split('-')[1];
                            productResults[0].style.backgroundColor = '#f8f9fa';
                        }
                    } else {
                        selectedProduct = productResults[0].id.split('-')[1];
                        productResults[0].style.backgroundColor = '#f8f9fa';
                    }
                }
            }
        });
        productSearch.addEventListener('input', async () => {
            if(searchBarcode.checked){
                return;
            }
            const query = productSearch.value;
            if (query.length === 0) {
                document.getElementById('search-results').classList.add('d-none');
                return;
            }
            const products = await getProducts({ name: query });
            if (products.length === 0) {
                document.getElementById('search-results').classList.add('d-none');
                return;
            }
            allProducts = products;
            const searchResults = document.getElementById('search-results');
            searchResults.classList.remove('d-none');
            searchResults.innerHTML = '';
            
            let filteredProds = products.filter(product => product.name.toLowerCase().includes(query.toLowerCase()));
            filteredProds.forEach(product => {
                const productElement = document.createElement('div');
                productElement.classList.add('search-result-product', 'p-2', 'd-flex', 'justify-content-between', 'align-items-center');
                productElement.id = `product-${product.id}`;
                productElement.style.cursor = 'pointer';
                productElement.innerHTML = `
                    <span>${product.name}</span>
                    <span>Rs. ${product.saleprice}</span>
                    `;
                productElement.addEventListener('click', () => {
                    addProduct(product);
                    productSearch.value = '';
                    searchResults.classList.add('d-none');
                });
                searchResults.appendChild(productElement);
            });
        });
        totalPayment.addEventListener('input', () => {
            UpdateChangePrice();
        });
        selectedProductsTable.addEventListener('click', (event) => {
            function UpdateProductQuantity(event, input, quantityElement , price, totalElement){
                if (event.key === 'Enter') {
                    const newQuantity = parseInt(input.value);
                    let productTotalQuantity = allProducts.find(p => p.id === parseInt(target.parentElement.children[0].textContent)).quantity;
                    if (newQuantity <= 0) {
                        input.style.borderBottomColor = 'red';
                        ErrorString = "Please enter valid quantity";
                        toastr.warning('Quantity should be greater than 0');
                        return false;
                    }else if(newQuantity > productTotalQuantity){
                        input.style.borderBottomColor = 'red';
                        ErrorString = "Please enter valid quantity";
                        toastr.warning('Product quantity is not available');
                        return false;
                    }
                    ErrorString = '';
                    quantityElement.textContent = newQuantity;
                    totalElement.textContent = Math.round(newQuantity * price);
                    updateTotalBill();
                }
            }
            const target = event.target;
            if(target.tagName === 'TD'){
                if (target.cellIndex === 2) {
                    let quantityElement = target.querySelector('.editable-input');
                    if(!quantityElement){
                        return;
                    }
                    const quantity = Math.round(quantityElement.value);
                    const priceElement = target.nextElementSibling.querySelector('.editable-input');
                    const totalElement = target.nextElementSibling.nextElementSibling;
                    const price = parseFloat(priceElement.value);
                    const total = parseFloat(totalElement.textContent);
                    createEdiableInput( 
                        (event, input) => UpdateProductQuantity(event, input, quantityElement , price, totalElement), 
                        quantity, 
                        target
                    );
                }
                else if (target.cellIndex === 3) {
                    let priceElement = target.querySelector('.editable-input');
                    const price = parseFloat(priceElement.value);
                    const quantityElement = target.previousElementSibling.querySelector('.editable-input');
                    const totalElement = target.nextElementSibling;
                    createEdiableInput( 
                        (event, input) => {
                            if (event.key === 'Enter') {
                                const newPrice = parseInt(input.value);
                                if (newPrice <= 0) {
                                    input.style.borderBottomColor = 'red';
                                    toastr.warning('Price should be greater than 0');
                                    return false;
                                }
                                priceElement.value = newPrice;
                                totalElement.textContent = parseInt((parseInt(quantityElement.value) * newPrice))
                                updateTotalBill();
                            }
                        },
                        price, 
                        target
                    );
                }
            }
        });
    });
    discountpercentage.addEventListener('input', () => {
        updateTotalBill();
    });
    </script>