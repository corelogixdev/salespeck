<!doctype html>
<html data-layout="horizontal" data-topbar="light" data-sidebar="light" data-sidebar-size="sm-hover"
    data-sidebar-image="none" data-preloader="disable">

<head>
    <meta charset="utf-8" />
    <title>OpenMenu</title>
    <link rel="icon" href="/assets/images/icon.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/toastr.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/jquery-confirm.min.css" rel="stylesheet" type="text/css" />
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/jquery-confirm.min.js"></script>
    <script src="/assets/js/select2.min.js"></script>
    <script src="/assets/libs/flatpickr/flatpickr.min.js"></script>
    <link rel="stylesheet" href="/assets//css/select2.min.css">
</head>

<body>

    <div class="row mx-auto cstm-row mt-3" style="width: 500px;">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0">Invoice Details</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/sales">Sales</a></li>
                        <li class="breadcrumb-item active">Invoice Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center mx-auto cstm-row" style="width: 500px;">
        <div class="col-lg-12">
            <div class="card" id="demo">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card-header border-bottom-dashed px-4">
                            <!-- Logo - Centered -->
                            <div class="text-center mb-3">
                                <img src="/assets/images/icon.png" class="card-logo" alt="logo" height="50">
                            </div>

                            <!-- Company Details - Centered -->
                            <div class="text-center mb-3">
                                <h6 class="text-uppercase fw-semibold">Company Details</h6>
                                <p class="mb-1">
                                    <%= companySettings.name %>
                                </p>
                                <p class="mb-0">
                                    <%= companySettings.address %>
                                </p>
                                <p class="mb-0">Contact: <%= companySettings.phone %>
                                </p>
                            </div>

                            <!-- Customer Details - Right aligned if exists -->
                            <% if(sale.Customer) { %>
                                <div class="text-end">
                                    <h6 class="text-uppercase fw-semibold mt-1">Customer Details</h6>
                                    <p class="mb-2">
                                        <%= sale.Customer.firstname %>
                                            <%= sale.Customer.lastname %>
                                    </p>
                                    <p class="mb-1">
                                        <%= sale.Customer.address %>
                                    </p>
                                    <p class="mb-1">Phone: <%= sale.Customer.phone %>
                                    </p>
                                </div>
                                <% } %>
                        </div>

                        <div class="card-body pt-4 pb-0 px-4">
                            <div class="row g-3">
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Invoice No
                                    </p>
                                    <h5 class="fs-14 mb-0">
                                        <%= sale.invoicenum %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Date
                                    </p>
                                    <h5 class="fs-14 mb-0 format-date">
                                        <%= sale.createdAt %>
                                    </h5>
                                </div>
                                <div class="col-4">
                                    <p class="mb-2 text-uppercase">
                                        Total Amount
                                    </p>
                                    <h5 class="fs-14 mb-0">
                                        Rs.<%= (sale.totalprice - (sale.totalprice * sale.discountpercentage /
                                            100)).toFixed(2) %>
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <div class="card-body py-4 px-3 fs-6">
                            <div class="table-responsive overflow-hidden">
                                <table class="table table-borderless text-center table-nowrap align-middle mb-0">
                                    <thead>
                                        <tr class="table-active">
                                            <th scope="col" style="width: 50px;">#</th>
                                            <th scope="col">Product</th>
                                            <th scope="col">Rate</th>
                                            <th scope="col">Qty</th>
                                            <th scope="col" class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% sale.SoldPoducts.forEach((product, index)=> { %>
                                            <tr>
                                                <th scope="row">
                                                    <%= index + 1 %>
                                                </th>
                                                <td class="text-center">
                                                    <span class="fw-medium">
                                                        <%= product.Product.name %>
                                                    </span>
                                                </td>
                                                <td class="code">Rs.<%= formatNumber(product.price) %>
                                                </td>
                                                <td class="code">
                                                    <%= product.quantity %>
                                                </td>
                                                <td class="text-end code">Rs.<%= (product.quantity *
                                                        product.price).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="border-top border-top-dashed mt-2 fs-7">
                                <table
                                    class="table table-borderless table-nowrap align-middle mb-0 ms-auto footer-table">
                                    <tbody>
                                        <tr>
                                            <td class="p-1">Sub Total</td>
                                            <td class="text-end code p-1">Rs.<%= formatNumber(sale.totalprice) %>
                                            </td>
                                        </tr>
                                        <% if(sale.discountpercentage) { %>
                                            <tr>
                                                <td class="p-1">Discount (<%= sale.discountpercentage %>%)</td>
                                                <td class="text-end code p-1"> Rs. -<%= (sale.totalprice *
                                                        sale.discountpercentage / 100).toFixed(2) %>
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% if(parseFloat(sale.balance)) { %>
                                                    <tr>
                                                        <td class="fw-bold p-1">Paid</td>
                                                        <td class="text-end code p-1">Rs.<%=
                                                                parseFloat(sale.totalpayment).toFixed(2) %>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                                        <tr class="border-top border-top-dashed fs-15">
                                                            <th scope="row" class="p-1">Total</th>
                                                            <th class="text-end code p-1">Rs.<%= (sale.totalprice -
                                                                    (sale.totalprice * sale.discountpercentage /
                                                                    100)).toFixed(2) %>
                                                            </th>
                                                        </tr>
                                                        <% if(parseFloat(sale.balance)) { %>
                                                            <tr>
                                                                <th class="p-1">
                                                                    <%= parseFloat(sale.balance) < 0 ? 'Balance'
                                                                        : 'Change' %>
                                                                </th>
                                                                <th class="text-end code p-1">Rs.<%=
                                                                        Math.abs(sale.balance).toFixed(2) %>
                                                                </th>
                                                            </tr>
                                                            <% } %>
                                    </tbody>
                                </table>
                                <p class="text-center border-top pt-2">
                                    Powered by <strong>OpenMenu</strong>
                                </p>

                            </div>

                            <div class="hstack gap-2 justify-content-end d-print-none mt-4">
                                <button onclick="window.print()" class="btn btn-success">
                                    <i class="ri-printer-line align-bottom me-1"></i> Print
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        @media print {
            body * {
                visibility: hidden;
                margin: 0 !important;
                padding: 0 !important;
            }

            #demo,
            #demo * {
                visibility: visible;
            }

            #demo {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .d-print-none {
                display: none !important;
            }

            .cstm-row {
                width: 100% !important;
            }

            @page {
                margin: auto;
            }
        }


        * {
            font-family: Arial !important;
        }

        /* Basic styles */
        .card-body {
            font-size: 0.85rem;
        }

        .fs-14 {
            font-size: 0.875rem !important;
        }

        .fs-7 {
            font-size: 0.8rem !important;
        }

        .fs-6 {
            font-size: 0.875rem !important;
        }

        .fs-15 {
            font-size: 0.9rem !important;
        }

        .table {
            font-size: 0.8rem;
        }

        .card-header {
            padding: 0.75rem 1rem;
        }

        .card-body {
            padding: 0.75rem;
        }

        @media (max-width: 576px) {
            .cstm-row {
                width: 100% !important;
            }

            .card-body {
                padding: 0.5rem;
                font-size: 0.8rem;
            }

            .table {
                font-size: 0.75rem;
            }

            h4,
            h5,
            h6 {
                font-size: 0.9rem;
            }
        }

        @media print {
            body * {
                visibility: hidden;
                margin-left: 0 !important;
                padding-left: 0 !important;
            }

            #demo,
            #demo * {
                visibility: visible;
                font-family: Arial, Helvetica, sans-serif !important;
                color: black !important;
            }

            #demo {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                max-width: 100%;
                margin: 0 !important;
                padding: 0 !important;
                margin-left: 0 !important;
            }

            .card {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                margin-left: 0 !important;
            }

            .card-header,
            .card-body {
                width: 100% !important;
                margin-left: 0 !important;
                padding-left: 0 !important;
            }

            .d-print-none {
                display: none !important;
            }

            .cstm-row {
                width: 100% !important;
                padding: 0 !important;
                margin-left: 0 !important;
                margin: 0 !important;
            }

            /* Container adjustments */
            .container,
            .container-fluid,
            .row,
            .col-12,
            .col-lg-12 {
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
                margin-left: 0 !important;
            }

            /* Table adjustments */
            .table-responsive {
                overflow: visible !important;
                width: 100% !important;
                padding-left: 0 !important;
                margin-left: 0 !important;
            }

            .table:not(.footer-table) {
                font-size: 8pt !important;
                width: 100% !important;
                padding: 0 !important;
                margin-left: 0 !important;
                table-layout: fixed !important;
                border-collapse: collapse !important;
            }

            .table:not(.footer-table) th,
            .table:not(.footer-table) td {
                padding: 1pt 1pt !important;
                white-space: normal !important;
                word-break: break-word;
                margin-left: 0 !important;
                font-size: 7pt !important;
                border: 1pt solid #000 !important;
            }

            /* Table header with thicker border */
            .table:not(.footer-table) thead tr {
                border-bottom: 1.5pt solid #000 !important;
            }

            .table:not(.footer-table) th:first-child {
                width: 8% !important;
            }

            .table:not(.footer-table) th:nth-child(2) {
                width: 35% !important;
            }

            .table:not(.footer-table) th:nth-child(3) {
                width: 18% !important;
            }

            .table:not(.footer-table) th:nth-child(4) {
                width: 12% !important;
            }

            .table:not(.footer-table) th:last-child {
                width: 27% !important;
                text-align: right !important;
                padding-right: 2pt !important;
            }

            /* Footer table specific styles */
            .footer-table {
                width: auto !important;
                min-width: 45% !important;
                max-width: 65% !important;
                margin-left: auto !important;
                margin-right: 0 !important;
                font-size: 7pt !important;
                table-layout: auto !important;
            }

            .footer-table td,
            .footer-table th {
                white-space: nowrap !important;
                padding: 1pt 2pt !important;
            }

            .footer-table td:first-child,
            .footer-table th:first-child {
                text-align: left !important;
                padding-right: 8pt !important;
            }

            .footer-table td:last-child,
            .footer-table th:last-child {
                text-align: right !important;
                padding-left: 3pt !important;
            }

            /* Font size adjustments */
            .fs-14,
            .fs-7,
            .fs-6,
            .fs-15 {
                font-size: 8pt !important;
            }

            p,
            .mb-0,
            .mb-1,
            .mb-2 {
                font-size: 8pt;
                margin-bottom: 1pt !important;
            }

            h4 {
                font-size: 10pt;
                margin: 2pt 0 !important;
            }

            h5,
            h6 {
                font-size: 9pt;
                margin: 1pt 0 !important;
            }

            /* Image sizing and centering */
            .card-logo {
                height: 30pt !important;
                margin-bottom: 2pt !important;
                display: block !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }

            /* Page margins - small padding to prevent overflow */
            @page {
                margin: 5mm !important;
                padding: 0 !important;
            }

            /* Add small padding to card content in print */
            .card-body {
                padding: 2pt 4pt !important;
            }

            .card-header {
                padding: 2pt 4pt !important;
            }

            /* Make borders black and thicker for print */
            .border-top,
            .border-bottom-dashed,
            .border-top-dashed {
                border-color: #000 !important;
                border-width: 1.5pt !important;
                border-style: solid !important;
            }

            .px-3,
            .px-4,
            .py-4,
            .pt-4,
            .pb-0,
            .p-1 {
                padding: 0 !important;
            }

            .mt-1,
            .mt-2,
            .mt-3,
            .mt-4,
            .mb-3,
            .my-2 {
                margin: 1pt 0 !important;
            }
        }

        .code {
            /* font-family: monospace !important; */
            color: black !important;
        }
    </style>
</body>
<script src="/assets/js/moment.min.js"></script>
<script>
    $(document).ready(function () {
        setTimeout(() => {
            $('.format-date').each(function () {
                var date = $(this).text().trim();
                // Format: 16-1-2026 20:37
                $(this).text(moment(new Date(date)).format('DD-M-YYYY HH:mm'));
            });
        });
    });
</script>

</html>