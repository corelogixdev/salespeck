<div class="card" style="max-width: 400px; margin: 0 auto; font-family: 'Arial', sans-serif;">
    <div class="card-body" style="border: 1px dashed #000; padding: 20px;">
        <div class="container">
            <div class="text-center mb-4">
                <img src="/assets/images/icon.png" alt="" height="60" width="60">
                <h4 class="mt-2" style="margin: 0;"><%= companySettings.name %></h4>
                <div style="border-bottom: 1px dashed #000; margin: 10px 0;"></div>
            </div>

            <div style="font-size: 14px;">
                <p class="mb-1">Receipt #: <%= sale.invoicenum %></p>
                <p class="mb-1">Date: <%= sale.createdAt %></p>
                
                <% if(sale.Customer){ %>
                    <div style="margin: 15px 0; padding: 10px 0; border-top: 1px dashed #000; border-bottom: 1px dashed #000;">
                        <p class="mb-1">Customer: <%= sale.Customer?.name %></p>
                        <p class="mb-1"><%= sale.Customer?.address %></p>
                        <p class="mb-1">Tel: <%= sale.Customer?.phone %></p>
                    </div>
                <% } %>

                <div style="margin: 15px 0;">
                    <p class="mb-2" style="border-bottom: 1px dashed #000;">Items</p>
                    <% sale.SoldPoducts.forEach((product, index)=> { %>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <div>
                                <p class="mb-0"><%= product.Product.name %></p>
                            </div>
                            <div>
                                <small class="text-muted"><%= product.quantity %> x Rs.<%= product.price %></small>
                            </div>
                            <div style="font-family: monospace;">
                                Rs.<%= (product.quantity * product.price).toFixed(2) %>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div style="border-top: 1px dashed #000; padding-top: 10px;">
                    <div style="display: flex; justify-content: space-between; font-size: 14px; flex-direction: column;">
                        <div style="display: flex; justify-content: space-between;">
                            <span>Total Price:</span>
                            <span style="font-family: monospace;">Rs. <%= sale.totalprice %></span>
                        </div>
                        <% if(sale.discountpercentage){ %>
                            <div style="display: flex; justify-content: space-between;">
                                <span>
                                    Discount (<%= sale.discountpercentage %>%):
                                </span>
                                <span style="font-family: monospace;">
                                    Rs. -<%= (sale.totalprice * sale.discountpercentage / 100).toFixed(2) %>
                                </span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div style="border-top: 1px dashed #000; margin-top: 10px;">
                    <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: bold; flex-direction: column;">
                        <div style="display: flex; justify-content: space-between;">
                            <span>Total:</span>
                            <span style="font-family: monospace;">Rs. 
                                <%= (sale.totalprice - (sale.totalprice * sale.discountpercentage / 100)).toFixed(2) %>
                            </span>
                        </div>
                        <% if(parseFloat(sale.balance)){ %>
                            <div style="display: flex; justify-content: space-between;">
                                <span>Paid:</span>
                                <span style="font-family: monospace;">Rs. <%= parseFloat(sale.totalpayment).toFixed(2) %></span>
                            </div>
                            <% } %>
                            <% if(parseFloat(sale.change)){ %>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Change:</span>
                                    <span style="font-family: monospace;">Rs. <%= sale.change %></span>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <div style="border-top: 1px dashed #000; margin-top: 10px;">
                            <div style="display: flex; justify-content: space-between; font-size: 16px; font-weight: bold; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Balance:</span>
                                    <span style="font-family: monospace;">Rs. <%= (sale.balance) %></span>
                                </div>
                            </div>
                        </div>

                <div class="text-center mt-4" style="font-size: 12px;">
                    <p class="mb-1">Thank you for your business!</p>
                    <p class="mb-0">Please come again</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- print button with icon -->
<div class="text-center mt-4">
    <button class="btn btn-primary" onclick="window.print({
        title: '<%= companySettings.name %> - Sale Receipt'
    })">
        <i class="fas fa-print"></i> Print
    </button>
</div>

<style>
    @media print {
        body * {
            visibility: hidden;
        }

        .card, .card * {
            visibility: visible;
        }
    }
</style>