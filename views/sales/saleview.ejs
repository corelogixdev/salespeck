<div class="card">
    <div class="card-body">
        <div class="container mb-5 mt-3">
            <div class="row d-flex align-items-baseline">
                <div class="col-xl-9">
                    <p style="color: #7e8d9f;font-size: 20px;">Invoice &gt;&gt; <strong>
                            <%= sale.invoicenum %>
                        </strong></p>
                </div>
            </div>
            <div class="container">
                <div class="col-md-12">
                    <div class="text-center">
                        <img src="/assets/images/icon.png" alt="" height="100" width="100">
                        <p class="pt-2">
                            <%= companySettings.name %>
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-8">
                        <ul class="list-unstyled">
                            <li class="text-muted">To: <span style="color:#8f8061 ;">
                                &nbsp;<%= sale.Customer?.name %>
                            </span></li>
                            <li class="text-muted"><i class="fas fa-map-marker-alt"></i> &nbsp; <%= sale.Customer?.address %></li>
                            <li class="text-muted"><i class="fas fa-phone"></i>&nbsp; <%= sale.Customer?.phone %></li>
                        </ul>
                    </div>
                    <div class="col-xl-4">
                        <ul class="list-unstyled">
                            <li class="text-muted"><i class="fas fa-circle" style="color:#8f8061 ;"></i> <span
                                    class="fw-bold">ID:</span><%= sale.invoicenum %></li>
                            <li class="text-muted"><i class="fas fa-circle" style="color:#8f8061 ;"></i> <span
                                    class="fw-bold">Creation Date: </span>
                                <%= sale.createdAt %>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row my-2">
                    <% sale.SoldPoducts.forEach((product, index)=> { %>
                        <div class="col-md-2 mb-4 mb-md-0">
                            <div class="bg-image mb-4 rounded-2 overflow-hidden d-block">
                                <img style="object-fit: cover;" src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTF8fHByb2R1Y3R8ZW58MHx8MHx8fDA%3D" class="w-100" height="100px" />
                                <a href="#!">
                                    <div class="hover-overlay">
                                        <div class="mask" style="background-color: hsla(0, 0%, 98.4%, 0.2)"></div>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <p class="fw-bold mb-1">
                                <%= product.Product.name %>
                            </p>
                            <p class="text-muted mb-1"><small>Price: Rs.<%= product.price %></small></p>
                            <p class="text-muted mb-1"><small>Quantity: <%= product.quantity %></small></p>
                        </div>
                        <% }) %>
                </div>
                <hr>
                <div class="row">
                    <div class="col-xl-8">
                        <p class="ms-3">Add additional notes and payment information</p>
                    </div>
                    <div class="col-xl-3">
                        <p class="text-black float-start"><span class="text-black me-3"> Total Amount</span><span
                                style="font-size: 25px;">Rs.<%= sale.total %></span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>