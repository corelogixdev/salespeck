<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Switch Server</h4>
            </div>
            <div class="card-body">
                <form id="switchForm">
                    <div class="mb-3">
                        <label for="serverIp" class="form-label">Server IP Address</label>
                        <input type="text" 
                               class="form-control" 
                               id="serverIp" 
                               name="serverIp" 
                               placeholder="Enter IP address (e.g. 192.168.1.100:3000)"
                               required>
                        <div class="form-text">Enter the IP address and port of the server you want to connect to.</div>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ri-server-line align-middle me-1"></i> Switch Server
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('switchForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    let serverIp = document.getElementById('serverIp').value;
    
    // Show loading state
    const btn = this.querySelector('button');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="ri-loader-4-line align-middle me-1 animate-spin"></i> Verifying...';

    try {
        // First verify the server is running
        const verifyResponse = await fetch(`http://${serverIp}:3000/api/verify-server`);
        if (!verifyResponse.ok) {
            throw new Error('Server not found or not responding');
        }
        
        const result = await verifyResponse.json();
        if (result.status === 'success') {
            // If verification successful, trigger the switch
            // remove the trailing slash
            serverIp = serverIp.replace(/\/$/, '');
            window.electron.send('switch-server', serverIp + ':3000');
        } else {
            throw new Error(result.message || 'Invalid server response');
        }
    } catch (error) {
        console.log({ error });
        toastr.error(error.message || 'Failed to connect to server');
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
});
</script>
