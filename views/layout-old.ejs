  <script>
    toastr.options = {
      "closeButton": true,
      "progressBar": true,
      "positionClass": "toast-bottom-right",
      "showDuration": "300",
      "hideDuration": "1000",
      "timeOut": "5000",
      "extendedTimeOut": "1000",
      "showEasing": "swing",
      "hideEasing": "linear",
      "showMethod": "fadeIn",
      "hideMethod": "fadeOut",
      "toastClass": "toast",
    };
  </script>
  <script>
    var message = '<%- JSON.stringify(message || null ) %>';
    message = JSON.parse(message.replace(/^'(.*)'$/, '$1'));
    if (message) {
      toastr[message['type']](message['text']);
    }
  </script>
    <% if (typeof hidenav === 'undefined' || hidenav !== true) { %>
    <script>
            document.addEventListener('DOMContentLoaded', () => {
            async function FetchData(query) {
              try {
                const response = await fetch('/products/search', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({ query }),
                });
                const data = await response.json();
                return data;
              } catch (error) {
                console.error('Error:', error);
              }
            }
            const searchInput = document.getElementById('navbar-search-input');
            let typingTimer;
            const typingInterval = 500; // 500ms
            searchInput.addEventListener('input', () => {
              clearTimeout(typingTimer);
              typingTimer = setTimeout(async () => {
                const query = searchInput.value;
                try {
                  let response = await FetchData(query);
                  let result = document.getElementById('result');
                  result.innerHTML = '';
                  result.style.display = 'block';
                  if (response.data.length > 0) {
                    response.data.forEach((item) => {
                      let a = document.createElement('a');
                      a.classList.add('dropdown-item', 'd-flex', 'justify-content-between', 'p-2', 'align-items-center', 'search-result');
                      let span = document.createElement('span');
                      span.innerText = item.name.substring(0, 20);
                      a.appendChild(span);
                      let span2 = document.createElement('span');
                      span2.innerText = 'Rs.' + item.saleprice ?? 0;
                      a.appendChild(span2);
                      result.appendChild(a);
                    });
                  } else {
                    let p = document.createElement('p');
                    p.style.textWrap = 'auto';
                    p.classList.add('dropdown-item', 'p-2', 'align-items-center', 'search-result');
                    if (query) {
                      p.innerText = 'No data found for "' + query.substring(0, 20) + '"';
                    } else {
                      p.innerText = 'Type to search';
                    }
                    result.appendChild(p);
                  }
                } catch (error) {
                  console.error('Error:', error);
                }
              }, typingInterval);
            });
            searchInput.addEventListener('focus', () => {
              if (searchInput.value) {
                document.getElementById('result').style.display = 'block';
              }
            });
            document.addEventListener('click', (event) => {
              if (!event.target.closest('.result')) {
                document.getElementById('result').style.display = 'none';
              }
            });
          });

            document.getElementById('close-btn').addEventListener('click', () => {
              const dataToSend = { message: 'close-app' };
              if (window.api) {
                window.api.performAction(dataToSend); // Send data to main process
              }
            });
            
            document.getElementById('logout-btn').addEventListener('click', () => {
              window.location.href = '/logout';
            });

      if (window.api) {
        window.api.onActionResponse((response) => {
          console.log(response);
          //document.getElementById('response').innerText = response;
        });
      }
    </script>
  <% } %>
